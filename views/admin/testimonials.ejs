<head>
 <style>

/* =========================
   FILTER SUMMARY CARDS
========================= */

.review-filters{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin-bottom:18px;
}

.filter-card{
background:#0f1b34;
border:1px solid rgba(0,255,200,0.15);
padding:12px;
border-radius:10px;
text-align:center;
color:white;
text-decoration:none;
font-size:13px;
transition:0.2s;
}

.filter-card.active{
border:2px solid #22c55e;
}


/* =========================
   REVIEW GRID
========================= */

.reviews-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:14px;
}


/* =========================
   REVIEW CARD
========================= */

.review-card{
background:#0f1b34;
border-radius:12px;
overflow:hidden;
border:1px solid rgba(0,255,200,0.15);
display:flex;
flex-direction:column;
}


/* =========================
   IMAGE
========================= */

.review-image{
position:relative;
height:150px;
}

.review-image img{
width:100%;
height:100%;
object-fit:cover;
}


/* =========================
   STATUS BADGE
========================= */

.status-badge{
position:absolute;
top:6px;
right:6px;
font-size:8px;
padding:3px 7px;
border-radius:6px;
background:#16a34a;
text-transform:uppercase;
font-weight:600;
opacity: 75%;
}

.status-badge.pending{
background:#f59e0b;
}


/* =========================
   CARD BODY
========================= */

.review-body{
padding:8px;
}

.review-body h4{
font-size:10px;
margin:3px 0;
font-weight:600;
}

.stars{
font-size:9px;
color:#facc15;
margin-bottom:4px;
}

.review-text{
font-size:8px;
line-height:1.3;
color:#cbd5e1;
max-height:34px;
overflow:hidden;
}


/* =========================
   ACTION BUTTONS
========================= */

/* =========================
   ICON ACTION BUTTONS
========================= */

/* =========================
   ICON ACTION BUTTONS
========================= */

.review-actions{
  bottom: 0;
display:flex;
justify-content:space-between;
gap:8px;
padding:20px;
padding-bottom: 0;
margin-bottom: -10px;
}

.icon-btn{
  position:relative;
width:30px;
height:30px;
display:flex;
align-items:center;
justify-content:center;
border-radius:6px;
border:none;
cursor:pointer;
transition:0.2s;
}

.icon-btn svg{
width:16px;
height:16px;
}

/* UPDATE IMAGE */

.update-icon{
background:#2563eb;
color:white;
}

.update-icon:hover{
background:#1d4ed8;
}

/* DELETE */

.delete-icon{
background:#dc2626;
color:white;
}

.delete-icon:hover{
background:#b91c1c;
}
/* APPROVE BUTTON */

.approve-icon{
background:#16a34a;
color:white;
}

.approve-icon:hover{
background:#15803d;
}
/* TOOLTIP */
.icon-btn::after{
content:attr(data-tooltip);
position:absolute;
bottom:120%;
left:50%;
transform:translateX(-50%);
background:#111827;
color:white;
font-size:10px;
padding:4px 6px;
border-radius:4px;
white-space:nowrap;
opacity:0;
pointer-events:none;
transition:0.2s;
}

.icon-btn:hover::after{
opacity:1;
}

/* =========================
   DESKTOP GRID
========================= */

@media(min-width:900px){

.reviews-grid{
grid-template-columns:repeat(4,1fr);
}
.review-body h4{
font-size:14px;
margin:3px 0;
font-weight:600;
}

.stars{
font-size:10px;
color:#facc15;
margin-bottom:4px;
}

.review-text{
font-size:8px;
line-height:1.3;
color:#cbd5e1;
max-height:34px;
overflow:hidden;
}

}
.review-analytics{
margin-top:10px;
display:flex;
gap:10px;
}

.analytics-card{
background:#0f1b34;
border:1px solid rgba(0,255,200,0.15);
padding:6px 12px;
border-radius:8px;
display:flex;
align-items:center;
gap:6px;
font-size:12px;
}

.analytics-card h3{
margin:0;
font-size:14px;
}
</style>
</head>

<%- include("../admin/partials/header") %>

<section class="section-header">

<h2>Customer Testimonials</h2>
<span class="subtext">Manage customer reviews</span>

<div class="review-analytics">

<div class="analytics-card">
<span>⭐</span>
<h3><%= avgRating %></h3>
<p>Average Rating</p>
</div>

</div>

</section>


<!-- FILTER SUMMARY -->

<div class="review-filters">

<a href="/admin/testimonials"
class="filter-card <%= filter==='all'?'active':'' %>">

<h3><%= total %></h3>
<p>All</p>

</a>

<a href="/admin/testimonials?status=pending"
class="filter-card pending <%= filter==='pending'?'active':'' %>">

<h3><%= pending %></h3>
<p>Pending</p>

</a>

<a href="/admin/testimonials?status=approved"
class="filter-card approved <%= filter==='approved'?'active':'' %>">

<h3><%= approved %></h3>
<p>Approved</p>

</a>

</div>



<!-- REVIEW CARDS -->

<div class="reviews-grid">

<% testimonials.forEach(t => { %>

<div class="review-card">

  <div class="review-image">

    <img src="<%= t.image || '/images/default-user.png' %>">

    <span class="status-badge <%= t.status %>">
      <%= t.status %>
    </span>

  </div>


  <div class="review-body">

    <h4><%= t.name %></h4>

    <div class="stars">
      <%= "⭐".repeat(t.rating || 0) %>
    </div>

    <p class="review-text">
      <%= t.review || "No review message provided." %>
    </p>

  </div>


  <div class="review-actions">

  <!-- APPROVE (only for pending reviews) -->

  <% if(t.status === "pending"){ %>

  <form method="POST"
        action="/admin/testimonials/approve/<%= t.id %>">

    <button class="icon-btn approve-icon" data-tooltip="Approve review">

      <!-- CHECK SVG -->

      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2"
           stroke-linecap="round"
           stroke-linejoin="round">

        <polyline points="20 6 9 17 4 12"/>

      </svg>

    </button>

  </form>

  <% } %>


  <!-- UPDATE IMAGE -->

  <form action="/admin/testimonials/image/<%= t.id %>"
        method="POST"
        enctype="multipart/form-data">

    <input type="file"
           name="image"
           id="img<%= t.id %>"
           hidden onchange="this.form.submit()">

    <label for="img<%= t.id %>" class="icon-btn update-icon" data-tooltip="Update image">

      <!-- CAMERA SVG -->

      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2"
           stroke-linecap="round"
           stroke-linejoin="round">

        <path d="M23 19V7a2 2 0 0 0-2-2h-3l-2-3H8L6 5H3a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2z"/>
        <circle cx="12" cy="13" r="4"/>

      </svg>

    </label>

  </form>


  <!-- DELETE -->

  <form method="POST"
        action="/admin/testimonials/delete/<%= t.id %>"
        onsubmit="return confirmDelete()">

    <button class="icon-btn delete-icon" data-tooltip="Delete review">

      <!-- TRASH SVG -->

      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2"
           stroke-linecap="round"
           stroke-linejoin="round">

        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14H6L5 6"/>
        <path d="M10 11v6"/>
        <path d="M14 11v6"/>
        <path d="M9 6V4h6v2"/>

      </svg>

    </button>

  </form>

</div>

</div>

<% }) %>

</div>



<script>

function confirmDelete(){
return confirm("Delete this testimonial permanently?");
}

</script>

<%- include("../admin/partials/footer") %>