        <div class="img-sub" style="background-image: url('<%= tour.galleryImage2 || 'https://images.unsplash.com/photo-1590050752118-2e8ce8e658e3?auto=format&fit=crop&q=80' %>');"></div>
        <div class="img-sub" style="background-image: url('<%= tour.galleryImage3 || 'https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&q=80' %>');"></div>
        <div class="img-sub" style="background-image: url('<%= tour.galleryImage4 || 'https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&q=80' %>');"></div>
        <div class="img-sub" style="background-image: url('<%= tour.galleryImage5 || 'https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&q=80' %>');"></div>
      </div>

    </div>

    <div style="border-top: 1px solid var(--border-light); padding-top: 32px; margin-top: 16px;">
