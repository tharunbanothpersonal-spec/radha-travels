<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Driver Assigned – Radha Travels</title>
<style>
  body{margin:0;padding:0;background:#f4fbf7;font-family:Arial,Helvetica,sans-serif}
  .card{max-width:620px;margin:24px auto;background:#fff;border-radius:16px;
        box-shadow:0 20px 50px rgba(11,122,70,.12);overflow:hidden}
  .header{padding:22px;background:linear-gradient(90deg,#00c48c,#0a7a46,#f5b630);color:#fff}
  .brand{font-size:26px;font-weight:900}
  .section{padding:24px;color:#07361f}
  .row{margin-bottom:16px}
  .label{font-size:12px;color:#6b8f7f}
  .value{font-size:16px;font-weight:800}
  .highlight{background:#fff8e1;border-left:4px solid #f5b630;padding:14px;border-radius:8px}
  .cta{display:inline-block;margin:12px 10px 0 0;padding:14px 20px;border-radius:999px;
       background:#0b7a46;color:#fff;font-weight:900;text-decoration:none}
  .footer{padding:22px;background:linear-gradient(90deg,#0a7a46,#00c48c,#0a7a46);color:#fff}
</style>
</head>

<body>
<div class="card">

  <!-- Header -->
  <div class="header">
    <div class="brand">🚘 Driver Assigned</div>
    <div>Radha Travels</div>
  </div>

  <div class="section">
    <p>Dear <strong><%= booking.fullName %></strong>,</p>

    <p>Your driver has been assigned. Please find the details below.</p>

    <div class="row">
      <div class="label">Driver Name</div>
      <div class="value"><%= driver.name %></div>
    </div>

    <div class="row">
      <div class="label">Driver Phone</div>
      <div class="value">
        <a href="tel:<%= driver.phone %>" style="color:#0b7a46;text-decoration:none">
          <%= driver.phone %>
        </a>
      </div>
    </div>

    <div class="row">
      <div class="label">Vehicle</div>
      <div class="value"><%= vehicle.type %> • <%= vehicle.number %></div>
    </div>

    <div class="highlight">
      📞 Driver will contact you about <strong>30 minutes before pickup</strong>.
    </div>

    <a href="https://wa.me/91<%= driver.phone.replace(/\D/g,'') %>" class="cta">WhatsApp Driver</a>
    <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(booking.pickup) %>"
       class="cta">View Pickup</a>
  </div>

  <div class="footer">
    Thank you for choosing <strong>Radha Travels</strong><br/>
    Safe journey 🚗
  </div>

</div>
</body>
</html>
