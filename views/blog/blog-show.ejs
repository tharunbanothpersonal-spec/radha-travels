<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <%- include('../partials/head', { 
    title: post.title,
    metaDescription: post.excerpt
  }) %>

  <style>
    :root{
  --primary:#10b981;
  --primary-dark:#064e3b;
  --bg:#f8fafc;
  --text:#111827;
  --muted:#6b7280;
}

body{
  margin:0;
  margin-top: -50px;
  font-family:'Poppins',sans-serif;
  background:var(--bg);
  color:var(--text);
}

/* ================= HERO ================= */

.blog-hero{
  background:linear-gradient(135deg,var(--primary-dark),var(--primary));
  padding:90px 20px 70px;
  color:white;
  text-align:center;
}

.blog-hero h1{
  margin:0 auto 14px;
  font-size:26px;
  max-width:900px;
  line-height:1.35;
  font-weight:600;
}

.blog-meta{
  font-size:14px;
  opacity:.9;
}

@media(min-width:768px){
  .blog-hero h1{ font-size:38px; }
}

/* ================= CONTENT WRAPPER ================= */

.blog-wrapper{
  max-width:850px;
  margin:-50px auto 90px;
  padding:0 20px;
}

.blog-container{
  background:white;
  padding:40px;
  border-radius:28px;
  box-shadow:0 30px 80px rgba(0,0,0,0.06);
}

@media(max-width:440px){
  body{
  margin-top: -80px;
}
  .blog-container{
    padding:22px;
    border-radius:20px;
  }

}

/* ================= TYPOGRAPHY ================= */

.blog-container h2{
  font-size:21px;
  margin-top:40px;
  margin-bottom:12px;
  font-weight:600;
}

.blog-container h3{
  font-size:17px;
  margin-top:28px;
  margin-bottom:8px;
}

.blog-container p{
  font-size:15px;
  line-height:1.9;
  color:#374151;
  margin-bottom:18px;
}

.blog-container ul{
  padding-left:20px;
  margin-bottom:22px;
}

.blog-container li{
  margin-bottom:10px;
  font-size:14px;
  line-height:1.7;
}

/* ================= INTERNAL LINKS SECTION ================= */

.internal-links{
  margin-top:45px;
  padding:22px;
  background:#f0fdf4;
  border-radius:18px;
  border:1px solid #bbf7d0;
}

.internal-links h2{
  font-size:18px;
  margin-top:0;
}

/* ================= INTERNAL LINKS ================= */

.blog-container a{
  color:var(--primary);
  font-weight:600;
  text-decoration:none;
}

.blog-container a:hover{
  text-decoration:underline;
}

/* ================= FEATURED IMAGE ================= */

.featured-image{
  margin-bottom:30px;
  border-radius:22px;
  overflow:hidden;
}

.featured-image img{
  width:100%;
  height:380px;
  object-fit:cover;
}

@media(max-width:440px){
  .featured-image img{
    height:200px;
  }
}

/* ================= RELATED POSTS ================= */

.related-section{
  margin-top:65px;
}

.related-section h2{
  font-size:20px;
  margin-bottom:22px;
}

.related-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:18px;
}

@media(min-width:768px){
  .related-grid{
    grid-template-columns:repeat(3,1fr);
  }
}

.related-card{
  background:white;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 15px 35px rgba(0,0,0,0.05);
  transition:.3s ease;
}

.related-card:hover{
  transform:translateY(-6px);
  box-shadow:0 20px 60px rgba(16,185,129,0.15);
}

.related-card img{
  width:100%;
  height:160px;
  object-fit:cover;
}

.related-card-content{
  padding:16px;
}

.related-card h3{
  font-size:14px;
  margin:0 0 6px;
}

.related-card p{
  font-size:12px;
  color:var(--muted);
  margin:0;
}

/* ================= FLOATING CTA ================= */

.floating-cta{
  position:fixed;
  bottom:25px;
  left:25px;
  background:linear-gradient(135deg,#b91c1c,#7f1d1d);
  color:white;
  padding:14px 24px;
  border-radius:50px;
  font-size:14px;
  font-weight:600;
  text-decoration:none;
  box-shadow:0 12px 35px rgba(185,28,28,.4);
  transition:.3s ease;
  z-index:999;
}

.floating-cta:hover{
  transform:translateY(-4px);
  box-shadow:0 18px 45px rgba(185,28,28,.6);
}

@media(max-width:440px){
  .floating-cta{
    bottom:45px;
    left:18px;
    font-size:13px;
    padding:12px 18px;
  }
}
  </style>
</head>

<body>

<%- include('../partials/header') %>
<%- include('../partials/ticker') %>

<!-- HERO -->
<section class="blog-hero">
  <h1><%= post.title %></h1>
  <div class="blog-meta">
    Published on <%= post.date %>
  </div>
</section>

<!-- CONTENT -->
<div class="blog-wrapper">
  <div class="blog-container">

    <% if(post.image){ %>
      <div class="featured-image">
        <img src="<%= post.image %>" alt="<%= post.title %>">
      </div>
    <% } %>

    <%- post.content %>
<div class="internal-links">
  <h2>Book Reliable Cab Services in Hyderabad</h2>
  <p>
    Looking for trusted travel services? Explore our
    <a href="/services/outstation">Outstation Cab Service</a>,
    <a href="/services/airport-transfer">Airport Taxi Service</a>,
    and <a href="/fleet">Tempo Traveller & SUV Rentals</a>.
  </p>
</div>
    <% if (relatedPosts && relatedPosts.length) { %>
      <div class="related-section">
        <h2>Related Travel Guides</h2>

        <div class="related-grid">
          <% relatedPosts.forEach(item => { %>
            <div class="related-card">
              <a href="/blog/<%= item.slug %>">
                <img src="<%= item.image %>" alt="<%= item.title %>">
                <div class="related-card-content">
                  <h3><%= item.title %></h3>
                  <p><%= item.excerpt %></p>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</div>
<!-- Sticky Bottom CTA (Mobile Only) -->
  <a href="#" role="button" class="floating-cta open-booking"><i class="ri-24-hours-line"></i> Book this Trip</a>


<%- include('../partials/footer') %>

<!-- BlogPosting Schema -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": post.image ? ["https://radhatravels.co.in" + post.image] : undefined,
  "author": {
    "@type": "Organization",
    "name": "Radha Travels"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Radha Travels",
    "logo": {
      "@type": "ImageObject",
      "url": "https://radhatravels.co.in/images/logo.jpg"
    }
  },
  "datePublished": post.date,
  "dateModified": post.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://radhatravels.co.in/blog/" + post.slug
  },
  "articleSection": "Travel Guide",
  "inLanguage": "en-IN"
}, null, 2) %>
</script>

<% if (faqs && faqs.length) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
}, null, 2) %>
</script>
<% } %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://radhatravels.co.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://radhatravels.co.in/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": "https://radhatravels.co.in/blog/" + post.slug
    }
  ]
}, null, 2) %>
</script>
</body>
</html>