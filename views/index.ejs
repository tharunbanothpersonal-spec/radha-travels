<!DOCTYPE html>
<html lang="en">
<head>

  <%- include('./partials/head', { title }) %>
  <title><%= title %></title>
  
  
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/booking.css"/>
  <link rel="stylesheet" href="/css/gallery-upload.css">
  
  <style>
    /* ==========================================================================
       HARDWARE-ACCELERATED SCROLL REVEAL SYSTEM
       ========================================================================== */

    /* --- 1. BASE REVEAL STATE --- */
    .reveal-item {
      opacity: 0;
      /* Alerts the browser GPU to prepare for these specific changes */
      will-change: opacity, transform, clip-path;
      /* Snappy, optimized base transition targeting specific properties */
      transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), 
                  transform 1s cubic-bezier(0.16, 1, 0.3, 1); 
    }

    /* --- 2. STANDARD ANIMATIONS (For Packages & Fleet) --- */
    .reveal-drop { transform: translateY(-50px); }
    .reveal-slide-up { transform: translateY(60px); }
    .reveal-slide-left { transform: translateX(-50px); }

    /* --- 3. THE LUXURY UNVEIL (For the Gallery Section) --- */
    .reveal-luxury-mask {
      /* Masks the container starting from the bottom */
      clip-path: inset(100% 0 0 0); 
      transform: translateY(20px);
      transition: clip-path 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.6s ease-out;
    }

    /* Target the image inside the mask for the cinematic scale-down effect */
    .reveal-luxury-mask img {
      transform: scale(1.6);
      transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1); 
    }

    /* --- 4. ACTIVE STATES (Triggered by IntersectionObserver JS) --- */
    .reveal-item.is-visible {
      opacity: 1;
      transform: translate(0);
    }

    /* Active state for Luxury Unveil */
    .reveal-item.is-visible.reveal-luxury-mask {
      clip-path: inset(0 0 0 0);
    }

    .reveal-item.is-visible.reveal-luxury-mask img {
      transform: scale(1); /* Image snaps into its frame perfectly */
    }
/* ==========================================================================
   Elevated Trust Widget - Ultra Compact Mobile, Spacious Desktop
   ========================================================================== */

.trust-widget-section {
  background-color: #f4fdf8; 
  padding: 1.5rem 1rem; /* Tighter section padding on mobile */
  font-family: system-ui, -apple-system, sans-serif;
  color: #1f2937;
}

.tw-container {
  max-width: 760px; 
  margin: 0 auto;
}

/* --- Header --- */
/* --- Elevated Header Styling --- */
.tw-header {
  text-align: center;
  margin-bottom: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center; /* Centers the badge and text */
}

/* The Live Pill Badge */
.tw-live-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background-color: #dcfce7;
  color: #059669; /* Deep Green */
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.35rem 0.85rem;
  border-radius: 9999px;
  margin-bottom: 0.75rem;
  box-shadow: 0 2px 4px -1px rgba(5, 150, 105, 0.1);
}

/* Blinking dot inside the badge */
.tw-badge-dot {
  width: 6px;
  height: 6px;
  background-color: #059669;
  border-radius: 50%;
  animation: badge-blink 1.5s infinite ease-in-out;
}

@keyframes badge-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* The Title */
.tw-title {
  font-size: 1.5rem; /* Base mobile size */
  font-weight: 800;
  color: #111827;
  letter-spacing: -0.02em;
  margin: 0 0 0.35rem 0;
  line-height: 1.2;
}

/* The "India" Highlight */
.tw-highlight {
  color: #059669; /* Brand Green */
  position: relative;
  display: inline-block;
  white-space: nowrap;
}

/* The Marker Underline Effect */
.tw-highlight::after {
  content: '';
  position: absolute;
  bottom: 2px; /* Position it behind the bottom half of the text */
  left: -2px;
  right: -2px;
  height: 8px; 
  background-color: #a7f3d0; /* Soft mint highlight */
  z-index: -1;
  border-radius: 4px;
  transform: rotate(-1.5deg); /* Slight tilt for a handwritten feel */
}

/* Desktop Scaling */
@media (min-width: 600px) {
  .tw-header {
    margin-bottom: 2.5rem;
  }
  .tw-live-badge {
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }
  .tw-title {
    font-size: 2rem; /* Much larger on desktop */
  }
  .tw-highlight::after {
    height: 12px; /* Thicker underline for bigger text */
    bottom: 4px;
  }
}

/* --- Main Card --- */
.tw-main-card {
  background: #ffffff;
  border-radius: 16px; /* Slightly softer radius on mobile */
  box-shadow: 0 10px 25px -5px rgba(5, 150, 105, 0.08), 0 4px 10px -5px rgba(5, 150, 105, 0.04);
  border: 1px solid #e5e7eb;
  overflow: hidden;
}

/* --- Metrics Grid --- */
.tw-metrics-grid {
  display: flex;
  flex-direction: row; 
  gap: 0.75rem; /* Tighter gap between boxes */
  padding: 1rem; /* Reduced inner card padding */
}

.tw-metric-box {
  background: #f9fafb;
  border: 1px solid #f3f4f6;
  border-radius: 12px;
  padding: 0.85rem 1rem; /* Compact inner box padding */
  display: flex;
  align-items: center;
  gap: 1rem; /* Tighter gap between icon and text */
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.tw-metric-box:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  background: #ffffff;
  border-color: #d1fae5;
}

/* --- Icons --- */
.tw-icon-wrapper {
  position: relative;
  width: 30px; /* Smaller icon wrapper */
  height: 30px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.live-bg { background-color: #dcfce7; }
.total-bg { background-color: #d1fae5; }

.tw-icon.green-icon {
  width: 20px; /* Smaller SVG */
  height: 20px;
  color: #059669; 
  z-index: 2;
}

/* Pulse Animation */
.tw-pulse-ring {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 12px;
  border: 2px solid #34d399;
  animation: tw-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes tw-pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.3); opacity: 0; }
}

/* --- Data Typography --- */
.tw-data {
  display: flex;
  flex-direction: column;
}

.tw-value {
  font-size: 1.35rem; /* Scaled down number */
  font-weight: 800;
  color: #111827;
  line-height: 1.1;
  margin-bottom: 0.15rem;
}

.tw-label {
  font-size: 0.5rem; /* Smaller label */
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* --- Locations Footer --- */
.tw-locations {
  background-color: #f8fafc;
  padding: 1rem; /* Tighter padding */
  border-top: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.tw-locations-title {
  font-size: 0.8rem;
  font-weight: 600;
  color: #4b5563;
}

.tw-state-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.35rem; /* Tighter pill spacing */
}

.tw-state-list li {
  background: #ffffff;
  color: #059669; 
  font-size: 0.75rem; /* Smaller text inside pills */
  font-weight: 600;
  padding: 0.25rem 0.6rem; /* Slimmer pills */
  border-radius: 6px; 
  border: 1px solid #d1fae5;
  box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

/* --- Desktop Scaling (Expanding back to spacious design) --- */
@media (min-width: 600px) {
  .trust-widget-section {
    padding: 3rem 1rem;
  }
  
  .tw-header {
    margin-bottom: 2rem;
  }
  
  .tw-title {
    font-size: 1.75rem;
  }
  
  .tw-subtitle {
    font-size: 1rem;
  }

  .tw-main-card {
    border-radius: 20px;
  }

  .tw-metrics-grid {
    flex-direction: row; 
    gap: 1rem;
    padding: 1.5rem;
  }
  
  .tw-metric-box {
    flex: 1; 
    justify-content: center;
    padding: 1.25rem;
  }
  
  .tw-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 14px;
  }
  
  .tw-icon.green-icon {
    width: 24px;
    height: 24px;
  }
  
  .tw-pulse-ring {
    border-radius: 14px;
  }
  
  .tw-value {
    font-size: 1.75rem;
  }
  
  .tw-label {
    font-size: 0.8rem;
  }

  .tw-locations {
    flex-direction: row; 
    justify-content: flex-start;
    padding: 1.25rem 1.5rem;
    gap: 0.75rem;
  }
  
  .tw-locations-title {
    margin-right: 0.5rem;
    font-size: 0.85rem;
  }
  
  .tw-state-list {
    justify-content: flex-start;
    gap: 0.5rem;
  }
  
  .tw-state-list li {
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
  }
}
</style>
</head>
<body>
  <%- include('partials/header') %>
  <%- include('partials/ticker') %>
<main>
<section class="hero-bleed post-splash" id="heroRoot">
  <div class="hero-bg" id="heroBg" data-hero>
    <% if (heroSlides && heroSlides.length) { %>
      <% heroSlides.forEach(function(slide, idx){ %>
        <figure class="<%= idx === 0 ? 'active' : '' %>">
          <img src="<%= slide.src %>" alt="<%= slide.caption %>">
          <% if (idx === 0) { %>
            <div class="splash-layer">
              <div class="splash-gradient"></div>
              <div class="splash-content hero-text">
                <h2>Radha Travels — Where Journeys Begin</h2>
                <h1>Your Trusted Travel Companion<br/>Radha Travels!</h1>
                <p>Explore the city with reliable cab services or embark on unforgettable outstation journeys with customizable trip packages.</p>
                <div class="splash-ctas">
                  <a class="rail-btn primary open-booking" href="#" role="button"><i class="fa-solid fa-car-side"></i> Book Now</a>
                  <a class="rail-btn outline" href="#" data-open-estimate><i class="fa-solid fa-calculator"></i> Quick Estimate</a>
                  <a class="rail-btn outline" href="/track-booking"><i class="fa-solid fa-magnifying-glass"></i> Track Booking</a>
                </div>
              </div>
            </div>
          <% } %>
          <figcaption><%= slide.caption %></figcaption>
        </figure>
      <% }); %>
    <% } %>
  </div>

  <div class="hero-rail left" id="heroRail">
    <a class="rail-btn primary open-booking" href="#" role="button" data-service="Test Service" data-source="homepage" aria-haspopup="dialog">
      <i class="fa-solid fa-car-side" aria-hidden="true"></i> Book Now
    </a>
    <a class="rail-btn outline" href="#" data-open-estimate><i class="fa-solid fa-calculator"></i> Quick Estimate</a>
    <a href="/track-booking" class="rail-btn outline"><i class="fa-solid fa-magnifying-glass"></i> Track Booking</a>
  </div>
  
  <div class="hero-dots" id="heroDots" data-dots>
    <% if (heroSlides && heroSlides.length) { %>
      <% heroSlides.forEach(function(_, idx){ %>
        <button class="<%= idx === 0 ? 'active' : '' %>" aria-label="Slide <%= idx+1 %>"></button>
      <% }); %>
    <% } %>
  </div>
</section>

<div class="qe-backdrop" data-qe-backdrop hidden>
  <div class="qe-modal" role="dialog" aria-modal="true" aria-labelledby="qe-title">
    <header class="qe-head">
      <h3 id="qe-title">Quick Estimate</h3>
      <button class="qe-x" type="button" data-qe-close aria-label="Close">×</button>
    </header>
    <form class="qe-form" id="qeForm">
      <label class="qe-label">Service</label>
      <div class="qe-field">
        <select id="qeService" required>
          <option>Outstation</option>
          <option>Local</option>
          <option>Airport</option>
        </select>
      </div>
      <label class="qe-label">Car Segment</label>
      <div class="qe-field">
        <select id="qeSegment" required>
          <option>Hatchback</option>
          <option>Sedan</option>
          <option>Premium Sedan</option>
          <option>SUV</option>
          <option>Premium SUV</option>
        </select>
      </div>
      <label class="qe-label" id="qeDistLbl">Estimated Total Distance (km)</label>
      <div class="qe-field">
        <input id="qeDistance" type="number" min="0" inputmode="numeric" placeholder="120">
      </div>
      <label class="qe-label" id="qeDaysLbl" style="display:none">Number of Days</label>
      <div class="qe-field" id="qeDaysWrap" style="display:none">
        <input id="qeDays" type="number" min="1" value="1" inputmode="numeric">
      </div>
      <label class="qe-label" id="qeHoursLbl" style="display:none">Number of Hours</label>
      <div class="qe-field" id="qeHoursWrap" style="display:none">
        <input id="qeHours" type="number" min="1" value="8" inputmode="numeric">
      </div>
      <button type="submit" class="btn primary qe-btn">Calculate</button>
      <p class="qe-result" id="qeResult" hidden></p>
      <p class="qe-note" id="qeNote" hidden></p>
    </form>
  </div>
</div>
</main>
<!-- Home Special tour package -->
