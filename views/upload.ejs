<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload Gallery</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/gallery-upload.css">
</head>
<body>
<%- include('./partials/header') %>
<section class="upload-shell">
  <div class="upload-card">
    <h2>Share Your Travel Moment</h2>
<p class="upload-sub">
  Upload images or videos from your journey with Radha Travels
</p>
<% if (query && query.success) { %>
  <div class="upload-success">
    🎉 Upload successful! Thank you for sharing your moment.
  </div>
<% } %>

    <form action="/gallery/upload" method="POST" enctype="multipart/form-data">
      <label>Upload As</label>
      <select name="uploaded_by" required>
        <option value="admin">Admin</option>
        <option value="customer">Customer</option>
      </select>
      <label>Select File</label>
      <input type="file" name="file" required>
      <label>Title</label>
      <input type="text" name="title" placeholder="Optional title">
      <label>Description</label>
      <textarea name="description" placeholder="Optional description"></textarea>
      <div class="upload-actions">
        <button type="submit" class="btn primary">Upload</button>
        <a href="/gallery" class="btn outline">Back</a>
      </div>
    </form>
  </div>
</section>
<%- include('./partials/footer') %>
</body>
</html>
