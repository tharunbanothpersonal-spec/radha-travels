<div class="vibrant-booking-card reveal-on-scroll">
  <div class="vbc-content">
    <div class="vbc-badge">
      <span class="pulse-dot"></span>
      Popular Route
    </div>
    <h3 class="vbc-title">Traveling to <%= locals.destination || 'this destination' %>?</h3>
    <p class="vbc-desc">Don't exhaust yourself navigating highways. Upgrade your trip with a premium, chauffeur-driven SUV.</p>
  </div>
  
  <div class="vbc-action">
    <a href="#" class="vbc-btn open-booking">
      <span>Book CAB</span>
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>
</div>