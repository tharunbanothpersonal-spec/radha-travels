<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  fetch('/api/visitor-states')
    .then((res) => res.json())
    .then((data) => {
      const labels = ['Telangana', 'Andhra', 'Karnataka'];
      const counts = [12, 8, 5];

      const ctx = document.getElementById('stateChart');

      new Chart(ctx, {
        type: 'bar',

        data: {
          labels: labels,
          datasets: [
            {
              label: 'Visitors',
              data: counts,
              backgroundColor: '#22c55e',
            },
          ],
        },

        options: {
          plugins: {
            legend: { display: false },
          },
          scales: {
            y: { display: false },
          },
        },
      });
    });
</script>
