<%- include("../admin/partials/header") %>

<style>
/* ==========================================
   FLEET PRO - DARK THEME (2-COLUMN MOBILE)
========================================== */

:root {
  --primary: #10b981;
  --primary-glow: rgba(16, 185, 129, 0.25);
  
  --bg-main: #0f172a;
  --surface: #1e293b;
  --input-bg: #0f172a;
  --border: #334155;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;

  --radius-xl: 16px; /* Slightly smaller radius for 2-col */
  --radius-lg: 12px;
  --radius-md: 8px;
  --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

body {
  background: var(--bg-main);
  font-family: 'Inter', system-ui, sans-serif;
  margin: 0;
  color: var(--text-main);
}

.admin-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 12px;
}

/* --- HEADER --- */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  animation: fadeInDown 0.6s ease-out;
}

.header-text h2 { font-size: 22px; font-weight: 800; margin: 0 0 2px 0; letter-spacing: -0.5px;}
.header-text .subtext { font-size: 13px; color: var(--text-muted); }

/* --- BUTTONS --- */
.btn {
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.btn:active { transform: scale(0.97); }

.btn-primary { background: var(--primary); color: #022c22; box-shadow: 0 6px 12px var(--primary-glow); }
.btn-primary:hover { background: #059669; color: #fff; transform: translateY(-2px); }

.btn-info { background: rgba(14, 165, 233, 0.15); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.2); }
.btn-warning { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.2); }
.btn-danger { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); }
.btn-secondary { background: var(--border); color: var(--text-main); }

.page-header .btn-primary { width: auto; padding: 10px 16px; border-radius: 50px; }

/* --- VEHICLE GRID & CARDS (2-COLUMN MOBILE) --- */
.vehicle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* FORCED 2-COLUMN ON MOBILE */
  gap: 12px; /* Tighter gap for small screens */
}

@media (min-width: 768px) { .vehicle-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
@media (min-width: 1024px) { .vehicle-grid { grid-template-columns: repeat(4, 1fr); } }

.v-card {
  background: var(--surface);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border);
  box-shadow: 0 8px 20px -5px rgba(0,0,0,0.3);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  opacity: 0;
  animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  transition: var(--transition);
}
.v-card:hover { transform: translateY(-3px); border-color: #475569; }

/* Animation Delays */
.v-card:nth-child(1) { animation-delay: 0.1s; }
.v-card:nth-child(2) { animation-delay: 0.15s; }
.v-card:nth-child(3) { animation-delay: 0.2s; }
.v-card:nth-child(4) { animation-delay: 0.25s; }

.v-image-wrapper {
  height: 120px; /* Reduced height to fit 2 columns nicely */
  background: #0f172a;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}
@media (min-width: 768px) { .v-image-wrapper { height: 160px; } }

.v-image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition); }
.v-card:hover .v-image-wrapper img { transform: scale(1.05); }

.status-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  backdrop-filter: blur(4px);
  z-index: 2;
}
.status-active { background: rgba(16, 185, 129, 0.9); }
.status-inactive { background: rgba(239, 68, 68, 0.9); }

.v-content { padding: 12px; flex-grow: 1; }
.v-name { font-size: 15px; font-weight: 800; margin: 0 0 4px 0; color: var(--text-main); line-height: 1.2;}
.v-cat { font-size: 11px; color: var(--primary); font-weight: 600; margin-bottom: 12px; display: inline-block; background: rgba(16, 185, 129, 0.15); padding: 2px 8px; border-radius: 4px; }

.v-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.v-stat { background: rgba(15, 23, 42, 0.5); border: 1px solid var(--border); padding: 8px 4px; border-radius: var(--radius-md); text-align: center; }
.v-stat span { display: block; color: var(--text-muted); font-size: 9px; text-transform: uppercase; margin-bottom: 2px; font-weight: 600;}
.v-stat strong { color: var(--text-main); font-size: 12px; }

/* Stack actions vertically on mobile so buttons don't overflow */
.v-actions {
  padding: 12px;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column; 
  gap: 8px;
  background: rgba(15, 23, 42, 0.3);
}
.v-actions form { margin: 0; width: 100%; }

/* Scale back to horizontal buttons on tablet */
@media (min-width: 768px) {
  .v-actions { display: grid; grid-template-columns: 1fr 1fr; padding: 16px; gap: 10px; }
  .v-actions .edit-btn-wrap { grid-column: 1 / -1; }
}

/* --- MODALS --- */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px);
  display: none; align-items: flex-end; justify-content: center; z-index: 999;
  opacity: 0; transition: opacity 0.3s;
}
.modal-overlay.active { display: flex; opacity: 1; }

.modal-content {
  background: var(--surface); width: 100%; max-width: 550px;
  border-radius: 20px 20px 0 0; padding: 20px; max-height: 90vh; overflow-y: auto;
  transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1px solid var(--border);
}
.modal-overlay.active .modal-content { transform: translateY(0); }

@media (min-width: 600px) {
  .modal-overlay { align-items: center; }
  .modal-content { border-radius: var(--radius-xl); transform: scale(0.95); opacity: 0; }
  .modal-overlay.active .modal-content { transform: scale(1); opacity: 1; }
}

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
.modal-header h3 { margin: 0; font-size: 18px; font-weight: 700; }
.close-btn { background: var(--input-bg); border: 1px solid var(--border); font-size: 18px; color: var(--text-muted); cursor: pointer; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }

/* --- FORM INPUTS --- */
.form-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
@media (min-width: 600px) { .form-grid { grid-template-columns: 1fr 1fr; } }

.input-group { display: flex; flex-direction: column; gap: 6px; }
.input-group label { font-size: 12px; font-weight: 600; color: var(--text-muted); padding-left: 4px; }
.input-group.full-width { grid-column: 1 / -1; }

.fleet-form input, .fleet-form select, .fleet-form textarea {
  width: 100%; padding: 12px;
  border: 1px solid var(--border); background: var(--input-bg);
  border-radius: var(--radius-lg); font-size: 14px; color: var(--text-main);
  box-sizing: border-box;
}
.fleet-form input:focus, .fleet-form select:focus, .fleet-form textarea:focus {
  outline: none; border-color: var(--primary); background: #1e293b;
  box-shadow: 0 0 0 3px var(--primary-glow);
}
.fleet-form textarea { min-height: 80px; resize: vertical; }
.fleet-form select option { background: var(--surface); color: var(--text-main); }

.image-preview-box {
  width: 100%; height: 140px; border-radius: var(--radius-lg);
  object-fit: cover; margin-bottom: 10px; border: 1px solid var(--border);
  display: none;
}
.modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }

/* --- KEYFRAMES --- */
@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<div class="admin-wrapper">

  <header class="page-header">
    <div class="header-text">
      <h2>Fleet Admin</h2>
      <span class="subtext">Manage all registered vehicles</span>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add
    </button>
  </header>

  <div class="vehicle-grid">
    <% vehicles.forEach(vehicle => { %>
      <div class="v-card">
        
        <div class="v-image-wrapper">
          <div class="status-badge <%= vehicle.is_active ? 'status-active' : 'status-inactive' %>">
            <%= vehicle.is_active ? "Active" : "Inactive" %>
          </div>
          <% if(vehicle.image) { %>
            <img src="<%= vehicle.image %>" loading="lazy" alt="<%= vehicle.name %>">
          <% } else { %>
            <div style="display:flex; align-items:center; justify-content:center; height:100%; color:#64748b; font-size:11px;">No Image</div>
          <% } %>
        </div>

        <div class="v-content">
          <h4 class="v-name"><%= vehicle.name %></h4>
          <span class="v-cat"><%= vehicle.category %></span>

          <div class="v-stats">
            <div class="v-stat"><span>Seats</span><strong><%= vehicle.seating_capacity || "-" %></strong></div>
            <div class="v-stat"><span>Luggage</span><strong><%= vehicle.luggage_capacity || "-" %></strong></div>
            <div class="v-stat"><span>Per KM</span><strong>₹<%= vehicle.price_per_km || "-" %></strong></div>
            <div class="v-stat"><span>Per Day</span><strong>₹<%= vehicle.price_per_day || "-" %></strong></div>
          </div>
        </div>

        <div class="v-actions">
          <div class="edit-btn-wrap">
            <button type="button" class="btn btn-info edit-btn"
              data-id="<%= vehicle.id %>"
              data-name="<%= vehicle.name %>"
              data-category="<%= vehicle.category %>"
              data-seating="<%= vehicle.seating_capacity %>"
              data-luggage="<%= vehicle.luggage_capacity %>"
              data-pricekm="<%= vehicle.price_per_km %>"
              data-priceday="<%= vehicle.price_per_day %>"
              data-description="<%= vehicle.description %>"
              data-sort="<%= vehicle.sort_order %>"
              data-image="<%= vehicle.image %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Edit Details
            </button>
          </div>

          <form action="/admin/fleet/toggle/<%= vehicle.id %>" method="POST">
            <button class="btn btn-warning">
              <%= vehicle.is_active ? "Deactivate" : "Activate" %>
            </button>
          </form>

          <form action="/admin/fleet/delete/<%= vehicle.id %>" method="POST" onsubmit="return confirm('Delete <%= vehicle.name %> permanently?');">
            <button class="btn btn-danger">Delete</button>
          </form>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<div id="addModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Add New Vehicle</h3>
      <button class="close-btn" onclick="closeAddModal()">&times;</button>
    </div>

    <form action="/admin/fleet/add" method="POST" enctype="multipart/form-data" class="fleet-form form-grid">
      <div class="input-group full-width">
        <img id="addPreviewImage" class="image-preview-box" />
        <label>Upload Image</label>
        <input type="file" name="image" accept="image/*" style="padding: 10px;" onchange="previewImage(event, 'addPreviewImage')" />
      </div>
      <div class="input-group full-width"><label>Vehicle Name</label><input name="name" placeholder="e.g. Toyota Innova" required /></div>
      <div class="input-group full-width">
        <label>Category</label>
        <select name="category" required>
          <option value="">Select Category</option>
          <option>Hatchback</option><option>Sedan</option><option>Prime Sedan</option>
          <option>SUV</option><option>Prime SUV</option><option>Tempo Traveller</option><option>Buses</option>
        </select>
      </div>
      <div class="input-group"><label>Seats</label><input name="seating_capacity" type="number" placeholder="0" /></div>
      <div class="input-group"><label>Luggage</label><input name="luggage_capacity" type="number" placeholder="0" /></div>
      <div class="input-group"><label>Price / KM (₹)</label><input name="price_per_km" type="number" step="0.1" placeholder="0.00" /></div>
      <div class="input-group"><label>Price / Day (₹)</label><input name="price_per_day" type="number" step="0.1" placeholder="0.00" /></div>
      <div class="input-group full-width"><label>Sort Order</label><input name="sort_order" type="number" placeholder="Display order" /></div>
      <div class="input-group full-width"><label>Description</label><textarea name="description" placeholder="Vehicle features..."></textarea></div>
      <div class="modal-actions full-width">
        <button type="button" class="btn btn-secondary" onclick="closeAddModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Vehicle</button>
      </div>
    </form>
  </div>
</div>

<div id="editModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Edit Vehicle</h3>
      <button class="close-btn" onclick="closeEditModal()">&times;</button>
    </div>

    <form id="editForm" method="POST" enctype="multipart/form-data" class="fleet-form form-grid">
      <div class="input-group full-width">
        <img id="editPreviewImage" class="image-preview-box" />
        <label>Update Image</label>
        <input type="file" name="image" accept="image/*" style="padding: 10px;" onchange="previewImage(event, 'editPreviewImage')" />
      </div>
      <div class="input-group full-width"><label>Vehicle Name</label><input name="name" id="editName" required /></div>
      <div class="input-group full-width">
        <label>Category</label>
        <select name="category" id="editCategory" required>
          <option value="">Select Category</option>
          <option>Hatchback</option><option>Sedan</option><option>Prime Sedan</option>
          <option>SUV</option><option>Prime SUV</option><option>Tempo Traveller</option><option>Buses</option>
        </select>
      </div>
      <div class="input-group"><label>Seats</label><input name="seating_capacity" id="editSeating" type="number" /></div>
      <div class="input-group"><label>Luggage</label><input name="luggage_capacity" id="editLuggage" type="number" /></div>
      <div class="input-group"><label>Price / KM (₹)</label><input name="price_per_km" id="editPriceKm" type="number" step="0.1" /></div>
      <div class="input-group"><label>Price / Day (₹)</label><input name="price_per_day" id="editPriceDay" type="number" step="0.1" /></div>
      <div class="input-group full-width"><label>Sort Order</label><input name="sort_order" id="editSort" type="number" /></div>
      <div class="input-group full-width"><label>Description</label><textarea name="description" id="editDescription"></textarea></div>
      <div class="modal-actions full-width">
        <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Update</button>
      </div>
    </form>
  </div>
</div>

<script>
function previewImage(event, previewElementId) {
  const reader = new FileReader();
  const imageField = document.getElementById(previewElementId);
  reader.onload = function() {
    if(reader.readyState === 2) {
      imageField.src = reader.result;
      imageField.style.display = 'block';
    }
  }
  if(event.target.files[0]) { reader.readAsDataURL(event.target.files[0]); }
}

function openAddModal() {
  document.getElementById("addPreviewImage").style.display = "none";
  document.getElementById("addPreviewImage").src = "";
  document.getElementById("addModal").classList.add("active");
  document.body.style.overflow = "hidden";
}
function closeAddModal() {
  document.getElementById("addModal").classList.remove("active");
  document.body.style.overflow = "auto";
}

document.querySelectorAll(".edit-btn").forEach(btn => {
  btn.addEventListener("click", function() {
    const modal = document.getElementById("editModal");
    modal.classList.add("active");
    document.body.style.overflow = "hidden";

    document.getElementById("editForm").action = "/admin/fleet/edit/" + this.dataset.id;
    document.getElementById("editName").value = this.dataset.name || "";
    document.getElementById("editCategory").value = this.dataset.category || "";
    document.getElementById("editSeating").value = this.dataset.seating || "";
    document.getElementById("editLuggage").value = this.dataset.luggage || "";
    document.getElementById("editPriceKm").value = this.dataset.pricekm || "";
    document.getElementById("editPriceDay").value = this.dataset.priceday || "";
    document.getElementById("editDescription").value = this.dataset.description || "";
    document.getElementById("editSort").value = this.dataset.sort || "";

    const previewImg = document.getElementById("editPreviewImage");
    if(this.dataset.image && this.dataset.image !== "undefined" && this.dataset.image.trim() !== "") {
      previewImg.src = this.dataset.image;
      previewImg.style.display = "block";
    } else {
      previewImg.src = "";
      previewImg.style.display = "none";
    }
  });
});

function closeEditModal() {
  document.getElementById("editModal").classList.remove("active");
  document.body.style.overflow = "auto";
}

window.onclick = function(event) {
  if (event.target.classList.contains('modal-overlay')) {
    closeAddModal();
    closeEditModal();
  }
}
</script>

<%- include("../admin/partials/footer") %>