<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Set New Password | Radha Travels</title>
  <%- include('../partials/head', { title: 'Set New Password' }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <style>
    /* ==========================================
       EXECUTIVE DARK THEME
    ========================================== */
    body {
      margin: 0;
      margin-top: -60px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #0b0f19;
      color: #e2e8f0;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(217, 119, 6, 0.08), transparent 40%),
        radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 1), transparent 40%);
    }

    .rt-reset-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      padding: 48px 40px;
      margin: 20px;
      background: #1e293b;
      border: 1px solid #334155;
      border-top: 4px solid #fbbf24;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .rt-header-group { text-align: center; margin-bottom: 35px; }
    .rt-header-group h2 { margin: 0 0 8px 0; font-size: 26px; font-weight: 700; color: #f8fafc; }
    .rt-subtitle { color: #94a3b8; font-size: 14px; line-height: 1.5; }

    .rt-alert-error {
      background: rgba(127, 29, 29, 0.2); border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5; padding: 14px; border-radius: 10px; font-size: 14px;
      margin-bottom: 24px; text-align: center;
    }

    .rt-input-group { margin-bottom: 24px; position: relative; }
    .rt-label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: #94a3b8; margin-bottom: 8px; }
    .rt-match-status { font-size: 12px; font-weight: 500; }
    
    .rt-input-wrapper { position: relative; }
    .rt-input {
      width: 100%; padding: 14px 45px 14px 16px; font-size: 15px; color: #f8fafc;
      background: #0f172a; border: 1px solid #334155; border-radius: 10px;
      outline: none; box-sizing: border-box; transition: all 0.2s ease;
    }
    .rt-input::placeholder { color: #475569; }
    .rt-input:focus { border-color: #fbbf24; box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15); }

    .rt-toggle-password {
      position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: #64748b; cursor: pointer; padding: 0;
    }
    .rt-toggle-password:hover { color: #fbbf24; }

    .rt-btn {
      width: 100%; padding: 15px; background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      color: #0b0f19; border: none; border-radius: 10px; font-size: 16px; font-weight: 700;
      cursor: pointer; transition: all 0.2s ease; margin-top: 8px;
    }
    .rt-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(217, 119, 6, 0.3); }
    .rt-btn:disabled { background: #334155; color: #94a3b8; cursor: not-allowed; }
  </style>
</head>
<body>

  <div class="rt-reset-card">
    <div class="rt-header-group">
      <h2>Set New Password</h2>
      <div class="rt-subtitle">Create a strong, secure password for your administrator account.</div>
    </div>

    <form method="POST" action="/admin/reset/<%= token %>" id="resetForm">
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="rt-alert-error"><%= error %></div>
      <% } %>

      <div class="rt-input-group">
        <div class="rt-label">
          <label for="password">New Password</label>
        </div>
        <div class="rt-input-wrapper">
          <input type="password" name="password" class="rt-input" placeholder="Min. 6 characters" required id="password" autofocus minlength="6">
          <button type="button" class="rt-toggle-password" data-target="password">👁️</button>
        </div>
      </div>

      <div class="rt-input-group">
        <div class="rt-label">
          <label for="confirmPassword">Confirm Password</label>
          <span class="rt-match-status" id="matchStatus"></span>
        </div>
        <div class="rt-input-wrapper">
          <input type="password" name="confirmPassword" class="rt-input" placeholder="Re-enter new password" required id="confirmPassword" minlength="6">
          <button type="button" class="rt-toggle-password" data-target="confirmPassword">👁️</button>
        </div>
      </div>

      <button type="submit" class="rt-btn" id="submitBtn">Update Securely</button>

    </form>
  </div>
  
  <script>
    // Visibility Toggles
    document.querySelectorAll('.rt-toggle-password').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.getAttribute('data-target'));
        input.type = input.type === 'password' ? 'text' : 'password';
      });
    });

    // Match Validation
    const passInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const matchStatus = document.getElementById('matchStatus');
    const submitBtn = document.getElementById('submitBtn');

    function checkMatch() {
      if (confirmInput.value.length === 0) {
        matchStatus.textContent = ''; submitBtn.disabled = false; return;
      }
      if (passInput.value === confirmInput.value) {
        matchStatus.textContent = 'Passwords match'; matchStatus.style.color = '#10b981'; submitBtn.disabled = false;
      } else {
        matchStatus.textContent = 'Passwords do not match'; matchStatus.style.color = '#ef4444'; submitBtn.disabled = true;
      }
    }
    passInput.addEventListener('input', checkMatch);
    confirmInput.addEventListener('input', checkMatch);
  </script>
</body>
</html> 