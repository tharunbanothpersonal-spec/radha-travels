<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login | Radha Travels</title>
  <%- include('../partials/head', { title }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    /* ==========================================
       PREMIUM DARK TRAVEL THEME
    ========================================== */
    body {
      margin: 0;
      margin-top: -60px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      
      /* Subtle travel-inspired dark background (Dark overlay on a generic night/travel image) */
      background: linear-gradient(rgba(11, 15, 25, 0.85), rgba(11, 15, 25, 0.95)), 
                  url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop') no-repeat center center;
      background-size: cover;
      color: #e2e8f0;
    }

    /* --- Dark Frosted Glass Card --- */
    .rt-login-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      padding: 50px 40px;
      margin: 20px;
      background: rgba(30, 41, 59, 0.4);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.7);
      animation: fadeIn 0.8s ease-out forwards;
      opacity: 0;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .rt-header-group {
      text-align: center;
      margin-bottom: 40px;
    }

    /* Elegant Brand Accent */
    .rt-brand-accent {
      display: inline-block;
      width: 48px;
      height: 4px;
      background: linear-gradient(90deg, #fbbf24, #d97706);
      border-radius: 2px;
      margin-bottom: 16px;
    }

    .rt-header-group h2 {
      margin: 0 0 8px 0;
      font-size: 26px;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 0.5px;
    }

    .rt-subtitle {
      color: #94a3b8;
      font-size: 14px;
      letter-spacing: 0.5px;
    }

    /* --- Error Message --- */
    .rt-error-msg {
      background: rgba(220, 38, 38, 0.15);
      border-left: 4px solid #ef4444;
      color: #fca5a5;
      padding: 12px 16px;
      border-radius: 4px;
      font-size: 14px;
      margin-bottom: 24px;
      text-align: left;
    }

    /* --- Input Fields --- */
    .rt-input-group {
      margin-bottom: 24px;
      position: relative;
    }

    .rt-label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #cbd5e1;
      margin-bottom: 8px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .rt-input {
      width: 100%;
      padding: 15px 16px;
      font-size: 15px;
      color: #ffffff;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      outline: none;
      box-sizing: border-box;
      transition: all 0.3s ease;
    }

    .rt-input::placeholder {
      color: #475569;
    }

    .rt-input:focus {
      background: rgba(15, 23, 42, 0.9);
      border-color: #fbbf24; /* Gold accent on focus */
      box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15);
    }

    /* --- Forgot Password Link --- */
    .rt-forgot-password {
      display: block;
      text-align: right;
      margin-top: -12px;
      margin-bottom: 24px;
    }

    .rt-forgot-password a {
      color: #94a3b8;
      font-size: 13px;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .rt-forgot-password a:hover {
      color: #fbbf24;
    }

    /* --- Action Button --- */
    .rt-btn {
      width: 100%;
      padding: 16px;
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      color: #1e293b;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(217, 119, 6, 0.3);
      letter-spacing: 0.5px;
    }

    .rt-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(217, 119, 6, 0.4);
    }

    /* --- Close Button --- */
    .rt-close-btn {
      position: absolute;
      top: 24px;
      right: 24px;
      color: #64748b;
      transition: all 0.2s ease;
    }

    .rt-close-btn:hover {
      color: #ffffff;
      transform: scale(1.1);
    }
  </style>
</head>
<body>

  <div class="rt-login-card">
    <a href="/" class="rt-close-btn" aria-label="Return to Home">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </a>

    <div class="rt-header-group">
      <div class="rt-brand-accent"></div>
      <h2>Radha Travels</h2>
      <div class="rt-subtitle">Administrator Portal</div>
    </div>

    <form method="POST" action="/admin/login">
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="rt-error-msg">
          <%= error %>
        </div>
      <% } %>

      <div class="rt-input-group">
        <label for="admin_user" class="rt-label">Username</label>
        <input type="text" name="username" class="rt-input" placeholder="Enter admin username" required autocomplete="off" id="admin_user" autofocus>
      </div>

      <div class="rt-input-group">
        <label for="admin_pass" class="rt-label">Password</label>
        <input type="password" name="password" class="rt-input" placeholder="Enter your password" required id="admin_pass">
      </div>

      <div class="rt-forgot-password">
        <a href="/admin/forgot-password">Forgot password?</a>
      </div>

      <button type="submit" class="rt-btn">Secure Login</button>

    </form>
  </div>
  
  <%- include('../partials/social-dock') %>
</body>
</html>