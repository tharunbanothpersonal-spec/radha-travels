<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('../partials/head', { 
    title: title,
    metaDescription: "Hyderabad travel guides, temple trip planning, cab cost breakdowns and route information by Radha Travels."
  }) %>

  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: #f9fafb;
    }

    /* HERO */
    .blog-hero {
      padding: 60px 20px 40px;
      background: linear-gradient(135deg,#064e3b,#10b981);
      color: white;
      text-align: center;
    }

    .blog-hero h1 {
      margin: 0 0 10px;
      font-size: 28px;
    }

    .blog-hero p {
      margin: 0;
      font-size: 14px;
      opacity: 0.9;
    }

    /* GRID */
    .blog-grid {
      padding: 30px 16px 60px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 480px;
      margin: auto;
    }

    .blog-card {
      background: #ffffff;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0,0,0,0.05);
      transition: 0.3s ease;
    }

    .blog-card:hover {
      transform: translateY(-4px);
    }

    .blog-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    .blog-content {
      padding: 20px;
    }

    .blog-content h2 {
      font-size: 18px;
      margin: 0 0 10px;
      line-height: 1.4;
      color: #111827;
    }

    .blog-content p {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 15px;
      line-height: 1.6;
    }

    .read-more {
      font-size: 13px;
      font-weight: 600;
      color: #10b981;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .read-more:hover {
      text-decoration: underline;
    }

    @media (min-width: 768px) {
      .blog-grid {
        flex-direction: row;
        flex-wrap: wrap;
        max-width: 1100px;
      }

      .blog-card {
        width: calc(50% - 10px);
      }
    }

  </style>
</head>

<body>

<%- include('../partials/header') %>
<%- include('../partials/ticker') %>

<section class="blog-hero">
  <h1>Radha Travels Blog</h1>
  <p>Temple travel guides • Cab cost breakdowns • Route insights</p>
</section>

<section class="blog-grid">

  <% posts.forEach(post => { %>
    <article class="blog-card">
      <a href="/blog/<%= post.slug %>">
        <img src="<%= post.image %>" alt="<%= post.title %>">
      </a>

      <div class="blog-content">
        <h2>
          <a href="/blog/<%= post.slug %>" style="text-decoration:none;color:inherit;">
            <%= post.title %>
          </a>
        </h2>
        <p><%= post.excerpt %></p>

        <a class="read-more" href="/blog/<%= post.slug %>">
          Read Full Guide →
        </a>
      </div>
    </article>
  <% }) %>

</section>

<%- include('../partials/footer') %>

</body>
</html>