<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Booking Confirmed – Radha Travels</title>
<style>
  body{margin:0;padding:0;background:#f4fbf7;font-family:Arial,Helvetica,sans-serif}
  .card{max-width:620px;margin:24px auto;background:#fff;border-radius:16px;
        box-shadow:0 20px 50px rgba(11,122,70,.12);overflow:hidden}
  .header{padding:22px;background:linear-gradient(90deg,#0db46c,#0a7a46,#f5b630);color:#fff}
  .brand{font-size:26px;font-weight:900}
  .tag{font-size:13px;opacity:.95}
  .section{padding:24px;color:#07361f}
  .row{margin-bottom:16px}
  .label{font-size:12px;color:#6b8f7f}
  .value{font-size:16px;font-weight:800}
  .highlight{background:#f0fbf6;border-left:4px solid #0db46c;padding:14px;border-radius:8px}
  .cta{display:inline-block;margin:12px 10px 0 0;padding:14px 20px;border-radius:999px;
       background:#0b7a46;color:#fff;font-weight:900;text-decoration:none}
  .cta.secondary{background:#fff;color:#0b7a46;border:2px solid #0b7a46}
  .footer{padding:22px;background:linear-gradient(90deg,#0a7a46,#00c48c,#0a7a46);color:#fff}
  .icons svg{width:22px;height:22px;margin-left:10px;fill:#fff}
</style>
</head>

<body>
<div class="card">

  <!-- Header -->
  <div class="header">
    <div class="brand">🚖 Radha Travels</div>
    <div class="tag">Premium rides • Executive transfers</div>
  </div>

  <!-- Body -->
  <div class="section">
    <p>Dear <strong><%= booking.fullName %></strong>,</p>

    <p>Your booking has been <strong>successfully confirmed</strong>.  
       Thank you for choosing Radha Travels.</p>

    <div class="row">
      <div class="label">Booking ID</div>
      <div class="value"><%= booking.bookingId %></div>
    </div>

    <div class="row">
      <div class="label">Pickup Location</div>
      <div class="value"><%= booking.pickup %></div>
    </div>

    <div class="row">
      <div class="label">Date & Time</div>
      <div class="value"><%= booking.date %> • <%= booking.time || 'To be confirmed' %></div>
    </div>

    <div class="row">
      <div class="label">Vehicle Preference</div>
      <div class="value"><%= booking.carType || '-' %></div>
    </div>

    <div class="highlight">
      🚗 <strong>What happens next?</strong><br/>
      Driver & vehicle details will be shared with you shortly.
    </div>

    <a href="<%= siteUrl %>/bookings/<%= booking.bookingId %>" class="cta">View Booking</a>
    <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(booking.pickup) %>"
       class="cta secondary">View Pickup</a>
  </div>

  <!-- Footer -->
  <div class="footer">
    <table width="100%">
      <tr>
        <td>
          <strong>Radha Travels</strong><br/>
          📞 +91 8332958915<br/>
          ✉️ booking@radhatravels.co.in
        </td>
        <td align="right" class="icons">
          <!-- Facebook -->
          <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H8v-3h2.4V9.5c0-2.4 1.4-3.7 3.6-3.7 1 0 2 .1 2 .1v2.3h-1.1c-1.1 0-1.4.7-1.4 1.4V12h2.8l-.4 3h-2.4v7A10 10 0 0 0 22 12z"/></svg>
          <!-- Instagram -->
          <svg viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
          <!-- WhatsApp -->
          <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.9 14.5L2 22l5.7-1.5A10 10 0 1 0 12 2z"/></svg>
        </td>
      </tr>
    </table>
  </div>

</div>
</body>
</html>
