<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap');

  :root {
    --emerald-900: #02241b; 
    --emerald-800: #064e3b;
    --emerald-600: #059669;
    --gold-premium: #d4af37;
    --gold-light: #fbeea0;
    --text-muted: #a7f3d0;
    --text-light: #f1f5f9;
  }

  .rt-robust-footer {
    /* 
     * HIGH-VISIBILITY FLUID GRADIENT
     * Bounces between a very dark green and a rich, brighter emerald.
     * The angled (-45deg) and oversized background (300%) makes the movement smooth.
     */
    background: linear-gradient(-45deg, #02241b, #065f46, #02241b, #04402e);
    background-size: 300% 300%;
    animation: fluidShift 12s ease infinite;

    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    
    /* Your exact requested mobile padding */
    padding: 18px 20px 20px 20px;
    margin-top: 0; 
    border-top: 4px solid var(--gold-premium);
    box-shadow: 0 -4px 20px rgba(212, 175, 55, 0.15), inset 0 10px 50px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }

  /* The Animation Keyframes */
  @keyframes fluidShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .rt-footer-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1; 
  }

  /* --- MAIN MOBILE GRID --- */
  .rt-footer-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 45px; 
    margin-bottom: 10px;
  }

  /* --- BRAND SECTION --- */
  .rt-brand-block h3 {
    font-family: 'Playfair Display', serif; 
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: var(--gold-premium);
    letter-spacing: 0.5px;
    text-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
  }

  .rt-brand-block p {
    color: var(--text-light);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 24px 0;
    max-width: 340px;
  }

  .rt-social-icons {
    display: flex;
    gap: 16px;
  }

  .rt-social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(212, 175, 55, 0.4); 
    border-radius: 50%;
    color: var(--gold-premium);
    backdrop-filter: blur(4px);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .rt-social-icons a:hover {
    background: var(--gold-premium);
    color: var(--emerald-900);
    border-color: var(--gold-premium);
    transform: translateY(-5px) scale(1.08);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
  }

  /* --- THE MOBILE 2-COLUMN LINKS GRID --- */
  .rt-links-mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    gap: 25px;
  }

  .rt-link-col h4 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
    color: var(--gold-premium);
  }

  .rt-link-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .rt-link-col a {
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
    position: relative;
    display: inline-block;
    width: fit-content;
  }

  /* Premium animated gold underline */
  .rt-link-col a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -4px;
    left: 0;
    background-color: var(--gold-premium);
    transition: width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .rt-link-col a:hover {
    color: var(--gold-light);
  }

  .rt-link-col a:hover::after {
    width: 100%;
  }

  /* --- CONTACT SECTION (Premium Glassmorphism) --- */
  .rt-contact-block {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 30px;
    border-radius: 16px;
    border: 1px solid rgba(212, 175, 55, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .rt-contact-block h4 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
    color: var(--gold-premium);
  }

  .rt-contact-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    color: var(--text-light);
    font-size: 14px;
    margin-bottom: 22px;
    line-height: 1.5;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .rt-contact-row:hover {
    transform: translateX(6px);
    color: #ffffff;
  }

  .rt-contact-row:last-child {
    margin-bottom: 0;
  }

  .rt-contact-row svg {
    width: 20px;
    height: 20px;
    color: var(--gold-premium);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* --- BOTTOM BAR --- */
  .rt-footer-bottom-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .rt-footer-bottom-bar p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
  }

  .rt-trust-badge {
    color: var(--gold-premium);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: rgba(212, 175, 55, 0.1);
    padding: 8px 18px;
    border-radius: 30px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  /* --- DESKTOP SCALING --- */
  @media (min-width: 768px) {
    .rt-robust-footer {
      /* Your exact requested desktop padding */
      padding: 26px 40px 20px 24px;
    }
    .rt-footer-main-grid {
      grid-template-columns: 1.5fr 2fr 1.2fr;
      gap: 60px;
      margin-bottom: 20px;
    }
    .rt-footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>

