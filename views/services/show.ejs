<!doctype html>
<html lang="en">
<% 
  // --- 1. DYNAMIC DATA INITIALIZATION (Safe parsing) ---
  const D = (typeof details !== 'undefined' && details) || (typeof service !== 'undefined' && service && service.details) || { intro: '', highlights: [], terms: {}, routes: [], faqs: [] };
  const seo = (typeof service !== 'undefined' && service && service.seo) ? service.seo : {};

  const _slug     = (typeof service !== 'undefined' && service && (service.slug || service.id)) ? String(service.slug || service.id).toLowerCase() : '';
  const isLocal   = _slug === 'local-tour';
  const isOut     = _slug === 'outstation';
  const isAirport = _slug === 'airport-transfer';

  // Hero Image resolution
  let heroImg = "/images/services/default.jpg";
  if (typeof service !== 'undefined' && service) {
    if (service.image && typeof service.image === "string") heroImg = "/images/services/" + service.image;
    else if (service.image && service.image.src) heroImg = service.image.src;
    else if (service.slug) heroImg = "/images/services/" + service.slug + ".jpg";
  }

  const pageTitle = seo.metaTitle || (typeof title !== 'undefined' ? title : (service ? service.title : 'Service Details'));
%>
<head>
  <%- include('../partials/head', { title: pageTitle }) %>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    /* ==========================================================================
       RADHA TRAVELS: VIBRANT PREMIUM LAYOUT (Final Polish)
       Prefix: .rt-vibe-
       ========================================================================== */
    :root {
      --vibe-primary: #2563EB; /* Rich Blue */
      --vibe-secondary: #4F46E5; /* Indigo */
      --vibe-accent: #10B981; /* Emerald */
      --vibe-bg: #F8FAFC;
      --vibe-surface: #FFFFFF;
      --vibe-text-main: #0F172A;
      --vibe-text-muted: #64748B;
    }

    html { scroll-behavior: smooth; }
    
    .rt-vibe-body {
      background-color: var(--vibe-bg);
      font-family: 'Poppins', sans-serif;
      color: var(--vibe-text-main);
      overflow-x: hidden;
      padding-bottom: 0; /* Removed bottom padding since sticky action bar is gone */
    }

    /* --- Animations --- */
    .rt-vibe-reveal {
      opacity: 0; transform: translateY(30px);
      transition: all 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .rt-vibe-reveal.active { opacity: 1; transform: translateY(0); }

    /* ==========================================================================
       1. HERO (Elevated to match Service Index)
       ========================================================================== */
    .rt-vibe-hero {
      position: relative; width: 100%; height: 85vh; min-height: 400px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 0 1.5rem 100px 1.5rem; /* Padding replaces negative margins to keep text centered above the scroll button */
      overflow: hidden;
    }

    /* Cinematic Parallax Background */
    .rt-vibe-hero-bg {
      position: absolute; inset: 0; z-index: 0;
      background-image: url('<%= heroImg %>');
      background-size: cover; background-position: center;
      background-attachment: fixed;
      animation: vibeHeroZoom 20s linear infinite alternate;
    }
    @keyframes vibeHeroZoom {
      0% { transform: scale(1); }
      100% { transform: scale(1.05); }
    }

    /* Rich gradient overlay */
    .rt-vibe-hero::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(15,23,42,0.85) 0%, rgba(37,99,235,0.4) 50%, rgba(15,23,42,0.95) 100%);
      z-index: 1;
    }

    .rt-vibe-hero-content {
      position: relative; z-index: 2; width: 100%; max-width: 800px;
    }

    .rt-vibe-breadcrumbs {
      display: inline-flex; gap: 8px; align-items: center;
      background: rgba(255,255,255,0.15); backdrop-filter: blur(8px);
      padding: 6px 16px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.2);
      font-size: 0.75rem; font-weight: 500; color: #E2E8F0; text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 1.5rem;
    }
    .rt-vibe-breadcrumbs a { color: #ffffff; text-decoration: none; transition: color 0.2s; }
    .rt-vibe-breadcrumbs a:hover { color: #FDE68A; } /* Switched hover to gold to match title */

    /* Top-Class Shimmering Metallic Title */
    @keyframes heroTextShimmer {
      to { background-position: 200% center; }
    }
    .rt-vibe-title {
      font-size: clamp(1.8rem, 6vw, 3.8rem); font-weight: 800;
      margin: 0 0 1rem 0; line-height: 1.15; letter-spacing: -0.02em;
      
      /* The Premium Gold Gradient */
      background: linear-gradient(90deg, #FDE68A 0%, #D4AF37 25%, #FFFFFF 50%, #D4AF37 75%, #FDE68A 100%);
      background-size: 200% auto;
      color: #FDE68A; /* Fallback */
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: heroTextShimmer 6s linear infinite;
      
      /* Drop shadow works better with transparent clipped text than text-shadow */
      filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
    }
    
    .rt-vibe-intro {
      font-size: clamp(0.85rem, 2vw, 1.1rem); color: #E2E8F0; line-height: 1.7;
      margin: 0 auto; max-width: 650px; font-weight: 400; text-shadow: 0 4px 10px rgba(0,0,0,0.6);
    }

    /* ENHANCED SCROLL DOWN INDICATOR (.rt-vibe-) */
    @keyframes vibeScrollBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(8px); }
    }

    .rt-vibe-scroll-down {
      position: absolute; bottom: 40px; text-align: center; z-index: 10;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      text-decoration: none; cursor: pointer;
    }

    .rt-vibe-scroll-text {
      font-size: 0.65rem; font-weight: 600; color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase; letter-spacing: 0.2em;
      transition: color 0.3s ease, transform 0.3s ease;
    }

    .rt-vibe-scroll-circle {
      width: 46px; height: 46px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      animation: vibeScrollBounce 2.5s infinite ease-in-out;
    }

    .rt-vibe-scroll-circle i {
      color: #ffffff; font-size: 1.4rem; transition: transform 0.3s ease, color 0.3s ease;
    }

    .rt-vibe-scroll-down:hover .rt-vibe-scroll-text { color: #ffffff; transform: translateY(-2px); }
    .rt-vibe-scroll-down:hover .rt-vibe-scroll-circle {
      background: rgba(212, 175, 55, 0.15); border-color: #D4AF37; /* Switched to gold hover */
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3); animation-play-state: paused;
    }
    .rt-vibe-scroll-down:hover .rt-vibe-scroll-circle i { color: #D4AF37; transform: translateY(4px); }

    /* ==========================================================================
       2. TYPOGRAPHY & LAYOUT GAPS (User Definitions)
       ========================================================================== */
    .rt-vibe-container { margin: 0 auto; padding: 1rem 1.5rem; max-width: 1150px; }
    
    .rt-vibe-section { margin-bottom: 2rem; }
    
    .rt-vibe-section-head { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 6px; text-align: center; }
    .rt-vibe-eyebrow {
      color: var(--vibe-primary); font-size: 0.8rem; font-weight: 800;
      text-transform: uppercase; letter-spacing: 0.15em;
    }
    .rt-vibe-section-title {
      font-size: clamp(1.6rem, 5vw, 2.5rem); font-weight: 800; color: var(--vibe-text-main); margin: 0; line-height: 1.2; letter-spacing: -0.02em;
    }

    /* ==========================================================================
       3. ROUTES (User's Custom Mobile Grid)
       ========================================================================== */
    .rt-vibe-routes-wrap {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding-bottom: 10px;
    }

    .rt-vibe-route-card {
      background: var(--vibe-surface); border-radius: 16px; padding: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #E2E8F0;
      display: flex; align-items: center; gap: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .rt-vibe-route-card:hover { transform: translateY(-2px); border-color: var(--vibe-primary); box-shadow: 0 8px 20px rgba(37,99,235,0.1); }
    
    .rt-vibe-route-icon {
      width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #EFF6FF; color: var(--vibe-primary);
      display: flex; align-items: center; justify-content: center; font-size: 0.9rem;
    }
    .rt-vibe-route-info { display: flex; flex-direction: column; justify-content: center; }
    .rt-vibe-route-path { font-size: 0.7rem; font-weight: 700; color: var(--vibe-text-main); margin: 0; line-height: 1.2; }
    .rt-vibe-route-stats { font-size: 0.55rem; color: var(--vibe-text-muted); font-weight: 500; margin: 0; display: flex; gap: 6px; flex-wrap: wrap; }

    @media (min-width: 768px) {
      .rt-vibe-routes-wrap { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin: 0; }
      .rt-vibe-route-card { flex: 1 1 auto; max-width: max-content; padding: 12px 20px 12px 12px; border-radius: 50px; }
      .rt-vibe-route-path { font-size: 0.9rem; }
    }

    /* ==========================================================================
       4. RICH & COLORFUL FLEET SECTION
       ========================================================================== */
    .rt-vibe-filter-wrap {
      position: sticky; top: 100px; z-index: 40;
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      padding: 5px 0; margin-bottom: 1rem; display: flex; justify-content: center; border-bottom: 1px solid rgba(0,0,0,0.03);
    }
    
    .rt-vibe-filter-track {
      display: inline-flex; gap: 4px; padding: 4px; border-radius: 50px; background: #E2E8F0;
      -ms-overflow-style: none; scrollbar-width: none; max-width: 100%; flex-wrap: nowrap; overflow-x: auto;
    }
    .rt-vibe-filter-track::-webkit-scrollbar { display: none; }
    
    .rt-vibe-filter-btn {
      white-space: nowrap; background: transparent; border: none; color: var(--vibe-text-muted);
      padding: 8px 16px; border-radius: 100px; font-family: 'Poppins', sans-serif; font-size: 0.8rem; font-weight: 600;
      cursor: pointer; transition: all 0.3s ease;
    }
    .rt-vibe-filter-btn.active {
      background: var(--vibe-surface); color: var(--vibe-primary); box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .rt-vibe-seg-card {
      background: var(--vibe-surface); border-radius: 20px; margin-bottom: 0.85rem;
      border: 1px solid #E2E8F0; box-shadow: 0 10px 30px rgba(15,23,42,0.05); overflow: hidden;
    }
    
    .rt-vibe-seg-head {
      background: linear-gradient(135deg, var(--vibe-primary), var(--vibe-secondary));
      color: #ffffff; padding: 1.5rem;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .rt-vibe-seg-head h3 { margin: 0; font-size: clamp(1.2rem, 4vw, 1.6rem); font-weight: 800; letter-spacing: -0.01em; }
    .rt-vibe-seg-badge { background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); color: #ffffff; padding: 4px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; border: 1px solid rgba(255,255,255,0.3); }

    .rt-vibe-seg-body { padding: 1.25rem; }
    @media (min-width: 768px) { .rt-vibe-seg-head{padding: 1rem 3rem;}}
    @media (min-width: 992px) { .rt-vibe-seg-body { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: start; padding: 2rem; } }

    /* User's Mobile First 2-Column Cars Grid */
    .rt-vibe-cars-grid { 
      display: grid; 
      grid-template-columns: repeat(2, 1fr); 
      gap: 10px; margin-bottom: 1.5rem; 
    }
    @media (min-width: 768px) { .rt-vibe-cars-grid { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 16px; } }

    .rt-vibe-car-box {
      background: linear-gradient(to bottom, #ffffff, #EFF6FF); 
      border: 1px solid #DBEAFE; border-radius: 12px; padding: 1rem 0.5rem; text-align: center;
      transition: transform 0.3s ease, border-color 0.3s ease;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .rt-vibe-car-box:hover { transform: translateY(-4px); border-color: var(--vibe-primary); box-shadow: 0 10px 25px rgba(37,99,235,0.1); }
    .rt-vibe-car-box img { width: 100%; max-height: 50px; object-fit: contain; mix-blend-mode: multiply; margin-bottom: 0.75rem; transition: transform 0.3s ease; }
    .rt-vibe-car-box:hover img { transform: scale(1.05); }
    .rt-vibe-car-box h4 { margin: 0; font-size: 0.8rem; font-weight: 800; color: var(--vibe-text-main); line-height: 1.2;}
    .rt-vibe-car-box p { margin: 4px 0 0 0; font-size: 0.65rem; color: var(--vibe-text-muted); font-weight: 500; }

    .rt-vibe-ledger { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem; }
    .rt-vibe-ledger-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 12px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;
    }
    .rt-vibe-ledger-label { color: var(--vibe-text-main); font-size: 0.8rem; font-weight: 600; }
    .rt-vibe-ledger-val { color: var(--vibe-text-main); font-size: 0.9rem; font-weight: 800; }
    
    .rt-vibe-ledger-val.highlight {
      color: #ffffff; background: var(--vibe-accent);
      padding: 4px 10px; border-radius: 6px; font-size: 0.95rem;
      box-shadow: 0 4px 10px rgba(16,185,129,0.3);
    }

    .rt-vibe-terms { background: #F1F5F9; padding: 1rem; border-radius: 10px; font-size: 0.75rem; border: 1px dashed #CBD5E1; margin-bottom: 1.5rem; }
    .rt-vibe-terms p { margin: 0 0 6px 0; color: var(--vibe-text-muted); line-height: 1.5; }
    .rt-vibe-terms p:last-child { margin: 0; }
    .rt-vibe-terms i.inc { color: var(--vibe-accent); margin-right: 6px; font-size: 0.95rem; vertical-align: middle; }
    .rt-vibe-terms i.exc { color: #EF4444; margin-right: 6px; font-size: 0.95rem; vertical-align: middle; }

    /* Actions */
    .rt-vibe-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1.5rem;}
    .rt-vibe-desk-btn {
      flex: 1; min-width: 120px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 12px 16px; border-radius: 12px; font-size: 0.85rem; font-weight: 700; cursor: pointer; border: none; text-decoration: none; transition: all 0.3s ease;
    }
    .rt-vibe-desk-btn:active { transform: scale(0.97); }
    .rt-vibe-desk-btn-wa { background: #ffffff; color: var(--vibe-primary); border: 2px solid var(--vibe-primary); }
    .rt-vibe-desk-btn-wa:hover { background: #EFF6FF; }
    .rt-vibe-desk-btn-book { background: var(--vibe-accent); color: #ffffff; box-shadow: 0 4px 15px rgba(16,185,129,0.2); }
    .rt-vibe-desk-btn-book:hover { background: #059669; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(16,185,129,0.3); }

    /* ==========================================================================
       6. FAQS
       ========================================================================== */
    .rt-vibe-faq-wrap { max-width: 800px; margin: 0 auto; }
    .rt-vibe-faq-item {
      background: var(--vibe-surface); border: 1px solid #E2E8F0; border-radius: 16px; margin-bottom: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.02); transition: box-shadow 0.3s ease;
    }
    .rt-vibe-faq-item:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.05); }
    .rt-vibe-faq-item summary {
      padding: 1.25rem 1.5rem; font-size: 0.9rem; font-weight: 700; color: var(--vibe-text-main);
      cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; outline: none;
    }
    .rt-vibe-faq-item summary::-webkit-details-marker { display: none; }
    .rt-vibe-faq-item summary i { color: var(--vibe-primary); transition: transform 0.3s; font-size: 1.2rem; background: #EFF6FF; padding: 6px; border-radius: 50%; }
    .rt-vibe-faq-item details[open] summary i { transform: rotate(180deg); background: var(--vibe-primary); color: #fff; }
    .rt-vibe-faq-content { padding: 0 1.25rem 1.25rem 1.25rem; font-size: 0.85rem; color: var(--vibe-text-muted); line-height: 1.7; }

    /* Desktop Adjustments */
    @media (min-width: 768px) {
      .rt-vibe-filter-wrap { top: 90px; padding: 20px 0 10px 0 ; }
      .rt-vibe-filter-track { flex-wrap: nowrap; overflow-x: auto; gap: 8px; padding: 6px; border-radius: 100px; }
      .rt-vibe-filter-btn { padding: 10px 24px; font-size: 0.9rem; }
      
      .rt-vibe-actions { margin-top: 2rem; } 
      .rt-vibe-desk-btn { padding: 14px 24px; font-size: 1rem; }
    }
  </style>
</head>
<body class="rt-vibe-body">

  <%- include('../partials/header') %>
  <%- include('../partials/ticker') %>

  <main>
    <header class="rt-vibe-hero">
      <div class="rt-vibe-hero-bg"></div>
      
      <a href="/services" style="position:absolute; top:25px; left:25px; display:flex; align-items:center; justify-content:center; width:45px; height:45px; border-radius:50%; background:rgba(255,255,255,0.1); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,0.3); color:#fff; font-size:1.4rem; z-index:10; transition: all 0.3s ease;"><i class="ri-arrow-left-line"></i></a>
      
      <div class="rt-vibe-hero-content rt-vibe-reveal">
        <div class="rt-vibe-breadcrumbs">
          <a href="/">Home</a> <i class="ri-arrow-right-s-line" style="color:rgba(255,255,255,0.5);"></i>
          <a href="/services">Services</a> <i class="ri-arrow-right-s-line" style="color:rgba(255,255,255,0.5);"></i>
          <span style="color:#ffffff;"><%= typeof service !== 'undefined' && service ? service.title : 'Details' %></span>
        </div>
        <h1 class="rt-vibe-title"><%= service ? service.title : 'Service Details' %></h1>
        <% if (D.intro) { %>
          <p class="rt-vibe-intro"><%= D.intro %></p>
        <% } %>
      </div>

      <a href="#rt-vibe-seg-list" class="rt-vibe-scroll-down rt-vibe-reveal" style="transition-delay: 0.3s;">
        <span class="rt-vibe-scroll-text">Scroll down to explore</span>
        <div class="rt-vibe-scroll-circle">
          <i class="ri-arrow-down-line"></i>
        </div>
      </a>
    </header>

    <div class="rt-vibe-container">
      
      <% if (Array.isArray(D.routes) && D.routes.length) { %>
        <div class="rt-vibe-section rt-vibe-reveal">
          <div class="rt-vibe-section-head">
            <span class="rt-vibe-eyebrow"><i class="ri-map-pin-range-fill"></i> Famous Routes</span>
          </div>
          
          <div class="rt-vibe-routes-wrap">
            <% D.routes.forEach(function(r){ %>
              <div class="rt-vibe-route-card">
                <div class="rt-vibe-route-icon"><i class="ri-map-pin-user-fill"></i></div>
                <div class="rt-vibe-route-info">
                  <p class="rt-vibe-route-path"><%= r.from %> <span style="color:#94a3b8; font-weight:400; margin:0 4px;">&rarr;</span> <%= r.to %></p>
                  <div class="rt-vibe-route-stats">
                    <% if (r.km) { %><span><%= r.km %> km</span><% } %>
                    <% if (r.km && r.time) { %><span style="color:#CBD5E1;">|</span><% } %>
                    <% if (r.time) { %><span><%= r.time %></span><% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="rt-vibe-section rt-vibe-reveal">
        
        <div class="rt-vibe-section-head" id="rt-vibe-fleet-anchor">
          <span class="rt-vibe-eyebrow"><i class="ri-steering-2-fill"></i> Premium Fleet</span>
          <h2 class="rt-vibe-section-title">Vehicle & Pricing Options</h2>
        </div>

        <div class="rt-vibe-filter-wrap" id="rt-vibe-filter-nav">
          <div class="rt-vibe-filter-track">
            <button class="rt-vibe-filter-btn active" data-filter="all">All Vehicles</button>
            <% segments.forEach(seg => { %>
              <button class="rt-vibe-filter-btn" data-filter="seg-<%= seg.id %>"><%= seg.label %></button>
            <% }) %>
          </div>
        </div>

        <div id="rt-vibe-seg-list" class="rt-vibe-seg-list">
          <% segments.forEach(seg => { %>
            <div class="rt-vibe-seg-card" data-seg="seg-<%= seg.id %>">
              
              <div class="rt-vibe-seg-head">
                <h3><%= seg.label %></h3>
                <span class="rt-vibe-seg-badge"><%= seg.cars ? seg.cars.length : 0 %> Options</span>
              </div>

              <div class="rt-vibe-seg-body">
                
                <div>
                  <div class="rt-vibe-cars-grid">
                    <% if(seg.cars && seg.cars.length) { %>
                      <% seg.cars.forEach(car => { 
                          let imgName = car.img || '';
                          const imgSrc = imgName.startsWith('/') ? imgName : '/images/cars/' + imgName;
                      %>
                        <div class="rt-vibe-car-box">
                          <img src="<%= imgSrc %>" alt="<%= car.name %>" loading="lazy">
                          <h4><%= car.name %></h4>
                          <p><%= car.features || 'AC • 4 Seater' %></p>
                        </div>
                      <% }) %>
                    <% } %>
                  </div>
                </div>

                <div>
                  <div class="rt-vibe-ledger">
                    <% if (isLocal && seg.pricing && seg.pricing.local) { %>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Base Package (8hr/80km)</span>
                        <span class="rt-vibe-ledger-val highlight">₹<%= seg.pricing.local.base ? seg.pricing.local.base.toLocaleString('en-IN') : '0' %></span>
                      </div>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Extra Per Km</span>
                        <span class="rt-vibe-ledger-val">₹<%= seg.pricing.local.extra_km %></span>
                      </div>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Extra Per Hour</span>
                        <span class="rt-vibe-ledger-val">₹<%= seg.pricing.local.extra_hr %></span>
                      </div>
                    <% } %>

                    <% if (isOut && seg.pricing && seg.pricing.outstation) { %>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Rate Per Km</span>
                        <span class="rt-vibe-ledger-val highlight">₹<%= seg.pricing.outstation.per_km %></span>
                      </div>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Min. Distance / Day</span>
                        <span class="rt-vibe-ledger-val"><%= seg.pricing.outstation.min_km_day %> km</span>
                      </div>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Driver Batta (Day)</span>
                        <span class="rt-vibe-ledger-val">₹<%= seg.pricing.outstation.driver %></span>
                      </div>
                    <% } %>

                    <% if (isAirport && seg.pricing && seg.pricing.airport) { %>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Airport Drop</span>
                        <span class="rt-vibe-ledger-val highlight">₹<%= seg.pricing.airport.drop %></span>
                      </div>
                      <div class="rt-vibe-ledger-row">
                        <span class="rt-vibe-ledger-label">Airport Pickup</span>
                        <span class="rt-vibe-ledger-val highlight">₹<%= seg.pricing.airport.pickup %></span>
                      </div>
                    <% } %>
                  </div>

                  <div class="rt-vibe-terms">
                    <% if (D.terms && D.terms.included) { %>
                      <p><i class="ri-checkbox-circle-fill inc"></i> <strong>Included:</strong> <%= D.terms.included.join(', ') %></p>
                    <% } else { %>
                      <p><i class="ri-checkbox-circle-fill inc"></i> <strong>Included:</strong> Fuel, Driver, AC</p>
                    <% } %>
                    <% if (D.terms && D.terms.excluded) { %>
                      <p><i class="ri-close-circle-fill exc"></i> <strong>Excluded:</strong> <%= D.terms.excluded.join(', ') %></p>
                    <% } else { %>
                      <p><i class="ri-close-circle-fill exc"></i> <strong>Excluded:</strong> Tolls, Parking, State Permits</p>
                    <% } %>
                  </div>

                  <div class="rt-vibe-actions">
                    <button class="rt-vibe-desk-btn rt-vibe-desk-btn-wa btn-wa" 
                            data-phone="+918332958915"
                            data-service="<%= service ? service.title : '' %>"
                            data-segment="<%= seg.label %>">
                      <i class="ri-whatsapp-line" style="font-size: 1.1rem;"></i> Quote
                    </button>
                    <button class="rt-vibe-desk-btn rt-vibe-desk-btn-book open-booking">
                      <i class="ri-calendar-check-fill" style="font-size: 1.1rem;"></i> Book Now
                    </button>
                  </div>
                </div>

              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <% if (Array.isArray(D.faqs) && D.faqs.length) { %>
        <div class="rt-vibe-section rt-vibe-reveal">
          <div class="rt-vibe-section-head">
            <span class="rt-vibe-eyebrow"><i class="ri-question-answer-fill"></i> Support</span>
            <h2 class="rt-vibe-section-title">Frequently Asked Questions</h2>
          </div>
          <div class="rt-vibe-faq-wrap">
            <% D.faqs.forEach(function(faq){ %>
              <div class="rt-vibe-faq-item">
                <details>
                  <summary><%= faq.question %> <i class="ri-arrow-down-s-line"></i></summary>
                  <div class="rt-vibe-faq-content"><%= faq.answer %></div>
                </details>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // 1. Scroll Reveals
    const revealElements = () => {
      const reveals = document.querySelectorAll('.rt-vibe-reveal');
      const windowHeight = window.innerHeight;
      reveals.forEach(el => {
        if (el.getBoundingClientRect().top < windowHeight - 50) {
          el.classList.add('active');
        }
      });
    };
    window.addEventListener('scroll', revealElements, { passive: true });
    window.addEventListener('load', () => setTimeout(revealElements, 100));

    // 2. Filter Logic (With robust scroll fix)
    const filterBtns = document.querySelectorAll('.rt-vibe-filter-btn');
    const segCards = document.querySelectorAll('.rt-vibe-seg-card');
    const filterNav = document.getElementById('rt-vibe-filter-nav');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filterVal = btn.getAttribute('data-filter');

        segCards.forEach(card => {
          if (filterVal === 'all') {
            card.style.display = 'block';
          } else {
            if (card.getAttribute('data-seg') === filterVal) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          }
        });
        
        // Robust mobile scroll - calculates exact document position
        if(window.innerWidth < 768 && filterNav) {
           const yOffset = filterNav.getBoundingClientRect().top + window.pageYOffset - 10;
           window.scrollTo({ top: yOffset, behavior: 'smooth' });
        }
      });
    });

    // 3. WhatsApp Routing
    document.querySelectorAll('.btn-wa').forEach(btn => {
      btn.addEventListener('click', () => {
        const phone   = (btn.dataset.phone || '').replace(/[^\d]/g,'');
        const service = btn.dataset.service || '';
        const segment = btn.dataset.segment || '';

        const msg = [
          "Hello Radha Travels 👋",
          "I am interested in booking:",
          "📌 Service: " + service,
          segment ? "🚗 Segment: " + segment : "",
          "",
          "Please share availability and exact pricing. Thank you!"
        ].filter(Boolean).join('\n');

        window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, "_blank");
      });
    });
  </script>

</body>
</html>