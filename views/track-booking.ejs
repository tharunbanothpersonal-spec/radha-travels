<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%- include('./partials/head', { title }) %>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    body{
      font-family:'Poppins',sans-serif;
      background:
        radial-gradient(circle at 20% 10%, #bbf7d0 0%, transparent 40%),
        radial-gradient(circle at 80% 90%, #a7f3d0 0%, transparent 40%),
        linear-gradient(180deg,#f8fffc,#ecfdf5);
      margin:0;
      padding:0;
    }

    .track-wrapper{
      max-width:700px;
      margin:120px auto 80px;
      padding:20px;
    }

    .track-card{
      background:rgba(255,255,255,0.9);
      backdrop-filter:blur(20px);
      border-radius:28px;
      padding:35px;
      box-shadow:0 25px 70px rgba(16,185,129,.15);
      border:1px solid rgba(16,185,129,.2);
      position:relative;
    }

    .back-btn{
      position:absolute;
      top:20px;
      left:20px;
      text-decoration:none;
      color:#065f46;
      font-weight:600;
      display:flex;
      align-items:center;
      gap:6px;
      font-size:14px;
    }

    .back-btn:hover{
      color:#059669;
    }

    h1{
      text-align:center;
      margin-bottom:30px;
      font-weight:800;
      background:linear-gradient(90deg,#059669,#10b981);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
    }

    form{
      display:flex;
      gap:10px;
      margin-bottom:25px;
    }

    input{
      flex:1;
      padding:14px;
      border-radius:14px;
      border:1px solid #d1d5db;
      font-size:14px;
    }

    button{
      padding:14px 18px;
      border-radius:14px;
      border:none;
      background:linear-gradient(90deg,#10b981,#059669);
      color:#fff;
      font-weight:600;
      cursor:pointer;
      transition:.3s;
    }

    button:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 20px rgba(16,185,129,.3);
    }

    .error{
      color:#dc2626;
      text-align:center;
      margin-bottom:15px;
      font-weight:600;
    }

    .booking-details{
      margin-top:20px;
      border-top:1px solid #e5e7eb;
      padding-top:20px;
    }

    .detail-row{
      display:flex;
      justify-content:space-between;
      margin-bottom:14px;
      font-size:14px;
    }

    .detail-row strong{
      color:#065f46;
    }

    .status{
      padding:6px 14px;
      border-radius:20px;
      font-size:12px;
      font-weight:700;
    }

    .pending{ background:#fef3c7; color:#92400e; }
    .confirmed{ background:#d1fae5; color:#065f46; }
    .assigned{ background:#dbeafe; color:#1e40af; }
    .completed{ background:#e9d5ff; color:#6b21a8; }

    hr{
      margin:20px 0;
      border:none;
      border-top:1px solid #e5e7eb;
    }

    @media(max-width:480px){
      form{
        flex-direction:column;
      }
      button{
        width:100%;
      }
      .track-card{
        padding:25px;
      }
    }
  </style>
</head>
<body>

<%- include("partials/header") %>

<div class="track-wrapper">
  <div class="track-card">

    <a href="/" class="back-btn">
      <i class="fa-solid fa-arrow-left"></i> Back to Home
    </a>

    <h1>Track Your Booking</h1>

    <form action="/track-booking" method="POST">
      <input 
        type="text" 
        name="bookingId" 
        placeholder="Enter Booking ID (e.g. RT-1234-5678)" 
        required
      >
      <button type="submit">
        <i class="fa-solid fa-search"></i>
      </button>
    </form>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (booking) { %>
      <div class="booking-details">

        <div class="detail-row">
          <strong>Booking ID</strong>
          <span><%= booking.booking_id %></span>
        </div>

        <div class="detail-row">
          <strong>Name</strong>
          <span><%= booking.full_name %></span>
        </div>

        <div class="detail-row">
          <strong>Date</strong>
          <span><%= booking.date %> | <%= booking.time %></span>
        </div>

        <div class="detail-row">
          <strong>Pickup</strong>
          <span><%= booking.pickup %></span>
        </div>

        <div class="detail-row">
          <strong>Status</strong>
          <span class="status <%= booking.status %>">
            <%= booking.status.toUpperCase() %>
          </span>
        </div>

        <% if (booking.driver_name) { %>
          <hr>

          <div class="detail-row">
            <strong>Driver</strong>
            <span><%= booking.driver_name %></span>
          </div>

          <div class="detail-row">
            <strong>Driver Phone</strong>
            <span><%= booking.driver_phone %></span>
          </div>

          <div class="detail-row">
            <strong>Vehicle</strong>
            <span>
              <%= booking.vehicle_type %> - 
              <%= booking.vehicle_number %>
            </span>
          </div>
        <% } %>

      </div>
    <% } %>

  </div>
</div>

<%- include("partials/footer") %>

</body>
</html>