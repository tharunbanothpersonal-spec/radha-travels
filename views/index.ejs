</section>

<%- include('partials/footer') %>
<script>

async function loadStateVisitors(){

try{

const res = await fetch("/api/state-visitors");
const data = await res.json();

const list = document.getElementById("stateVisitors");

if(!list) return;

list.innerHTML = "";

if(!data || data.length === 0){
list.innerHTML = "<li>No visitor data yet</li>";
return;
}

let max = Math.max(...data.map(s => s.total));

data.forEach(s=>{

const percent = (s.total / max) * 100;

const item = document.createElement("li");

item.innerHTML = `
<span class="state-name">${s.state}</span>

<div class="state-bar">
<div class="state-fill" data-width="${percent}%"></div>
</div>

<span class="state-count">${s.total}</span>
`;

list.appendChild(item);

});

/* animate bars */

setTimeout(()=>{

document.querySelectorAll(".state-fill").forEach(bar=>{
bar.style.width = bar.dataset.width;
});

},200);

}catch(err){

console.error("State visitor error",err);

}

}

document.addEventListener("DOMContentLoaded", loadStateVisitors);

</script>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const observerOptions = {
      root: null,
      threshold: 0.25, // Triggers earlier to ensure animations are ready
      rootMargin: "0px 0px -50px 0px" 
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('.reveal-item');
          
          items.forEach((item, index) => {
            // Fast 0.1s stagger creates a fluid wave instead of choppy delays
            const delay = index * 0.2; 
            item.style.transitionDelay = `${delay}s`;
            
            // requestAnimationFrame forces the browser into a high-performance render cycle
            requestAnimationFrame(() => {
              item.classList.add('is-visible');
            });
          });

          // Unobserve so elements do not re-animate on scroll up, saving memory
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const revealGroups = document.querySelectorAll('.reveal-group');
    revealGroups.forEach(group => revealObserver.observe(group));
  });

document.addEventListener("DOMContentLoaded", function() {

  const counters = document.querySelectorAll(".counter");

  function animateCounter(counter) {
    const target = parseFloat(counter.getAttribute("data-target"));
    const isDecimal = target % 1 !== 0;

    let current = 0;
    const duration = 1200;
    const increment = target / (duration / 16);

    function update() {
      current += increment;

      if (current < target) {
        counter.innerText = isDecimal
          ? current.toFixed(1)
          : Math.floor(current);
        requestAnimationFrame(update);
      } else {
        counter.innerText = isDecimal
          ? target.toFixed(1)
          : target;
          counter.classList.add("counter-finish");
      }
    }

    update();
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        counters.forEach(counter => {
          if (!counter.classList.contains("counted")) {
            counter.classList.add("counted");
            animateCounter(counter);
          }
        });
      }
    });
  }, { threshold: 0.4 });

  const section = document.querySelector(".home-review-preview");
  if(section) observer.observe(section);

});

//live ip counter
async function updateVisitors() {

  try {

    const res = await fetch("/api/live-visitors");
    const data = await res.json();

    document.getElementById("liveVisitors").innerText = data.total;

  } catch (err) {}

}

updateVisitors();
setInterval(updateVisitors, 30000);
</script>
