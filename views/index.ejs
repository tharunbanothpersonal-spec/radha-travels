<!-- Testimonial / Happy customer -->
<section class="home-review-preview reveal-group">

  <div class="container">

    <!-- HEADING -->
    <div class="hrp-heading reveal-item">
      <h2>Trusted Journeys. Genuine Smiles.</h2>
      <p>Luxury travel experiences rated by real families</p>
    </div>

    <div class="hrp-layout">

      <!-- LEFT: SUMMARY -->
      <div class="hrp-summary reveal-item">

        <div class="hrp-average">

          <div class="hrp-number counter"
               data-target="<%= avgRating || 4.8 %>">
            0
          </div>

          <div class="hrp-stars">
  <% 
    const rating = avgRating || 4.8;
    const fullStars = Math.floor(rating);
    const decimal = rating - fullStars;
  %>

  <% for(let i = 1; i <= 5; i++) { %>
    <% if(i <= fullStars) { %>
      <span class="star full">★</span>
    <% } else if(i === fullStars + 1 && decimal > 0) { %>
      <span class="star partial" style="--percent:<%= decimal * 100 %>%">★</span>
    <% } else { %>
      <span class="star empty">★</span>
    <% } %>
  <% } %>
</div>

        </div>

        <div class="hrp-rating-label">
          Customer Satisfaction Breakdown
        </div>

        <div class="hrp-bars">
          <% for(let i=5;i>=1;i--){ %>
            <div class="hrp-bar-row">
              <span><%= i %></span>
              <div class="hrp-bar">
                <div class="hrp-bar-fill"
                     style="width:<%= ratingPercentages ? ratingPercentages[i] : 70 %>%">
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <div class="hrp-review-count">
          <strong class="counter"
                  data-target="<%= totalReviews || 0 %>">0</strong>
          Verified Reviews
        </div>

        <div class="hrp-badge">
          ✔ Verified Travel Experiences
        </div>

      </div>

      <!-- SEPARATOR -->
      <div class="hrp-separator"></div>

      <!-- RIGHT: CARDS -->
      <div class="hrp-cards">

        <% randomTestimonials.slice(0,3).forEach(t => { %>

        <div class="hrp-card reveal-item">

          <div class="hrp-card-image">
            <img src="<%= t.image || '/images/default-user.png' %>"
                 alt="<%= t.name %>">
          </div>

          <div class="hrp-card-content">

            <div class="hrp-card-stars">
              <% for(let i=0;i<t.rating;i++){ %>★<% } %>
            </div>

            <p><%= t.review.substring(0,85) %>...</p>
            <span><%= t.name %></span>

          </div>

        </div>

        <% }) %>

      </div>

    </div>

    <div class="hrp-button reveal-item">
      <a href="/happy-customers">View All Reviews<i class="fa-solid fa-arrow-right"></i></a>
    </div>

  </div>

</section>
<!-- Home Gallery -->
<section class="home-gallery editorial-gallery-section reveal-group">
  <div class="container home-gallery-container">
    
    <div class="eg-header reveal-item reveal-slide-up">
      <h2>Moments from Our Journeys</h2>
      <div class="eg-divider"></div>
      <p>A curated collection of our finest travel experiences</p>
    </div>

    <% if (featuredGallery && featuredGallery.length) { %>
      <div class="eg-grid">
        <% featuredGallery.slice(0,5).forEach((item, index) => { %>
          <a href="/gallery" class="eg-card <%= index === 0 ? 'eg-large' : 'eg-small' %> reveal-item reveal-fade-scale">
            
            <div class="eg-img-wrapper">
              <img src="<%= item.filepath %>" alt="<%= item.title || 'Radha Travels Experience' %>" loading="lazy">
            </div>
            
            <div class="eg-overlay">
              <div class="eg-text-content">
                <span class="eg-meta">Featured</span>
                <h3><%= item.title || "Radha Travels" %></h3>
                <div class="eg-line"></div>
              </div>
            </div>

          </a>
        <% }) %>
      </div>
