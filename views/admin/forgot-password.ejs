<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <%- include('../partials/head', { title }) %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    /* Same Premium Dark Travel Theme as login.ejs */
    body {
      margin: 0;
      margin-top: -60px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: linear-gradient(rgba(11, 15, 25, 0.85), rgba(11, 15, 25, 0.95)), 
                  url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop') no-repeat center center;
      background-size: cover;
      color: #e2e8f0;
    }

    .rt-login-card {
      position: relative;
      width: 100%;
      max-width: 420px;
      padding: 50px 40px;
      margin: 20px;
      background: rgba(30, 41, 59, 0.4);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.7);
    }

    .rt-header-group { text-align: center; margin-bottom: 30px; }
    
    .rt-brand-accent {
      display: inline-block; width: 48px; height: 4px;
      background: linear-gradient(90deg, #fbbf24, #d97706);
      border-radius: 2px; margin-bottom: 16px;
    }

    .rt-header-group h2 { margin: 0 0 8px 0; font-size: 24px; color: #ffffff; }
    .rt-subtitle { color: #94a3b8; font-size: 14px; line-height: 1.5;}

    .rt-alert-success { background: rgba(16, 185, 129, 0.15); border-left: 4px solid #10b981; color: #6ee7b7; padding: 16px; border-radius: 4px; font-size: 14px; margin-bottom: 24px; line-height: 1.5; }
    .rt-alert-error { background: rgba(220, 38, 38, 0.15); border-left: 4px solid #ef4444; color: #fca5a5; padding: 12px 16px; border-radius: 4px; font-size: 14px; margin-bottom: 24px; }

    .rt-input-group { margin-bottom: 24px; }
    .rt-label { display: block; font-size: 13px; font-weight: 500; color: #cbd5e1; margin-bottom: 8px; text-transform: uppercase; }
    
    .rt-input {
      width: 100%; padding: 15px 16px; font-size: 15px; color: #ffffff;
      background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px; outline: none; box-sizing: border-box; transition: all 0.3s ease;
    }
    .rt-input:focus { background: rgba(15, 23, 42, 0.9); border-color: #fbbf24; box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15); }

    .rt-btn {
      width: 100%; padding: 16px; background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      color: #1e293b; border: none; border-radius: 12px; font-size: 16px; font-weight: 700;
      cursor: pointer; transition: all 0.3s ease; margin-bottom: 16px;
    }
    .rt-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(217, 119, 6, 0.4); }

    .rt-back-link { display: block; text-align: center; color: #94a3b8; text-decoration: none; font-size: 14px; transition: color 0.2s; }
    .rt-back-link:hover { color: #ffffff; }
  </style>
</head>
<body>

  <div class="rt-login-card">
    <div class="rt-header-group">
      <div class="rt-brand-accent"></div>
      <h2>Reset Password</h2>
      <div class="rt-subtitle">Enter your admin username to receive reset instructions.</div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="rt-alert-success"><%= success %></div>
      <a href="/admin/login" class="rt-btn" style="text-align: center; text-decoration: none; display: block; box-sizing: border-box;">Return to Login</a>
    <% } else { %>
      <form method="POST" action="/admin/forgot-password">
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="rt-alert-error"><%= error %></div>
        <% } %>

        <div class="rt-input-group">
          <label for="admin_user" class="rt-label">Username</label>
          <input type="text" name="username" class="rt-input" placeholder="Enter admin username" required autocomplete="off" id="admin_user" autofocus>
        </div>

        <button type="submit" class="rt-btn">Send Reset Link</button>
      </form>
    <% } %>

    <% if (!success) { %>
      <a href="/admin/login" class="rt-back-link">← Back to Login</a>
    <% } %>
  </div>
  
  <%- include('../partials/social-dock') %>
</body>
</html>