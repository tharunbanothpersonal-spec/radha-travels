<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Booking Confirmed - Radha Travels</title>
  <style>
    /* ==========================================
       FRESH MINT & EMERALD (SVG & Table Hybrid)
    ========================================== */
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&family=Inter:wght@400;500;600&display=swap');

    body {
      margin: 0; padding: 0;
      background-color: #e6f2eb; /* Soft greenish-grey background */
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: 100%;
    }
    
    table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    td, th { padding: 0; }
    
    .font-serif { font-family: 'Playfair Display', Georgia, serif; }
    .font-sans { font-family: 'Inter', -apple-system, Arial, sans-serif; }

    .email-wrapper { width: 100%; background-color: #e6f2eb; padding: 25px 10px; box-sizing: border-box; }
    
    .mobile-card {
      max-width: 440px; 
      margin: 0 auto;
      background-color: #f2fcf6; /* Very light greenish tint instead of pure white */
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #d1e8db;
      border-top: 5px solid #047857; /* Rich emerald accent */
      box-shadow: 0 10px 25px rgba(4, 120, 87, 0.08);
    }

    /* --- Header --- */
    .header {
      padding: 35px 20px 25px 20px;
      text-align: center;
      border-bottom: 1px solid #d1e8db;
      background-color: #f2fcf6;
    }
    
    .header-icon {
      margin-bottom: 15px;
    }

    .header h1 { color: #064e3b; font-size: 26px; margin: 0 0 5px 0; letter-spacing: 0.5px; }
    .header p { color: #047857; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; margin: 0; font-weight: 600; }

    /* --- Content --- */
    .content { padding: 30px 25px; }
    
    .greeting {
      color: #334155;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 30px;
      text-align: center;
    }
    .greeting strong { color: #064e3b; }

    /* --- SVG Data Table --- */
    .data-list {
      background-color: #eaf5ef; /* Slightly darker green tint for contrast */
      border-radius: 12px;
      padding: 25px 20px;
      margin-bottom: 30px;
      border: 1px solid #d1e8db;
    }

    .data-label {
      color: #527a66;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
      font-weight: 600;
    }
    
    .data-value {
      color: #064e3b;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }

    /* --- Buttons --- */
    .btn {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 16px 0;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      border-radius: 8px;
      text-decoration: none;
      margin-bottom: 15px;
    }
    .btn-primary {
      background-color: #047857; 
      color: #ffffff !important;
    }
    .btn-secondary {
      background-color: transparent;
      color: #047857 !important;
      border: 1px solid #047857;
    }

    /* --- Footer --- */
    .footer {
      background-color: #eaf5ef;
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid #d1e8db;
    }
    .footer-note { color: #527a66; font-size: 12px; line-height: 1.6; margin: 0 0 20px 0; }
    .footer-note strong { color: #047857; }
    .footer-contact { color: #334155; font-size: 13px; margin: 0; }
    .footer-contact a { color: #047857; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body class="font-sans">
  <div class="email-wrapper">
    <div class="mobile-card">
      
      <div class="header">
        <div class="header-icon">
          <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <h1 class="font-serif">Booking Confirmed</h1>
        <p>Radha Travels..🚘</p>
      </div>

      <div class="content">
        <div class="greeting">
          Dear <strong><%= booking.fullName %></strong>,<br>
          Your premium transfer is secured. Here are your itinerary details.
        </div>

        <div class="data-list">
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            
            <tr>
              <td width="40" valign="top" style="padding-top: 4px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16h6"/></svg>
              </td>
              <td valign="top" style="padding-bottom: 25px;">
                <div class="data-label">Booking Reference</div>
                <div class="data-value font-serif" style="font-size: 18px;"><%= booking.bookingId %></div>
              </td>
            </tr>

            <tr>
              <td width="40" valign="top" style="padding-top: 4px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </td>
              <td valign="top" style="padding-bottom: 25px;">
                <div class="data-label">Scheduled For</div>
                <div class="data-value"><%= booking.date %><br><span style="color:#527a66; font-size:14px; font-weight:400;"><%= booking.time || 'Time TBD' %></span></div>
              </td>
            </tr>

            <tr>
              <td width="40" valign="top" style="padding-top: 4px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
              </td>
              <td valign="top" style="padding-bottom: 25px;">
                <div class="data-label">Vehicle Preference</div>
                <div class="data-value"><%= booking.carType || 'Executive Sedan' %></div>
              </td>
            </tr>

            <tr>
              <td width="40" valign="top" style="padding-top: 4px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </td>
              <td valign="top">
                <div class="data-label">Designated Pickup</div>
                <div class="data-value"><%= booking.pickup %></div>
              </td>
            </tr>

          </table>
        </div>

        <a href="<%= siteUrl %>/bookings/<%= booking.bookingId %>" class="btn btn-primary">View Itinerary</a>
        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(booking.pickup) %>" class="btn btn-secondary">Map Location</a>
      </div>

      <div class="footer">
        <p class="footer-note">
          <strong>Driver Allotment:</strong> Chauffeur and vehicle plate details will be provided via email shortly before departure.
        </p>
        <p class="footer-contact">
          📞 +91 8332958915<br>
          <a href="mailto:booking@radhatravels.co.in">booking@radhatravels.co.in</a>
        </p>
      </div>

    </div>
  </div>
</body>
</html>