<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title><%= title %></title>
<meta name="description" content="<%= metaDescription || 'Book reliable Hyderabad cab service with Radha Travels. Airport transfers, outstation trips and temple tours available 24/7.' %>">
<link rel="canonical" href="https://radhatravels.co.in<%= locals.currentPath || '/' %>" />

<!-- Dynamic Open Graph Meta Tags for Social Previews & WhatsApp -->
<meta property="og:type" content="<%= typeof post !== 'undefined' ? 'article' : 'website' %>" />
<meta property="og:site_name" content="Radha Travels" />
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Hyderabad Cab Service | Radha Travels' %>" />
<meta property="og:description" content="<%= typeof post !== 'undefined' && post.excerpt ? post.excerpt : (locals.metaDescription || 'Premium Cab Service in Hyderabad. Safe, sanitized, and on-time.') %>" />
<meta property="og:image" content="<%= typeof post !== 'undefined' && post.image ? post.image : (locals.ogImage || 'https://radhatravels.co.in/images/logo_new.png') %>" />
<meta property="og:url" content="https://radhatravels.co.in<%= locals.currentPath || '/' %>" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">

<!-- Preload primary font -->
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" as="style">

<!-- Preload the critical Hero Image for mobile -->
<link rel="preload" as="image" href="/images/hero/2radha.webp">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-NW2VNYG671">
</script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-NW2VNYG671');
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://radhatravels.co.in/#business",
  "name": "Radha Travels",
  "image": "https://radhatravels.co.in/images/logo.png",
  "url": "https://radhatravels.co.in/",
  "telephone": "+918332958915",
  "priceRange": "₹₹", 
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "402, Moosapet",
    "addressLocality": "Hyderabad",
    "addressRegion": "Telangana",
    "postalCode": "500018",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "17.4649", 
    "longitude": "78.4354" 
  },
  "areaServed": {
    "@type": "City",
    "name": "Hyderabad"
  },
  "openingHours": "Mo-Su 00:00-23:59",
  "sameAs": [
    "https://www.facebook.com/radhatravels.in",
    "https://www.instagram.com/radhatravelshyd"
  ]
}
</script>

<% if (locals.pageSchema) { %>
<script type="application/ld+json">
  <%- pageSchema %>
</script>
<% } %>

