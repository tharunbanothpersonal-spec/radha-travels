<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta property="og:url" content="https://www.radhatravels.co.in/blog/<%= post.slug %>" />
<meta property="og:type" content="article" />
<meta property="og:title" content="<%= post.title %>" />
<meta property="og:description" content="<%= post.excerpt %>" />
<meta property="og:image" content="https://www.radhatravels.co.in<%= post.image %>" />
<!-- ✅ BLOG SCHEMA -->
<script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "BlogPosting",
 "headline": "<%= post.title %>",
 "description": "<%= post.excerpt %>",
 "image": "https://www.radhatravels.co.in<%= post.image %>",
 "author": {
   "@type": "Organization",
   "name": "Radha Travels"
 },
 "publisher": {
   "@type": "Organization",
   "name": "Radha Travels"
 },
 "datePublished": "<%= post.date %>"
}
</script>

<!-- ✅ FAQ SCHEMA (DYNAMIC SAFE) -->
<% if (post.faq) { %>
<script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
   <% post.faq.forEach((f, i) => { %>
   {
     "@type": "Question",
     "name": "<%= f.question %>",
     "acceptedAnswer": {
       "@type": "Answer",
       "text": "<%= f.answer %>"
     }
   }<%= i < post.faq.length - 1 ? ',' : '' %>
   <% }) %>
 ]
}
</script>
<% } %>

<!-- ✅ BREADCRUMB SCHEMA -->
<script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [{
   "@type": "ListItem",
   "position": 1,
   "name": "Home",
   "item": "https://www.radhatravels.co.in"
 },{
   "@type": "ListItem",
   "position": 2,
   "name": "Blog",
   "item": "https://www.radhatravels.co.in/blog"
 },{
   "@type": "ListItem",
   "position": 3,
   "name": "<%= post.title %>"
 }]
}
</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <%- include('../partials/head', { 
    title: (post.title || 'Travel Guide') + ' | Radha Travels',
    metaDescription: post.excerpt || "Expert travel guides and route information."
  }) %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ==========================================
       PERFECTED EDITORIAL DASHBOARD (BLUE THEME)
    ========================================== */
    :root {
      --brand-primary: #2563eb; 
      --brand-dark: #1e40af;    
      --brand-light: #eff6ff;   
      --accent-orange: #ea580c; 
      --badge-ochre: rgba(186, 135, 89, 0.95); 
      
      --bg-body: #f8fafc; 
      --bg-card: #ffffff;
      --text-hero: #0f172a; 
      --text-body: #334155; 
      --text-muted1: #0649a6;
      --border-line: #e2e8f0;
      
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
      --shadow-card: 0 8px 24px -4px rgba(15, 23, 42, 0.06);
    }

    .btn-header {display: none;}
    @media (min-width: 900px) {
      .btn-header { display: block; }
    }

    *, *::before, *::after { box-sizing: border-box; }

    /* Premium Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-body); }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* STRICT MOBILE VIEWPORT LOCKDOWN */
    html, body { 
      max-width: 100vw; 
      overflow-x: hidden; 
      margin: 0; 
      padding: 0; 
      background-color: var(--bg-body); 
      color: var(--text-body); 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      -webkit-font-smoothing: antialiased; 
    }
    
    a { text-decoration: none; color: inherit; transition: all 0.2s ease; }
    h1, h2, h3, p { margin: 0; }
    svg { flex-shrink: 0; display: block; } 

    /* Reading Progress Bar */
    #progressBar { position: fixed; top: 0; left: 0; height: 4px; background: var(--brand-primary); width: 0%; z-index: 9999; transition: width 0.1s; }

    /* --- 1. HERO BANNER --- */
    .portal-hero {
      position: relative; width: 100%;
      background-image: linear-gradient(
  65deg, 
  rgba(21, 25, 138, 0.5) 0%,    /* Starts Dark Blue */
  rgba(21, 25, 138, 0) 40%,     /* Fades to transparent EXACTLY at 20% */
  rgba(18, 49, 39, 0) 60%,      /* Stays completely transparent UNTIL 60% */
  rgba(25, 109, 83, 0.6) 100%    /* Fades to Dark Green at 100% */
), url('<%= post.image || "https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&q=80" %>');
      background-size: cover; background-position: center; padding: 120px 0px 100px; color: #ffffff;margin-top: 100px;
    }
    .hero-container { max-width: 1140px; margin: 0 auto auto 15px; position: relative; z-index: 10; }
    
    .breadcrumbs { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #94a3b8; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.5px; }
    .breadcrumbs a:hover { color: #ffffff; }
    .breadcrumbs span { color: #cbd5e1; }
    
    .article-title { font-size: clamp(24px, 5vw, 44px); font-weight: 800; line-height: 1.25; letter-spacing: -0.5px; max-width: 850px; margin-bottom: 20px; text-shadow: 0 2px 8px rgba(0,0,0,0.5); word-break: break-word; }
    
    .article-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; font-weight: 600; color: white; }
    .meta-pill { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.1); padding: 4px 12px; border-radius: 100px; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); }
    .meta-pill svg { color: #60a5fa; width: 14px; height: 14px; }

    /* --- 2. HIGH-DENSITY DASHBOARD LAYOUT --- */
    .dashboard-layout { max-width: 1140px; margin: -50px auto 80px; padding: 0 24px; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; position: relative; z-index: 20; align-items: start; }
    .main-column { display: flex; flex-direction: column; gap: 24px; min-width: 0; }

    /* ==========================================
       AUTHOR BLOCK 
    ========================================== */
    .author-block-wrapper {
      background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-line);
      box-shadow: var(--shadow-sm); padding: 16px 24px; 
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
    }
    .author-profile { display: flex; align-items: center; gap: 16px; flex-grow: 1; min-width: 0; }
    .author-avatar-badge {
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--brand-light); color: var(--brand-primary);
      display: flex; justify-content: center; align-items: center; font-size: 20px; font-weight: 800; flex-shrink: 0;
    }
    .author-info-center { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .author-name { font-size: 16px; font-weight: 800; color: var(--text-hero); display: flex; align-items: center; gap: 6px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .author-name svg { color: var(--brand-primary); width: 16px; height: 16px; flex-shrink: 0; }
    .author-subtitle { font-size: 13px; font-weight: 600; color: #0649a6; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } 
    
    .author-fact-check { text-align: right; border-left: 1px solid var(--border-line); padding-left: 20px; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; }
    .fc-label { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; color: var(--text-hero); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
    .fc-label svg { color: var(--text-hero); width: 14px; height: 14px; }
    .fc-value { font-size: 14px; font-weight: 600; color: var(--text-muted1); margin: 0; display: flex; align-items: center; gap: 4px; }

    .fc-mobile-badge { display: none; }

    /* Main Article Container */
    .ui-card { background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-line); box-shadow: var(--shadow-card); padding: 36px; min-width: 0; }

    /* Quick Facts Bar */
    .quick-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--border-line); }
    .fact-item { display: flex; flex-direction: column; gap: 4px; background: var(--bg-body); padding: 16px; border-radius: 12px; border: 1px solid var(--border-line); }
    .fact-label { font-size: 11px; font-weight: 800; color: var(--text-muted1); text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 4px; }
    .fact-label svg { color: var(--accent-orange); width: 14px; height: 14px; }
    .fact-value { font-size: 16px; font-weight: 800; color: var(--text-hero); }

    /* ==========================================
       CMS CONTENT - DE-BULKED SCALING
    ========================================== */
    .cms-content { font-size: 16px; line-height: 1.7; color: var(--text-body); word-wrap: break-word; }
    .cms-content > p:first-of-type { font-size: 17px; font-weight: 500; color: var(--text-hero); margin-bottom: 24px; }
    
    .cms-content h2 { font-size: 24px; font-weight: 800; color: var(--text-hero); margin: 40px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border-line); scroll-margin-top: 100px; }
    .cms-content h3 { font-size: 18px; font-weight: 700; color: var(--text-hero); margin: 24px 0 12px; }
    .cms-content p { margin-bottom: 16px; }
    .cms-content ul, .cms-content ol { background: var(--bg-body); padding: 16px 16px 16px 40px; border-radius: 12px; border: 1px solid var(--border-line); margin-bottom: 24px; }
    .cms-content li { margin-bottom: 8px; font-weight: 500; color: var(--text-hero); }
    .cms-content li::marker { color: var(--brand-primary); font-weight: 800; }
    
    .cms-content img { width: 100%; height: auto; border-radius: 12px; margin: 32px 0; border: 1px solid var(--border-line); box-shadow: var(--shadow-sm); }
    .cms-content a { color: var(--brand-primary); font-weight: 700; text-decoration: underline; text-decoration-color: rgba(37, 99, 235, 0.3); text-underline-offset: 3px; transition: all 0.2s; }
    .cms-content a:hover { color: var(--brand-dark); text-decoration-color: var(--brand-dark); }
    
    .table-wrapper { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 24px 0; border-radius: 12px; border: 1px solid var(--border-line); box-shadow: var(--shadow-sm); }
    .cms-content table { width: 100%; min-width: 500px; border-collapse: collapse; font-size: 14px; }
    .cms-content th { background: var(--bg-body); color: var(--text-hero); padding: 12px 16px; text-align: left; font-weight: 700; text-transform: uppercase; border-bottom: 1px solid var(--border-line); }
    .cms-content td { padding: 12px 16px; border-bottom: 1px solid var(--border-line); background: #ffffff; font-weight: 500; color: var(--text-body); }

    /* ==========================================
       EXPERT NOTE 
    ========================================== */
    .cms-content .expert-note { 
      margin: 32px 0; padding: 20px 24px; 
      background: #f4f9ff; border-radius: 12px; 
      border: 1px solid #cce4ff; 
      display: flex; flex-direction: row !important; gap: 16px; align-items: flex-start; 
    }
    .cms-content .expert-note svg { 
      color: var(--brand-primary); width: 24px !important; height: 24px !important; 
      min-width: 24px !important; flex: 0 0 24px !important; margin-top: 2px; display: block; 
    }
    .cms-content .expert-note div { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .cms-content .expert-note strong { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-primary); }
    .cms-content .expert-note p { margin: 0; font-size: 15px; font-weight: 500; color: var(--text-body); line-height: 1.6; }

    .cms-content blockquote { margin: 32px 0; padding: 16px 24px; background: #fff7ed; border-left: 4px solid var(--accent-orange); border-radius: 0 12px 12px 0; font-size: 16px; font-weight: 600; color: #9a3412; font-style: italic; }

    /* Footer & Share */
    .article-footer { border-top: 1px solid var(--border-line); padding-top: 24px; margin-top: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .tags-container { display: flex; gap: 8px; flex-wrap: wrap; }
    .tag { font-size: 12px; font-weight: 700; color: var(--text-hero); background: var(--bg-body); padding: 6px 14px; border-radius: 100px; border: 1px solid var(--border-line); }
    .share-buttons { display: flex; gap: 8px; align-items: center; font-size: 13px; font-weight: 800; color: var(--text-hero); text-transform: uppercase; }
    .share-btn { width: 36px; height: 36px; border-radius: 50%; background: var(--bg-body); display: flex; justify-content: center; align-items: center; color: var(--text-hero); border: 1px solid var(--border-line); cursor: pointer; transition: 0.2s ease; }
    .share-btn:hover { background: var(--brand-primary); color: #fff; border-color: var(--brand-primary); transform: translateY(-2px); }

    #copyToast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--text-hero); color: #fff; padding: 10px 20px; border-radius: 100px; font-size: 13px; font-weight: 700; opacity: 0; visibility: hidden; transition: all 0.3s ease; z-index: 9999; }
    #copyToast.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

    /* --- 4. RIGHT COLUMN WIDGETS --- */
    .sidebar-column { display: flex; flex-direction: column; gap: 20px; position: sticky; top: 120px; }

    .booking-widget { background: var(--bg-card); border-radius: 16px; border: 2px solid var(--brand-primary); box-shadow: var(--shadow-card); padding: 32px 24px; text-align: center; position: relative;}
    .booking-ribbon { position: absolute; top: -1px; left: 50%; transform: translateX(-50%); background: var(--accent-orange); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 14px; border-radius: 0 0 8px 8px; text-transform: uppercase; letter-spacing: 0.5px; }
    .booking-widget h3 { font-size: 20px; font-weight: 800; color: var(--text-hero); margin-bottom: 8px; margin-top: 4px; }
    .booking-widget p { font-size: 14px; color: var(--text-muted1); margin-bottom: 20px; line-height: 1.5; }
    
    .cab-features { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; text-align: left; background: var(--bg-body); padding: 16px; border-radius: 12px; border: 1px solid var(--border-line); }
    .cab-feature { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; color: var(--text-hero); }
    .cab-feature svg { color: var(--brand-primary); width: 16px; height: 16px; }

    .btn-action { display: flex; justify-content: center; align-items: center; gap: 8px; width: 100%; background: var(--accent-orange); color: #fff; padding: 14px; border-radius: 12px; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; border: none; cursor: pointer; transition: 0.2s ease; }
    .btn-action:hover { background: #c2410c; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(234, 88, 12, 0.2); }

    .toc-widget { padding: 24px; background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-line); box-shadow: var(--shadow-card); }
    .toc-widget h4 { font-size: 14px; font-weight: 800; color: var(--text-hero); margin-bottom: 16px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
    .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .toc-list li a { font-size: 14px; font-weight: 500; color: var(--text-muted1); display: flex; align-items: flex-start; gap: 8px; }
    .toc-list li a::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: #cbd5e1; margin-top: 8px; flex-shrink: 0; transition: background 0.2s ease;}
    .toc-list li a:hover { color: var(--brand-primary); }
    .toc-list li a:hover::before { background: var(--brand-primary); }

    /* ==========================================
       5. RELATED GUIDES 
    ========================================== */
    .related-section { max-width: 1140px; margin: 0 auto 100px; padding: 0 24px; border-top: 1px solid var(--border-line); padding-top: 60px; }
    .related-section h2 { font-size: 24px; font-weight: 800; color: var(--text-hero); text-align: center; margin-bottom: 32px; }
    .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
    .post-card { background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-line); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; position: relative; overflow: hidden; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .post-card:hover { transform: translateY(-6px); box-shadow: 0 12px 24px -4px rgba(37, 99, 235, 0.15); border-color: rgba(37, 99, 235, 0.2); }
    .card-badge { position: absolute; top: 12px; left: 12px; z-index: 10; background: var(--badge-ochre); color: #fff; font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 6px 14px; border-radius: 100px; letter-spacing: 0.5px; }
    .card-image { width: 100%; aspect-ratio: 16/10; background: #e2e8f0; overflow: hidden; }
    .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
    .post-card:hover .card-image img { transform: scale(1.05); }
    .card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 16px; font-weight: 800; color: var(--text-hero); line-height: 1.35; margin-bottom: 8px; transition: color 0.2s ease;}
    .post-card:hover .card-title { color: var(--brand-primary); }
    .card-excerpt { font-size: 13px; color: var(--text-body); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* ==========================================
       PREMIUM ANIMATION & REVEAL CLASSES
    ========================================== */
    .fade-up-initial { opacity: 0; transform: translateY(20px); animation: premiumFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .delay-1 { animation-delay: 0.15s; }
    .delay-2 { animation-delay: 0.3s; }
    
    @keyframes premiumFadeUp { to { opacity: 1; transform: translateY(0); } }

    /* Intersection Observer Classes */
    .reveal-on-scroll { opacity: 0; transform: translateY(30px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); will-change: opacity, transform; }
    .reveal-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
    
    /* Staggered grid items */
    .stagger-1 { transition-delay: 0.1s; }
    .stagger-2 { transition-delay: 0.2s; }
    .stagger-3 { transition-delay: 0.3s; }

    /* ==========================================
       6. FLAWLESS 440px MOBILE VIEW (STRICT)
    ========================================== */
    .mobile-booking-bar { display: none; }

    @media(max-width: 992px) {
      .dashboard-layout { grid-template-columns: 1fr; gap: 24px; margin-top: -30px; }
      .sidebar-column { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
      .booking-widget { margin-top: 0; }
    }

    @media(max-width: 768px) {
      .portal-hero { padding: 90px 16px 60px; min-height: auto; }
      .article-title { font-size: 24px; margin-bottom: 12px; line-height: 1.3; }
      
      .dashboard-layout { padding: 0 16px; margin-top: -24px; margin-bottom: 120px; gap: 16px; } 
      .sidebar-column { grid-template-columns: 1fr; }
      
      .author-block-wrapper { flex-direction: row; flex-wrap: nowrap; padding: 12px; gap: 12px; align-items: center; border-radius: 12px; margin-top: 0; box-shadow: var(--shadow-sm); }
      .author-profile { gap: 10px; width: auto; flex-grow: 1; min-width: 0; }
      .author-avatar-badge { width: 40px; height: 40px; font-size: 16px; margin: 0; }
      .author-info-center { gap: 0; min-width: 0; }
      .author-name { font-size: 14px; }
      .author-subtitle { font-size: 12px; }
      
      .author-fact-check { display: none; } 
      .fc-mobile-badge { display: flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 800; background: var(--brand-light); color: var(--brand-primary); padding: 6px 12px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.5px; flex-shrink: 0; }
      
      .ui-card { padding: 16px; border-radius: 12px; }
      
      .quick-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border-line); }
      .fact-item { padding: 12px 4px; border-radius: 8px; align-items: center; text-align: center; }
      .fact-label { font-size: 9px; justify-content: center; }
      .fact-label svg { width: 12px; height: 12px; }
      .fact-value { font-size: 13px; }
      
      .cms-content { font-size: 15px; line-height: 1.6; }
      .cms-content > p:first-of-type { font-size: 15px; margin-bottom: 20px; }
      .cms-content h2 { font-size: 20px; margin: 28px 0 12px; scroll-margin-top: 70px; }
      .cms-content h3 { font-size: 17px; margin: 20px 0 10px; }
      .cms-content ul, .cms-content ol { padding: 12px 12px 12px 32px; border-radius: 8px; margin-bottom: 20px; }
      .cms-content li { margin-bottom: 8px; font-size: 14.5px; }
      .cms-content img { border-radius: 8px; margin: 20px 0; }
      
      .cms-content .expert-note { flex-direction: row !important; padding: 16px; gap: 12px; border-radius: 8px; margin: 20px 0; } 
      .cms-content .expert-note svg { width: 20px !important; height: 20px !important; min-width: 20px !important; margin-top: 0;}
      .cms-content .expert-note strong { font-size: 13px; }
      .cms-content .expert-note p { font-size: 14px; }

      .cms-content blockquote { font-size: 15px; padding: 12px 16px; margin: 20px 0; }
      
      .table-wrapper { width: 100%; overflow-x: auto; margin: 20px 0; border-radius: 8px; }
      .cms-content table { min-width: 400px; font-size: 13px; }
      .cms-content th, .cms-content td { padding: 10px 12px; }

      .article-footer { flex-direction: column; align-items: flex-start; gap: 16px; padding-top: 16px; margin-top: 24px; }
      .tags-container { gap: 6px; }
      .tag { font-size: 11px; padding: 6px 12px; }
      
      .related-section { padding: 40px 16px 0; }
      .post-grid { grid-template-columns: 1fr; gap: 12px; }
      .post-card { flex-direction: row; align-items: center; padding: 8px; gap: 12px; border-radius: 12px; }
      .card-image { width: 80px; height: 80px; border-radius: 8px; flex-shrink: 0; }
      .card-image img { border-radius: 8px; }
      .card-badge { display: none; } 
      .card-body { padding: 0; }
      .card-title { font-size: 14px; margin-bottom: 4px; line-height: 1.3; }
      .card-excerpt { font-size: 12px; -webkit-line-clamp: 2; }
      
      .mobile-booking-bar {
        display: flex; justify-content: space-between; align-items: center;
        position: fixed; bottom: 0; left: 0; right: 0; width: 100%; z-index: 999;
        background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        padding: 12px 16px; border-top: 1px solid var(--border-line);
        box-sizing: border-box; box-shadow: 0 -4px 15px rgba(0,0,0,0.05);
      }
      .mbb-price { display: flex; flex-direction: column; min-width: 0; }
      .mbb-price span:first-child { font-size: 11px; color: var(--text-muted1); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;}
      .mbb-price span:last-child { font-size: 15px; font-weight: 800; color: var(--text-hero); }
      .mbb-btn { background: var(--accent-orange); color: #fff; padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 800; text-transform: uppercase; border: none; flex-shrink: 0;}
      .social-dock{display: none !important;}
    }

    /* --- FAQ Section Styles --- */
/* ==========================================
       FAQ SECTION (THEME MATCHED)
    ========================================== */
    .faq-section {
      margin: 16px 0 16px 0;
      padding-top: 10px;
      border-top: 1px solid var(--border-line); /* Blends perfectly with your layout */
    }

    .faq-section .section-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--accent-orange);
      margin-top: 0 !important;
      margin-bottom: 24px;
      padding-bottom: 0;
      border: none;
      text-align: center;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .faq-item {
      border: 1px solid var(--border-line);
      border-radius: 12px;
      background: var(--bg-card);
      overflow: hidden;
      transition: all 0.2s ease;
    }

    .faq-item:hover {
      border-color: rgba(37, 99, 235, 0.4); /* Subtle brand-primary */
      box-shadow: var(--shadow-sm);
    }

    .faq-question {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      background: transparent;
      border: none;
      cursor: pointer;
      font-size: 16px;
      font-weight: 700;
      color: var(--text-hero);
      text-align: left;
      transition: all 0.2s ease;
    }

    .faq-question:hover {
      color: var(--brand-primary);
      background-color: var(--brand-light);
    }

    .faq-icon {
      width: 20px;
      height: 20px;
      color: var(--brand-primary);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      flex-shrink: 0;
      margin-left: 16px;
    }

    /* The Animated Answer Section */
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      background-color: var(--bg-body); /* Slightly contrasting background */
    }

    .faq-answer-inner {
      padding: 0 20px 20px 20px;
      color: var(--text-body);
      line-height: 1.6;
      font-size: 15px;
      font-weight: 500;
    }

    .faq-answer-inner p {
      margin: 0;
    }

    /* Active States */
    .faq-item.active {
      border-color: var(--brand-primary);
    }

    .faq-item.active .faq-question {
      color: var(--brand-primary);
      background-color: var(--brand-light);
    }

    .faq-item.active .faq-icon {
      transform: rotate(180deg);
    }
  </style>
</head>

