<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head', { title: title }) %>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  
  <style>
    /* ==========================================================================
       GLOBAL PAGE BACKGROUND (Innovative Animated Aurora)
       ========================================================================== */
    body.insta-page {
      /* Dynamic shifting linear gradient */
      background: linear-gradient(-45deg, #022c22, #0f172a, #065f46, #021812);
      background-size: 400% 400%;
      animation: ambientGradient 15s ease infinite;
      margin: 0;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      position: relative;
      overflow-x: hidden;
      z-index: 0;
    }

    @keyframes ambientGradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Floating Abstract Glow Orbs */
    body.insta-page::before,
    body.insta-page::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      z-index: -1;
      animation: floatOrbs 20s infinite alternate ease-in-out;
    }
    
    body.insta-page::before {
      width: 40vw;
      height: 40vw;
      background: rgba(6, 95, 70, 0.4);
      top: -10%;
      left: -10%;
    }
    
    body.insta-page::after {
      width: 35vw;
      height: 35vw;
      background: rgba(56, 189, 248, 0.15); /* Soft blue hint */
      bottom: 20%;
      right: -10%;
      animation-delay: -5s;
    }

    @keyframes floatOrbs {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(50px, 50px) scale(1.1); }
    }

    /* ==========================================================================
       1. INDEPENDENT HERO SECTION
       ========================================================================== */
    .profile-hero-section {
      width: 100%;
      padding: 10px 15px 10px 15px; /* Top padding clears fixed navigation header */
    }

    .profile-grid {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 30px;
      max-width: 600px;
      margin: 0 auto;
      justify-content: space-around;
      position: relative;
      z-index: 2;
    }

    /* Avatar Column */
    .profile-avatar-col {
      flex-shrink: 0; 
    }

    .profile-ring {
      width: 75px; 
      height: 75px;
      border-radius: 50%;
      padding: 2px;
      background: linear-gradient(45deg, #fcaf45, #fd1d1d, #e1306c, #c13584, #833ab4, #405de6);
      box-shadow: 0 4px 10px rgba(225, 48, 108, 0.3);
    }

    .profile-ring img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 2px solid #022c22; 
      object-fit: cover;
      background-color: #ffffff;
    }

    /* Info Column */
    .profile-info-col {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .profile-name-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 2px;
    }

    .profile-name-row h1 {
      color: #ffffff;
      font-size: 1.15rem; 
      font-weight: 800;
      margin: 0;
      letter-spacing: -0.01em;
    }

    .verified-badge {
      color: #38bdf8;
      font-size: 0.85rem;
    }

    .profile-handle {
      color: #a7f3d0;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 12px;
    }

    /* Stats Row */
    .profile-stats {
      display: flex;
      gap: 15px; 
      margin-bottom: 12px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start; 
    }

    .stat-num {
      color: #ffffff;
      font-size: 0.95rem; 
      font-weight: 800;
    }

    .stat-label {
      color: #94a3b8;
      font-size: 0.6rem; 
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 2px;
    }

    /* Bio */
    .profile-bio {
      color: #cbd5e1;
      font-size: 0.8rem; 
      line-height: 1.4;
      margin-bottom: 15px;
    }

    /* Buttons */
    .action-buttons {
      display: flex;
      gap: 8px;
    }

    .btn-primary, .btn-secondary {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 10px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.75rem; 
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: linear-gradient(45deg, #405de6, #e1306c, #fd1d1d);
      color: #ffffff !important;
      border: 1px solid transparent;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      color: #ffffff !important;
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(5px);
    }

    /* Desktop Scaling for Hero */
    @media (min-width: 768px) {
      .profile-hero-section {
        padding: 20px 30px 20px 30px;
      }
      
      .profile-grid {
        max-width: 800px;
        gap: 50px; 
      }

      .profile-ring {
        width: 150px;
        height: 150px;
        padding: 4px;
      }

      .profile-ring img {
        border-width: 4px;
      }

      .profile-name-row h1 { font-size: 2.25rem; }
      .verified-badge { font-size: 1.25rem; }
      .profile-handle { font-size: 1rem; margin-bottom: 20px; }
      
      .profile-stats { gap: 40px; margin-bottom: 20px; }
      .stat-num { font-size: 1.25rem; }
      .stat-label { font-size: 0.75rem; }
      
      .profile-bio { font-size: 0.95rem; line-height: 1.6; margin-bottom: 25px; max-width: 500px; }
      
      .action-buttons { max-width: 350px; gap: 12px; }
      .btn-primary, .btn-secondary { padding: 10px 16px; font-size: 0.95rem; border-radius: 8px; }
    }

    /* ==========================================================================
       2. INTERACTIVE SCROLL DOWN INDICATOR
       ========================================================================== */
    .scroll-indicator-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 0 40px 0;
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
      position: relative;
      z-index: 2;
    }

    .scroll-indicator-wrapper span {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .mouse {
      width: 22px;
      height: 34px;
      border: 2px solid rgba(255, 255, 255, 0.7);
      border-radius: 12px;
      position: relative;
      margin-bottom: 6px;
    }

    .wheel {
      width: 4px;
      height: 6px;
      background: #38bdf8;
      border-radius: 2px;
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      animation: scrollWheel 2s infinite ease-in-out;
    }

    @keyframes scrollWheel {
      0% { top: 6px; opacity: 1; }
      100% { top: 16px; opacity: 0; }
    }

    .scroll-indicator-wrapper i {
      color: #38bdf8;
      font-size: 1rem;
      animation: bounceArrow 2s infinite ease-in-out;
    }

    @keyframes bounceArrow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    /* ==========================================================================
       3. INDEPENDENT FEED SECTION (Curator Default)
       ========================================================================== */
    .insta-feed-section {
      width: 100%;
      padding: 50px 15px 80px 15px; 
      position: relative;
      z-index: 2;
      scroll-behavior: smooth;
    }

    .feed-independent-wrapper {
      max-width: 1200px; 
      margin: 0 auto;
      background: #ffffff;
      border-radius: 16px;
      padding: 1.5rem;
      min-height: 400px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
    
    @media (min-width: 768px) {
      .feed-independent-wrapper {
        padding: 2.5rem;
      }
    }
  </style>
</head>
<body class="insta-page">
  
  <%- include('partials/header') %>

  <main>
    
    <!-- 1. INDEPENDENT HERO SECTION -->
    <section class="profile-hero-section">
      <div class="profile-grid">
        
        <!-- Avatar Column -->
        <div class="profile-avatar-col">
          <div class="profile-ring">
            <img src="/images/logo.PNG" alt="Radha Travels" onerror="this.src='https://ui-avatars.com/api/?name=Radha+Travels&background=059669&color=fff'">
          </div>
        </div>

        <!-- Info Column -->
        <div class="profile-info-col">
          <div class="profile-name-row">
            <h1>Radha Travels</h1>
            <i class="fa-solid fa-circle-check verified-badge"></i>
          </div>
          <p class="profile-handle">@radhatravelshyd</p>

          <div class="profile-stats">
            <div class="stat-item"><span class="stat-num">500+</span><span class="stat-label">Trips</span></div>
            <div class="stat-item"><span class="stat-num">12k</span><span class="stat-label">Followers</span></div>
            <div class="stat-item"><span class="stat-num">4.9★</span><span class="stat-label">Rating</span></div>
          </div>

          <p class="profile-bio">Experience the road less traveled. Premium fleet, seamless logistics, and unforgettable journeys across India.</p>
          
          <div class="action-buttons">
            <a href="https://instagram.com/radhatravelshyd" class="btn-primary" target="_blank">
              <i class="fa-brands fa-instagram"></i> Follow
            </a>
            <a href="/contact" class="btn-secondary">
              Contact Us
            </a>
          </div>
        </div>
        
      </div>
    </section>

    <!-- 2. INTERACTIVE SCROLL INDICATOR -->
    <a href="#insta-feed" class="scroll-indicator-wrapper">
      <span>Explore Feed</span>
      <div class="mouse">
        <div class="wheel"></div>
      </div>
      <i class="fa-solid fa-chevron-down"></i>
    </a>

    <!-- 3. INDEPENDENT FEED SECTION -->
    <section id="insta-feed" class="insta-feed-section">
      <div class="feed-independent-wrapper">
        <!-- Curator.io Widget -->
        <div id="curator-feed-default-feed-layout">
          <a href="https://curator.io" target="_blank" class="crt-logo crt-tag">Powered by Curator.io</a>
        </div>
      </div>
    </section>
    
  </main>

  <%- include('partials/footer') %>
  
  <script type="text/javascript">
    /* curator-feed-default-feed-layout */
    (function(){
    var i,e,d=document,s="script";i=d.createElement("script");i.async=1;i.charset="UTF-8";
    i.src="https://cdn.curator.io/published/43ec9e6a-1bf2-4b20-800d-5c91c2193f7e.js";
    e=d.getElementsByTagName(s)[0];e.parentNode.insertBefore(i, e);
    })();
  </script>

  <script src="/js/main.js" defer></script>
</body>
</html>