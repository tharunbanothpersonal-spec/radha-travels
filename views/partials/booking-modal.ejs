<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/css/booking.css"/>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js" defer></script>

<div id="rtd-bookingModal" class="rtd-modal" aria-hidden="true" role="dialog">
  <div class="rtd-backdrop" aria-hidden="true"></div>

  <div class="rtd-card-wrap" role="document" tabindex="-1">
    <div class="rtd-card" role="form">
      
      <button class="rtd-close" aria-label="Close" title="Close">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <header class="rtd-header-block">
        <div class="rtd-logo-crown"><img src="/images/taxi-book.png" alt="taxi"></div>
        <div class="rtd-header-content">
          <h1 id="rtdBrandName">RADHA TRAVELS</h1>
          <p>EXECUTIVE BOOKING FORM</p>
        </div>
      </header>

      <div id="rtdSuccess" class="rtd-success-overlay" aria-hidden="true">
        <div class="rtd-luxury-card">
          <div class="rtd-luxury-glow"></div>
          
          <div class="rtd-lottie-frame">
            <lottie-player id="rtdLottie" src="https://lottie.host/ba381501-0b4b-4570-8dc1-85cbcf2eac20/G2y0t8nq3z.json" background="transparent" speed="1.2" autoplay="false"></lottie-player>
          </div>
          
          <h2 class="rtd-luxury-title">BOOKING CONFIRMED</h2>
          <p class="rtd-luxury-text">Your executive chauffeur request has been securely processed. Our concierge will contact you shortly.</p>
          
          <div class="rtd-luxury-divider">
            <span class="rtd-diamond"></span>
          </div>
          
          <div class="rtd-luxury-ref">
            <span class="rtd-ref-label">RESERVATION REFERENCE</span>
            <div class="rtd-ref-id" id="rtdBookingId">RT-0000-0000</div>
            <button id="rtdCopyId" class="rtd-ref-copy">
              <i class="fa-regular fa-copy"></i> COPY ID
            </button>
          </div>
          
          <button id="rtdDone" class="rtd-luxury-btn rtd-close-success">CONTINUE</button>
        </div>
      </div>

      <main class="rtd-body">
        <form id="rtdForm" novalidate>
          
          <div class="rtd-form-grid">
            
            <div class="rtd-col">
              <div class="rtd-section-banner">
                <i class="fa-solid fa-user-tie"></i> Guest Information
              </div>
              
              <div class="rtd-field">
                <label for="rtdName">Full Name</label>
                <div class="rtd-input-wrap">
                  <i class="fa-regular fa-user"></i>
                  <input id="rtdName" name="name" type="text" required placeholder="John Doe">
                </div>
              </div>

              <div class="rtd-field">
                <label for="rtdPhone">Mobile Number</label>
                <div class="rtd-input-wrap">
                  <i class="fa-solid fa-phone"></i>
                  <input id="rtdPhone" name="phone" type="tel" required placeholder="+91 00000 00000">
                </div>
              </div>

              <div class="rtd-field">
                <label for="rtdEmail">Email Address <span class="rtd-opt">(Optional)</span></label>
                <div class="rtd-input-wrap">
                  <i class="fa-regular fa-envelope"></i>
                  <input id="rtdEmail" name="email" type="email" placeholder="For digital receipt">
                </div>
              </div>
            </div>

            <div class="rtd-col">
              <div class="rtd-section-banner rtd-mobile-mt">
                <i class="fa-solid fa-map-location-dot"></i> Trip Details
              </div>

              <div class="rtd-row-split">
                <div class="rtd-field">
                  <label for="rtdType">Service</label>
                  <div class="rtd-input-wrap">
                    <select id="rtdType" name="type" required>
                      <option value="" disabled selected>Select...</option>
                      <option value="local">Local</option>
                      <option value="outstation">Outstation</option>
                      <option value="airport">Airport</option>
                      <option value="corporate">Corporate</option>
                    </select>
                    <i class="fa-solid fa-chevron-down rtd-arrow"></i>
                  </div>
                </div>

                <div class="rtd-field">
                  <label for="rtdCar">Vehicle</label>
                  <div class="rtd-input-wrap">
                    <select id="rtdCar" name="car" required>
                      <option value="" disabled selected>Select...</option>
                      <option>Sedan</option>
                      <option>Prime Sedan</option>
                      <option>SUV (Innova)</option>
                      <option>Premium SUV</option>
                    </select>
                    <i class="fa-solid fa-chevron-down rtd-arrow"></i>
                  </div>
                </div>
              </div>

              <div id="rtdNumDaysWrap" class="rtd-field" style="display:none;">
                <label for="rtdNumDays">Duration (Days)</label>
                <div class="rtd-input-wrap">
                  <i class="fa-regular fa-calendar-check"></i>
                  <input id="rtdNumDays" name="numDays" type="number" min="1" placeholder="e.g. 3">
                </div>
              </div>

              <div class="rtd-row-split">
                <div class="rtd-field">
                  <label for="rtdDate">Date</label>
                  <div class="rtd-input-wrap">
                    <i class="fa-regular fa-calendar"></i>
                    <input id="rtdDate" name="date" type="date">
                  </div>
                </div>
                <div class="rtd-field">
                  <label for="rtdTime">Time</label>
                  <div class="rtd-input-wrap">
                    <i class="fa-regular fa-clock"></i>
                    <input id="rtdTime" name="time" type="time">
                  </div>
                </div>
              </div>

              <div class="rtd-field">
                <label for="rtdPickup">Pickup Location</label>
                <div class="rtd-input-wrap">
                  <i class="fa-solid fa-location-dot"></i>
                  <input id="rtdPickup" name="pickup" type="text" placeholder="Address or Landmark">
                </div>
              </div>

              <div class="rtd-field rtd-textarea-field">
                <label for="rtdNotes">Notes <span class="rtd-opt">(Optional)</span></label>
                <div class="rtd-input-wrap">
                  <textarea id="rtdNotes" name="notes" placeholder="Special requirements..."></textarea>
                </div>
              </div>
            </div>
          </div> 
          <div class="rtd-footer">
            <div class="rtd-trust-badges">
              <div class="rtd-secure">
                <i class="fa-solid fa-lock"></i> 256-Bit SSL Secured
              </div>
              <div class="rtd-disclaimer">
                <i class="fa-regular fa-credit-card"></i> No payment required until confirmation
              </div>
            </div>
            
            <button type="submit" class="rtd-btn rtd-btn-submit" id="rtdSubmitBtn">
              <span class="btn-text">Request Booking <i class="fa-solid fa-arrow-right"></i></span>
              <i class="fa-solid fa-circle-notch fa-spin btn-spinner" style="display: none;"></i>
            </button>
          </div>

        </form>
      </main>
    </div>
  </div>
</div>
<script src="/js/booking.js" defer></script>