<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <%- include('./partials/head', { title: 'Premium Journey: Hyderabad to ' + tour.name + ' | Radha Travels' }) %>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================
       RADHA TRAVELS: ULTIMATE EDITORIAL THEME
    ========================================== */
    :root {
      --brand-emerald: #059669;
      --brand-emerald-dark: #047857;
      --text-main: #0f172a;      
      --text-body: #475569;      
      --text-light: #64748b;     
      --bg-page: #f8fafc;        
      --bg-card: #ffffff;
      --border-light: #e2e8f0;
      --shadow-elegant: 0 10px 40px -10px rgba(15, 23, 42, 0.08);
    }

    body {
      background-color: var(--bg-page); color: var(--text-body);
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0; line-height: 1.8; font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 { color: var(--text-main); margin: 0; }
    ul { padding: 0; margin: 0; list-style: none; }
    a { text-decoration: none; color: inherit; }

    /* --- HERO SECTION --- */
    .editorial-hero {
      position: relative; width: 100%; height: 75vh; min-height: 550px;
      background-color: #0f172a; display: flex; flex-direction: column; justify-content: center; align-items: center;
      padding-bottom: 60px; 
      overflow: hidden; /* Added for clean image animation */
    }
    .hero-img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: 1;
    }
    .hero-gradient {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.50) 0%, rgba(15, 23, 42, 0.85) 100%);
    }
    .nav-back {
      position: absolute; top: 30px; left: 30px; z-index: 20;
      display: inline-flex; align-items: center; gap: 8px; color: #fff; font-weight: 600; font-size: 14px;
      background: rgba(255, 255, 255, 0.1); padding: 10px 20px; border-radius: 100px;
      backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s;
    }
    .nav-back:hover { background: rgba(255, 255, 255, 0.25); transform: translateX(-4px); }
    
    .hero-content {
      position: relative; z-index: 10; max-width: 900px; width: 100%; padding: 0 24px; text-align: center;
    }
    
    .hero-rating-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(8px);
      color: #fff; padding: 6px 16px; border-radius: 100px; font-size: 13px; font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.15); margin-bottom: 24px;
    }

    .hero-title {
      color: #fff; font-size: clamp(36px, 6vw, 64px); font-weight: 800;
      letter-spacing: -1px; line-height: 1.1; margin: 0 0 16px 0; text-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .hero-desc {
      color: #f1f5f9; font-size: clamp(16px, 2vw, 18px); font-weight: 400; line-height: 1.6;
      max-width: 650px; margin: 0 auto 32px auto; text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-hero {
      display: inline-flex; align-items: center; justify-content: center; 
      padding: 5px 10px; border-radius: 100px; font-weight: 700; font-size: 13px; transition: all 0.3s ease; box-sizing: border-box; text-decoration: none;
    }
    .btn-primary { background: var(--brand-emerald); color: white; border: 2px solid var(--brand-emerald); box-shadow: 0 10px 25px rgba(5, 150, 105, 0.3); }
    .btn-primary:hover { background: var(--brand-emerald-dark); border-color: var(--brand-emerald-dark); transform: translateY(-2px); }
    .btn-secondary { background: rgba(255,255,255,0.1); color: white; border: 2px solid rgba(255,255,255,0.4); backdrop-filter: blur(8px); }
    .btn-secondary span {
  display: inline-block; /* Required for transform animations to work on spans */
  animation: exploreBtn 1.5s ease-in-out infinite;
}
    .btn-secondary:hover { background: white; color: var(--text-main); transform: translateY(-2px); }

    .inline-trust-strip {
      display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 40px;
    }
    .inline-trust-item {
      display: flex; align-items: center; gap: 8px; color: #e2e8f0; font-size: 14px; font-weight: 600; text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }
    .inline-trust-item svg { color: #34d399; } 

    @media (max-width: 768px) {
      .editorial-hero { height: auto; padding-top: 100px; padding-bottom: 80px; }
      .nav-back { top: 20px; left: 20px; font-size: 12px; padding: 8px 16px; }
      .hero-actions { flex-direction: row; width: 100%; flex-wrap: nowrap; }
      .inline-trust-strip { flex-direction: row; gap: 12px; align-items: center; margin-top: 15px; }
      .inline-trust-item { font-size: 13px; font-weight: 600; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    }

    /* --- OVERLAPPING STATS BAR --- */
    .stats-wrapper { max-width: 1000px; margin: -57px auto 18px; padding: 0 24px; position: relative; z-index: 20; }
    .stats-bar {
      background: var(--bg-card); border-radius: 20px; padding: 24px 40px;
      display: flex; justify-content: space-between; align-items: center;
      box-shadow: var(--shadow-elegant); border: 1px solid var(--border-light);
    }
    .stat-item { display: flex; align-items: center; gap: 16px; }
    .stat-icon { width: 48px; height: 48px; background: #ecfdf5; color: var(--brand-emerald); border-radius: 12px; display: flex; align-items: center; justify-content: center; }
    .stat-data { display: flex; flex-direction: column; }
    .stat-label { font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
    .stat-value { font-size: 16px; color: var(--text-main); font-weight: 800; }
    
    @media (max-width: 768px) {
      .stats-bar { flex-direction: row; align-items: flex-start; padding: 24px; gap: 10px; border-radius: 16px; }
      .stat-item { width: 100%; gap: 8px; }
      .stat-icon { width: 30px; height: 30px; background: #ecfdf5; color: var(--brand-emerald); border-radius: 12px; display: flex; align-items: center; justify-content: center; }
      .stat-data { display: flex; flex-direction: column; }
      .stat-label { font-size: 9px; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
      .stat-value { font-size: 11px; color: var(--text-main); font-weight: 800; }
    }

    /* --- MAIN CONTENT CONTAINER --- */
    .editorial-container { max-width: 1200px; margin: 0 auto 100px; padding: 0 24px; }

    /* --- DISCOVER DESTINATION --- */
    .luxury-card {
      background: var(--bg-card); border-radius: 24px; padding: 48px;
      box-shadow: var(--shadow-elegant); border: 1px solid var(--border-light); margin-bottom: 40px;
    }
    .card-title { font-size: 28px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 32px; display: flex; align-items: center; gap: 12px; justify-content: center; }
    
    @media (max-width: 768px) { .luxury-card { padding: 24px; border-radius: 16px; margin-bottom: 20px; } 
    .card-title { font-size: 20px; } }

    .destination-layout { display: grid; grid-template-columns: 1fr; gap: 40px; }
    @media(min-width: 992px) { .destination-layout { grid-template-columns: 1.1fr 0.9fr; align-items: start; } }

    /* Left Side: Rich Text */
    .dest-text-content h3 { color: var(--brand-emerald); font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 12px; font-weight: 800;}
    .dest-lead { font-size: 16px; color: var(--text-body); margin-bottom: 24px; }
    
    .temple-deep-dive { margin-bottom: 24px; border-left: 3px solid var(--brand-emerald); padding-left: 20px; }
    .temple-deep-dive h4 { margin: 0 0 8px 0; color: var(--text-main); font-size: 16px; font-weight: 700; }
    .temple-deep-dive p { margin: 0 0 16px 0; font-size: 15px; color: var(--text-body); }
    .temple-deep-dive p:last-child { margin-bottom: 0; }
    @media (max-width: 768px){
      .dest-lead { font-size: 12px; color: var(--text-body); margin-bottom: 24px; }
      .temple-deep-dive h4 {font-size: 14px; }
      .temple-deep-dive p {font-size: 12px; }
    }

    .info-badge-container { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; justify-content: center;}
    .info-badge { background: var(--bg-page); padding: 16px 20px; border-radius: 12px; border: 1px solid var(--border-light); flex: 1; min-width: 140px; }
    .info-badge span { display: block; font-size: 11px; color: var(--text-light); text-transform: uppercase; font-weight: 700; margin-bottom: 4px; }
    .info-badge strong { color: var(--text-main); font-size: 15px; font-weight: 700;}
    @media (max-width: 768px){
      .info-badge { line-height: 1; text-align: center; padding: 16px 8px;}
      .info-badge span { display: block; font-size: 10px; color: var(--text-light); text-transform: uppercase; font-weight: 700; margin-bottom: 4px; }
      .info-badge strong { color: var(--text-main); font-size: 12px; font-weight: 700;}
    }
    .btn-outline-link {
      display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700;
      color: var(--brand-emerald); text-decoration: none; transition: 0.2s; padding: 10px 0;
    }
    .btn-outline-link:hover { color: var(--brand-emerald-dark); text-decoration: underline; }

    .dest-image-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .img-main { grid-column: span 2; width: 100%; height: 280px; border-radius: 16px; background-color: #e2e8f0; background-size: cover; background-position: center; }
    .img-sub { width: 100%; height: 180px; border-radius: 16px; background-color: #e2e8f0; background-size: cover; background-position: center; }
    @media (max-width: 768px) { .img-main { height: 200px; } .img-sub { height: 140px; } }

    .nearby-places-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 24px; }
    .nearby-card { display: flex; gap: 16px; align-items: center; padding: 16px; background: var(--bg-page); border-radius: 16px; border: 1px solid var(--border-light); transition: all 0.3s ease; }
    .nearby-card:hover { border-color: var(--brand-emerald); transform: translateY(-2px); box-shadow: var(--shadow-elegant); }
    .nearby-img { width: 64px; height: 64px; border-radius: 12px; background-color: #cbd5e1; background-size: cover; background-position: center; flex-shrink: 0; }
    .nearby-info h4 { margin: 0 0 4px 0; color: var(--text-main); font-size: 15px; font-weight: 700; line-height: 1.2;}
    .nearby-info p { margin: 0; color: var(--text-light); font-size: 13px; line-height: 1.4; }

    /* --- LOGISTICS GRID --- */
    .logistics-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
    @media(min-width: 992px) { .logistics-grid { grid-template-columns: 1.2fr 1fr; align-items: start; } }
    
    .sticky-column { position: static; }
    @media(min-width: 992px) { .sticky-column { position: sticky; top: 40px; } }

    .route-info-box { background: var(--bg-page); padding: 32px; border-radius: 20px; border: 1px solid var(--border-light); margin-bottom: 32px; }
    .route-info-box h4 { font-size: 20px; color: var(--text-main); margin: 0 0 12px 0; font-weight: 800; display: flex; align-items: center; gap: 8px;}
    
    @media(max-width: 768px){
      .route-info-box h4 { font-size: 15px;}
      .route-info-box p{font-size: 12px !important;}
      .route-info-box ul{font-size: 12px !important;}
    }
    
    .trust-text { margin-bottom: 24px; }
    .trust-text h3 { font-size: 16px; color: var(--text-main); font-weight: 700; margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px; }
    .trust-text h3 svg { color: var(--brand-emerald); }
    .trust-text p { margin: 0; font-size: 15px; color: var(--text-body); }

    .pricing-split { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
    @media(min-width: 768px) { .pricing-split { grid-template-columns: 1fr 1fr; } }
    .price-box { padding: 24px; border-radius: 16px; }
    .price-box.included { background: #ecfdf5; border: 1px solid #d1fae5; }
    .price-box.excluded { background: #fff1f2; border: 1px solid #ffe4e6; }
    .price-box h4 { margin: 0 0 16px 0; font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .elegant-list li { position: relative; padding-left: 24px; margin-bottom: 12px; font-size: 14px; font-weight: 500;}
    .elegant-list li::before { content: '✓'; position: absolute; left: 0; top: -1px; color: var(--brand-emerald); font-size: 16px; font-weight: bold; }
    .price-box.excluded .elegant-list li::before { content: '✕'; color: #e11d48; }

    .fleet-pill {
      display: flex; align-items: center; padding: 16px 20px; border-radius: 16px;
      border: 1px solid var(--border-light); margin-bottom: 12px; transition: all 0.3s ease; background: var(--bg-card);
    }
    .fleet-pill:hover { border-color: var(--brand-emerald); box-shadow: var(--shadow-elegant); transform: translateY(-2px); }
    .fleet-pill-icon { font-size: 32px; margin-right: 16px; }
    .fleet-name { display: block; font-weight: 700; color: var(--text-main); font-size: 16px; }
    .fleet-desc { display: block; font-size: 13px; color: var(--text-light); }

    /* --- CTA & FAQ --- */
    .cta-title{color: white;}
    .premium-cta-wrapper {
      margin-top: 40px; background: var(--text-main); border-radius: 32px; padding: 80px 40px; text-align: center; color: white;
    }
    @media (max-width: 768px) { .premium-cta-wrapper { padding: 40px 24px; border-radius: 20px; } }
    
    .faq-container { margin-top: 40px; max-width: 800px; margin-left: auto; margin-right: auto; }
    .faq-item { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 16px; margin-bottom: 16px; transition: all 0.3s ease; }
    .faq-question { width: 100%; text-align: left; background: transparent; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 16px; font-weight: 700; color: var(--text-main); padding: 20px 24px; }
    .faq-icon { font-size: 24px; color: var(--brand-emerald); transition: transform 0.3s ease; line-height: 1; }
    .faq-item.active { border-color: var(--brand-emerald); }
    .faq-item.active .faq-icon { transform: rotate(45deg); }
    .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .faq-answer p { padding: 0 24px 24px 24px; margin: 0; color: var(--text-body); font-size: 15px; }

    /* PROMISE TITLE */
    .rt-promise { font-size: 24px; margin-bottom: 24px; }
    /* PRICING */
    .pricing-title { font-size: 24px; margin-bottom: 16px; }
    .pricing-desc { font-size: 14px; margin: 0 0 20px 0; }
    .included-title { color: var(--brand-emerald); }
    .excluded-title { color: #e11d48; }
    /* FLEET */
    .fleet-title { font-size: 24px; margin-bottom: 24px; }
    /* AMENITIES */
    .amenities-box { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-light); }
    .amenities-label { font-size: 11px; font-weight: 800; color: var(--text-light); margin: 0 0 12px 0; text-transform: uppercase; }
    .amenities-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .amenity { background: var(--bg-page); padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; border: 1px solid var(--border-light); }
    /* CTA */
    .cta-title { font-size: clamp(28px, 4vw, 40px); margin: 0 0 16px 0; font-weight: 800; }
    .cta-desc { font-size: 16px; color: #cbd5e1; max-width: 600px; margin: 0 auto; }
    .cta-btn { margin-top: 24px; padding: 15px 24px; font-size: 25px; }

    @media(max-width: 768px){
      .rt-promise{font-size: 20px;}
      .trust-text{margin-bottom: 10px;}
      .trust-text h3{font-size: 14px;}
      .trust-text p{font-size: 12px;}
      .pricing-title{font-size: 20px;}
      .pricing-desc{font-size: 12px;}
      .pricing-split{grid-template-columns: 1fr 1fr;}
      .price-box{padding: 15px 10px;}
      .elegant-list li{font-size: 12px;}
      .logistics-grid{gap: 0;}
      .fleet-pill{padding: 10px 5px; flex-direction: row; flex-wrap: wrap;}
      .fleet-title{font-size: 20px;}
      .fleet-pill-icon{font-size: 30px;}
      .fleet-name{font-size: 12px;}
      .fleet-desc{font-size: 10px;}
      .cta-title { font-size: clamp(25px, 4vw, 40px); }
      .cta-desc{ font-size: 13px; }
      .faq-container h2{font-size: 25px !important;}
      .cta-btn{ font-size: 15px;}
    }

    /* ==========================================
       NEW: ANIMATIONS & SCROLL REVEALS
       (Added safely without breaking layouts)
    ========================================== */
    /* --- EXPLORE BUTTON ANIMATION --- */
@keyframes exploreBtn {
  0%, 100% { transform: translateY(-2px); }
  50% { transform: translateY(6px); } /* Bounces down 4 pixels */
}
    /* Hero Load Animations */
    @keyframes heroFadeUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroFadeIn {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }
    @keyframes imageZoomReveal {
      0% { transform: scale(1.08); filter: brightness(0.6); }
      100% { transform: scale(1); filter: brightness(1); }
    }

    .hero-img { animation: imageZoomReveal 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .nav-back { opacity: 0; animation: heroFadeIn 1s ease-out 0.5s forwards; }
    
    .animate-up { opacity: 0; animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
    .delay-300 { animation-delay: 0.3s; }
    .delay-400 { animation-delay: 0.4s; }

    /* Scroll Reveal Classes */
    .reveal { opacity: 0; transform: translateY(40px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.active { opacity: 1; transform: translateY(0); }
    
    .reveal-left { opacity: 0; transform: translateX(-40px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal-left.active { opacity: 1; transform: translateX(0); }
    
    .reveal-right { opacity: 0; transform: translateX(40px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal-right.active { opacity: 1; transform: translateX(0); }

    /* ==========================================
       STYLISH ANIMATED UNDERLINES
    ========================================== */
    
    /* 1. Main Card Titles & FAQ Heading */
    .card-title, .faq-container h2 {
      position: relative;
      padding-bottom: 16px;
    }
    
    .card-title::after, .faq-container h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0; /* Starts at 0 for the reveal animation */
      height: 4px;
      background: var(--brand-emerald);
      border-radius: 10px;
    }

    /* 2. Left-align the titles in the Logistics and Fleet columns */
    .logistics-left .card-title, .sticky-column .card-title {
      justify-content: flex-start;
    }
    .logistics-left .card-title::after, .sticky-column .card-title::after {
      left: 0;
      transform: none;
    }

    /* 3. The "Spiritual Heritage" Sub-heading */
    .dest-text-content h3 {
      position: relative;
      display: inline-block;
      padding-bottom: 8px;
      margin-bottom: 16px !important;
    }
    
    .dest-text-content h3::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0; /* Starts at 0 for the reveal animation */
      height: 3px;
      background: var(--brand-emerald);
      border-radius: 10px;
      opacity: 0.6;
    }

    /* 4. The "Draw Line" Animations */
    @keyframes drawLine {
      to { width: 100px; }
    }
    @keyframes drawLineSmall {
      to { width: 30px; }
    }

    /* 5. Trigger animations only when the card scrolls into view (.active) */
    .active .card-title::after,
    .active.faq-container h2::after {
      animation: drawLine 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    
    .active .dest-text-content h3::after {
      animation: drawLineSmall 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    }
   /* ==========================================
       EYE-CATCHING OFFICIAL LINK PRO
    ========================================== */
    .rt-official-link-pro {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 16px 24px;
      margin-top: 16px;
      background: var(--text-main); /* High contrast dark background */
      border-radius: 16px;
      text-decoration: none;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.2);
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Vibrant Emerald Accent Line */
    .rt-official-link-pro::before {
      content: ''; position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: var(--brand-emerald);
    }

    .rt-official-link-pro .link-left {
      display: flex; align-items: center; gap: 16px; z-index: 2;
    }

    /* Glowing Pulse Animation */
    .rt-official-link-pro .icon-box {
      display: flex; align-items: center; justify-content: center;
      width: 42px; height: 42px;
      background: rgba(5, 150, 105, 0.2); color: #34d399;
      border-radius: 10px;
      animation: linkPulse 2s infinite;
    }

    @keyframes linkPulse {
      0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6); }
      70% { box-shadow: 0 0 0 12px rgba(5, 150, 105, 0); }
      100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
    }

    .rt-official-link-pro .link-text { display: flex; flex-direction: column; }
    
    .rt-official-link-pro .link-text span:first-child {
      font-size: 11px; color: #94a3b8; text-transform: uppercase;
      letter-spacing: 1px; margin-bottom: 2px; font-weight: 800;
    }
    
    .rt-official-link-pro .link-text span:last-child {
      font-size: 15px; color: #ffffff; font-weight: 700;
    }

    .rt-official-link-pro .link-arrow {
      color: #34d399; transition: transform 0.3s ease; z-index: 2;
    }

    .rt-official-link-pro:hover {
      transform: translateY(-4px); background: #1e293b;
      box-shadow: 0 15px 30px -5px rgba(5, 150, 105, 0.3);
    }

    .rt-official-link-pro:hover .link-arrow { transform: translate(4px, -4px) scale(1.1); }
    
    @media (max-width: 768px) {
      .rt-official-link-pro { width: 100%; gap: 16px; padding: 14px 20px; }
      .rt-official-link-pro .link-text span:last-child { font-size: 14px; }
    }

  </style>
</head>
<body>

<%- include('./partials/header') %>
<%- include('./partials/ticker') %>

<section class="editorial-hero">
  <img src="<%= tour.heroImage || 'https://images.unsplash.com/photo-1600080838615-3850550fc1cb?auto=format&fit=crop&q=80' %>" alt="<%= tour.name %>" class="hero-img">
  <div class="hero-gradient"></div>
  
  <a href="/services" class="nav-back">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
    All Tours
