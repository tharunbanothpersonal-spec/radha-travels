<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('./partials/head', { title: 'Hyderabad to ' + tour.name + ' | Radha Travels' }) %>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    /* ==========================================
       EMERALD CYBER THEME: DETAILS PAGE
       Mobile-First (440px)
    ========================================== */
    body {
      background-color: #010a07; /* Deep cyber-black */
      color: #fff;
      margin: 0;
      font-family: Arial, sans-serif;
    }

    /* --- Cinematic Hero Section --- */
    .rt-dossier-hero {
      position: relative;
      width: 100%;
      height: 60vh; /* Takes up 60% of the screen height */
      min-height: 400px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end; /* Pushes text to the bottom */
      padding: 20px 15px;
      overflow: hidden;
    }

    .rt-hero-bg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      filter: brightness(0.8) contrast(1.1);
      z-index: 1;
    }

    /* Seamless fade from image into the dark page background */
    .rt-hero-fade {
      position: absolute; inset: 0; z-index: 2;
      background: linear-gradient(180deg, rgba(1, 10, 7, 0.2) 0%, rgba(1, 10, 7, 0.8) 70%, #010a07 100%);
    }

    .rt-hero-scanline {
      position: absolute; inset: 0; z-index: 3;
      background: linear-gradient(to bottom, transparent 50%, rgba(16, 185, 129, 0.05) 51%);
      background-size: 100% 4px;
      pointer-events: none;
    }

    /* Floating Back Button */
    .rt-hud-back-btn {
      position: absolute; top: 100px; left: 15px; z-index: 10; /* Top left placement */
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(2, 44, 34, 0.6);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #10b981; font-family: monospace; font-size: 11px;
      text-decoration: none; padding: 8px 16px; border-radius: 4px;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      transition: all 0.3s ease;
      letter-spacing: 1px;
    }
    
    .rt-hud-back-btn:hover {
      background: rgba(16, 185, 129, 0.2);
      color: #fff; border-color: #10b981;
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    }

    /* Hero Text Content */
    .rt-hero-content {
      position: relative; z-index: 10;
      max-width: 800px; margin: 0 auto; width: 100%;
      padding-bottom: 20px;
    }

    .rt-hero-tag {
      display: inline-flex; align-items: center; gap: 6px;
      background: #022c22; border-left: 2px solid #10b981;
      color: #10b981; font-family: monospace; font-size: 10px;
      padding: 4px 10px; margin-bottom: 12px; letter-spacing: 2px;
    }

    .rt-hero-tag::before {
      content: ''; display: block; width: 6px; height: 6px;
      background: #10b981; border-radius: 50%;
      box-shadow: 0 0 8px #10b981; animation: pulse 1.5s infinite;
    }

    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.3); } }

    .rt-hero-content h1 {
      font-size: 36px; font-weight: 300; margin: 0 0 10px 0; color: #fff;
      text-shadow: 0 4px 20px rgba(0,0,0,0.9);
    }

    .rt-hero-content p {
      font-size: 14px; color: #a7f3d0; line-height: 1.6; margin: 0;
      text-shadow: 0 2px 10px rgba(0,0,0,0.9);
    }

    /* --- Glassmorphic Content Section --- */
/* ==========================================
       BENTO GRID DETAILS SECTION (Mobile First)
    ========================================== */
    .rt-dossier-body {
      position: relative; z-index: 10;
      padding: 0 15px 80px;
      max-width: 900px; margin: 0 auto;
      margin-top: -40px; /* Pulls grid up to overlap the hero image perfectly */
    }

    .rt-bento-grid {
      display: grid;
      grid-template-columns: 1fr; /* 1 column on mobile */
      gap: 20px;
    }

    /* Individual Glass Cards */
    .rt-bento-card {
      background: rgba(2, 44, 34, 0.45);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(16, 185, 129, 0.15);
      border-top: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 16px;
      padding: 30px 25px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.5);
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    
    .rt-bento-card:hover {
      border-color: rgba(16, 185, 129, 0.4);
      transform: translateY(-2px);
    }

    /* Typography inside Cards */
    .rt-card-label {
      color: #ffffff; font-family: monospace; font-size: 11px;
      letter-spacing: 2px; text-transform: uppercase;
      margin-bottom: 20px; display: inline-block;
      background: rgba(16, 185, 129, 0.1); padding: 4px 10px; border-radius: 4px;
    }

    .rt-bento-title { color: #fff; font-size: 22px; margin: 0 0 15px 0; font-weight: 300; }
    .rt-bento-subtitle { color: #fff; font-size: 16px; margin: 0 0 15px 0; font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px;}
    .rt-bento-text { color: #d1fae5; font-size: 15px; line-height: 1.7; margin: 0; }
    .rt-muted-text { color: #6ee7b7; font-size: 13px; line-height: 1.6; margin: 0; opacity: 0.8; }

    /* Custom Elements */
    .rt-route-path-box {
      background: rgba(0,0,0,0.3); border-radius: 12px;
      padding: 20px; margin-top: 25px; border-left: 3px solid #10b981;
    }

    .rt-glowing-list { list-style: none; padding: 0; margin: 0 0 15px 0; }
    .rt-glowing-list li {
      color: #fff; font-size: 15px; margin-bottom: 12px;
      display: flex; align-items: flex-start; gap: 10px;
    }
    .rt-glowing-list li::before {
      content: ''; display: block; width: 8px; height: 8px; margin-top: 6px;
      background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981; flex-shrink: 0;
    }

    /* Pill Tags for 'Ideal For' */
    .rt-tags-container { display: flex; flex-wrap: wrap; gap: 10px; }
    .rt-cyber-pill {
      background: transparent; border: 1px solid rgba(16, 185, 129, 0.4);
      color: #a7f3d0; font-size: 13px; padding: 8px 16px; border-radius: 20px;
      transition: all 0.3s;
    }
    .rt-cyber-pill:hover { background: rgba(16, 185, 129, 0.15); color: #fff; border-color: #10b981; }

    /* Fleet Stack */
    .rt-fleet-stack { display: flex; flex-direction: column; gap: 10px; }
    .rt-fleet-row {
      display: flex; justify-content: space-between; align-items: center;
      background: rgba(0,0,0,0.3); padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);
    }
    .rt-fleet-row strong { color: #10b981; font-family: monospace; font-size: 14px; letter-spacing: 1px; }
    .rt-fleet-row span { color: #a7f3d0; font-size: 13px; }

    /* Amenities Grid & Advantages */
    .rt-check-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; list-style: none; padding: 0; margin: 0; }
    .rt-check-grid li, .rt-advantage-list li {
      display: flex; align-items: flex-start; gap: 10px;
      color: #d1fae5; font-size: 14px;
    }
    .rt-check-grid li::before, .rt-advantage-list li::before {
      content: '✓'; color: #10b981; font-weight: bold;
    }
    .rt-advantage-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    
    .rt-cyber-divider { height: 1px; background: rgba(16, 185, 129, 0.2); margin: 30px 0; }

    /* Action Button */
    .rt-booking-wrapper { margin-top: 40px; text-align: center; }
    .rt-initiate-btn {
      position: relative; display: inline-block; overflow: hidden;
      background: rgba(16, 185, 129, 0.1); border: 1px solid #10b981;
      color: #10b981; font-family: monospace; font-size: 16px; font-weight: bold;
      padding: 18px 40px; text-decoration: none; border-radius: 8px;
      letter-spacing: 2px; transition: all 0.3s; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .rt-btn-glow {
      position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(16,185,129,0.4), transparent);
      transform: skewX(-20deg); animation: cyberSweep 3s infinite;
    }
    .rt-initiate-btn:hover { background: #10b981; color: #000; box-shadow: 0 0 25px rgba(16, 185, 129, 0.6); }

    /* ==========================================
       DESKTOP SCALING (768px+)
    ========================================== */
    @media(min-width: 768px) {
      .rt-bento-grid { grid-template-columns: repeat(2, 1fr); }
      .rt-span-full { grid-column: span 2; }
      .rt-bento-card { padding: 40px; }
      .rt-split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
      .rt-dossier-hero { padding: 40px; height: 50vh; }
    }
    /* ==========================================
   CYBER ACCORDION FAQ
========================================== */

.tour-faq {
  max-width: 900px;
  margin: 60px auto 80px;
  padding: 0 15px;
}

.tour-faq h2 {
  text-align: center;
  margin-bottom: 30px;
  font-weight: 300;
  letter-spacing: 1px;
}

.faq-item {
  background: rgba(2, 44, 34, 0.45);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(16,185,129,0.2);
  border-radius: 12px;
  margin-bottom: 16px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.faq-item.active {
  border-color: rgba(16,185,129,0.6);
  box-shadow: 0 0 20px rgba(16,185,129,0.2);
}

.faq-question {
  width: 100%;
  background: transparent;
  border: none;
  color: #ffffff;
  text-align: left;
  padding: 18px 20px;
  font-size: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-weight: 600;
}

.faq-question:hover {
  color: #10b981;
}

.faq-icon {
  font-size: 20px;
  color: #10b981;
  transition: transform 0.3s ease;
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
  background: rgba(0,0,0,0.3);
}

.faq-answer p {
  padding: 0 20px 20px;
  margin: 0;
  font-size: 14px;
  color: #d1fae5;
  line-height: 1.6;
}
  </style>
</head>
<body>

<%- include('./partials/header') %>
<%- include('./partials/ticker') %>
<section class="rt-dossier-hero">
  <div class="rt-hero-bg" style="background-image: url('<%= tour.heroImage %>');"></div>
  <div class="rt-hero-scanline"></div>
  <div class="rt-hero-fade"></div>

  <a href="/" class="rt-hud-back-btn">
    <span style="font-size: 16px; line-height: 1;">←</span> BACK TO TOURS
  </a>

  <div class="rt-hero-content">
    <div class="rt-hero-tag"><%= tour.name.toUpperCase() %></div>
    <h1>Hyderabad to <%= tour.name %></h1>
    <p><%= tour.intro %></p>
  </div>
</section>

<section class="rt-dossier-body">
  <div class="rt-bento-grid">

    <div class="rt-bento-card rt-span-full">
      <div class="rt-card-label">--> ROUTE TELEMETRY</div>
      <h2 class="rt-bento-title"><%= tour.introTitle %></h2>
      <p class="rt-bento-text"><%= tour.distanceInfo %></p>
      
      <div class="rt-route-path-box">
        <h3 class="rt-bento-subtitle"><%= tour.routesTitle %></h3>
        <% if (tour.routes && tour.routes.length > 0) { %>
          <ul class="rt-glowing-list">
            <% tour.routes.forEach(route => { %>
              <li><%= route %></li>
            <% }) %>
          </ul>
        <% } %>
        <p class="rt-muted-text"><%= tour.routeExtra %></p>
      </div>
    </div>

    <div class="rt-bento-card">
      <div class="rt-card-label">-->OPTIMAL FOR</div>
      <% if (tour.idealFor && tour.idealFor.length > 0) { %>
        <div class="rt-tags-container">
          <% tour.idealFor.forEach(item => { %>
            <span class="rt-cyber-pill"><%= item %></span>
          <% }) %>
        </div>
      <% } %>
      <p class="rt-muted-text" style="margin-top: 20px;"><%= tour.idealExtra %></p>
    </div>

    <div class="rt-bento-card">
      <div class="rt-card-label">/// VEHICLE FLEET</div>
      <p class="rt-bento-text" style="margin-bottom: 20px;">Well-maintained AC and Non-AC Vehicles scaled to your group:</p>
      <div class="rt-fleet-stack">
        <div class="rt-fleet-row"><strong>09 SEATER</strong> <span>Small Families</span></div>
        <div class="rt-fleet-row"><strong>12 SEATER</strong> <span>Mid-Sized Groups</span></div>
        <div class="rt-fleet-row"><strong>17 SEATER</strong> <span>Large Communities</span></div>
        <div class="rt-fleet-row"><strong>20+ BUS</strong> <span>Temple Mandalis</span></div>
      </div>
    </div>

    <div class="rt-bento-card rt-span-full">
      <div class="rt-card-label">/// PREMIUM AMENITIES & ADVANTAGES</div>
      
      <div class="rt-split-grid">
        <div>
          <h3 class="rt-bento-subtitle">Standard Features:</h3>
          <ul class="rt-check-grid">
            <li>Push-Back Reclining Seats</li>
            <li>Chilled AC (Dual Blower)</li>
            <li>USB / Bluetooth Audio</li>
            <li>Ample Luggage Space</li>
            <li>Mobile Charging Ports</li>
            <li>Icebox & First Aid Kit</li>
            <li>Curtains for Privacy</li>
            <li>Sanitized Interiors</li>
          </ul>
        </div>

        <div>
          <h3 class="rt-bento-subtitle">Why Choose Us:</h3>
          <% if (tour.whyChoose && tour.whyChoose.length > 0) { %>
            <ul class="rt-advantage-list">
              <% tour.whyChoose.forEach(item => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
      
      <div class="rt-cyber-divider"></div>
      <p class="rt-bento-text" style="text-align: center;"><%= tour.whyExtra %></p>
    </div>

  </div> <div class="rt-booking-wrapper">
    <a href="/contact" class="rt-initiate-btn">
      <span class="rt-btn-glow"></span>
      [ INITIATE SECURE BOOKING ]
    </a>
  </div>

</section>
<section class="tour-faq">
  <h2>Frequently Asked Questions</h2>

  <% const faqs = [
    {
      q: `What is the distance from Hyderabad to ${tour.name}?`,
      a: tour.distanceInfo
    },
    {
      q: `Do you provide same-day return trip to ${tour.name}?`,
      a: `Yes, we offer same-day and multi-day cab services to ${tour.name} based on your travel requirements.`
    },
    {
      q: `What vehicles are available for ${tour.name} trip?`,
      a: "Sedan, SUV, Tempo Traveller and Bus options are available depending on group size and comfort preference."
    },
    {
      q: `How much does Hyderabad to ${tour.name} cab cost?`,
      a: "Pricing depends on vehicle type and duration. Contact Radha Travels for a customized quote."
    }
  ]; %>

  <% faqs.forEach((item, index) => { %>
    <div class="faq-item">
      <button class="faq-question" aria-expanded="false">
        <span><%= item.q %></span>
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p><%= item.a %></p>
      </div>
    </div>
  <% }) %>
</section>

<%- include('./partials/footer') %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the distance from Hyderabad to ${tour.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": tour.distanceInfo
      }
    },
    {
      "@type": "Question",
      "name": `Do you provide same-day return trip to ${tour.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, we provide same-day and multi-day cab services to ${tour.name}.`
      }
    },
    {
      "@type": "Question",
      "name": `What vehicles are available for ${tour.name} trip?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sedan, SUV, Tempo Traveller and Bus options are available depending on group size."
      }
    },
    {
      "@type": "Question",
      "name": `How much does Hyderabad to ${tour.name} cab cost?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing depends on vehicle type and travel duration. Contact Radha Travels for customized pricing."
      }
    }
  ]
}, null, 2) %>
</script>
<script>
document.querySelectorAll(".faq-question").forEach(button => {
  button.addEventListener("click", () => {
    const item = button.parentElement;
    const answer = button.nextElementSibling;

    const isOpen = item.classList.contains("active");

    document.querySelectorAll(".faq-item").forEach(i => {
      i.classList.remove("active");
      i.querySelector(".faq-answer").style.maxHeight = null;
    });

    if (!isOpen) {
      item.classList.add("active");
      answer.style.maxHeight = answer.scrollHeight + "px";
    }
  });
});
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://radhatravels.co.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tours",
      "item": "https://radhatravels.co.in/#special-tours"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `Hyderabad to ${tour.name}`,
      "item": `https://radhatravels.co.in/tours/${tour.name.toLowerCase()}`
    }
  ]
}, null, 2) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": `Hyderabad to ${tour.name} Cab Service`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Radha Travels",
    "url": "https://radhatravels.co.in/",
    "telephone": "+918332958915",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "addressCountry": "IN"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": tour.name
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceLocation": {
      "@type": "Place",
      "name": "Hyderabad"
    }
  },
  "description": `Premium cab and travel service from Hyderabad to ${tour.name}. Comfortable vehicles, experienced drivers, and customizable temple tour packages available.`
}, null, 2) %>
</script>
</body>

</html>
