<script>
document.addEventListener('DOMContentLoaded', () => {
  
  // 1. Fetch and update the Live Visitors counter
  async function fetchLiveVisitors() {
    try {
      const response = await fetch('/api/live-visitors');
      const data = await response.json();
      
      const liveCounter = document.getElementById('liveVisitors');
      if (liveCounter) {
        liveCounter.textContent = data.total || 0;
      }
    } catch (error) {
      console.error('Error fetching live visitors:', error);
    }
  }

  // 2. Fetch and populate the Trending Regions (States)
  async function fetchStateVisitors() {
    try {
      const response = await fetch('/api/state-visitors');
      const states = await response.json();
      
      const stateList = document.getElementById('stateVisitors');
      if (stateList) {
        if (!states || states.length === 0) {
          stateList.innerHTML = '<li>Gathering data...</li>';
          return;
        }

        // Create the <li> tags dynamically based on the API response
        stateList.innerHTML = states.map(item => {
           return `<li>${item.state}</li>`; 
        }).join('');
      }
    } catch (error) {
      console.error('Error fetching state visitors:', error);
    }
  }

  // Initial fetch on page load
  fetchLiveVisitors();
  fetchStateVisitors();

  // Keep checking live visitors every 30 seconds without reloading the page
  setInterval(fetchLiveVisitors, 30000); 
});

// REVEAL ANIMATIONS
  document.addEventListener("DOMContentLoaded", function() {
    const observerOptions = {
      root: null,
      threshold: 0.25, // Triggers earlier to ensure animations are ready
      rootMargin: "0px 0px -50px 0px" 
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('.reveal-item');
          
          items.forEach((item, index) => {
            // Fast 0.1s stagger creates a fluid wave instead of choppy delays
            const delay = index * 0.2; 
            item.style.transitionDelay = `${delay}s`;
            
            // requestAnimationFrame forces the browser into a high-performance render cycle
            requestAnimationFrame(() => {
              item.classList.add('is-visible');
            });
          });

          // Unobserve so elements do not re-animate on scroll up, saving memory
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const revealGroups = document.querySelectorAll('.reveal-group');
    revealGroups.forEach(group => revealObserver.observe(group));
  });

document.addEventListener("DOMContentLoaded", function() {

  const counters = document.querySelectorAll(".counter");

  function animateCounter(counter) {
    const target = parseFloat(counter.getAttribute("data-target"));
    const isDecimal = target % 1 !== 0;

    let current = 0;
    const duration = 1200;
    const increment = target / (duration / 16);

    function update() {
      current += increment;

      if (current < target) {
        counter.innerText = isDecimal
          ? current.toFixed(1)
          : Math.floor(current);
        requestAnimationFrame(update);
      } else {
        counter.innerText = isDecimal
          ? target.toFixed(1)
          : target;
          counter.classList.add("counter-finish");
      }
    }

    update();
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        counters.forEach(counter => {
          if (!counter.classList.contains("counted")) {
            counter.classList.add("counted");
            animateCounter(counter);
          }
        });
      }
    });
  }, { threshold: 0.4 });

  const section = document.querySelector(".home-review-preview");
  if(section) observer.observe(section);

});
</script>
<!-- mobile floating button logic -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  // 1. Target your Hero section (Update '.hero-section' to match your actual hero)
  const heroSection = document.querySelector('.hero-bleed'); 
  
  // 2. Target the header button
  const floatingBtn = document.querySelector('.btn-header');

  if (!heroSection || !floatingBtn) return;

  // 3. The Precision Observer Configuration
  const observerOptions = {
    root: null,
    rootMargin: "0px",
    // Creates trigger points at exactly 0% and 25% visibility
    threshold: [0, 0.75] 
  };

  const heroObserver = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      const isMobile = window.innerWidth <= 900;

      if (isMobile) {
        // entry.intersectionRatio tells us exactly how much of the Hero is visible.
        // If more than 25% of the Hero is on screen -> Hide the button
        if (entry.intersectionRatio > 0.75) {
          floatingBtn.classList.add('mobile-hidden');
        } 
        // If 25% or less of the Hero is on screen -> Slide the button up
        else {
          floatingBtn.classList.remove('mobile-hidden');
        }
      }
    });
  }, observerOptions);

  // 4. Start watching the Hero section
  heroObserver.observe(heroSection);
  
  // 5. Ensure the button is hidden on initial load if starting at the very top
  if (window.innerWidth <= 900 && window.scrollY < 100) {
      floatingBtn.classList.add('mobile-hidden');
  }
});
</script>
