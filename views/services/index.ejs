<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <%- include('../partials/schema-service', { 
    serviceName: 'Car Rental & Outstation Cab Services Hyderabad', 
    basePrice: '13.00',
    metaDescription: 'Explore Radha Travels cab services in Hyderabad: outstation packages, local city rentals, airport transfers, and luxury fleet options like Innova Crysta and Force Urbania.'
  }) %>
  <%- include('../partials/head', { title }) %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css" />
  
  <style>
    /* ==========================================================================
       NATIVE SMOOTH SCROLLING (Ensures butter-smooth anchor navigation)
       ========================================================================== */
    html {
      scroll-behavior: smooth;
    }

    /* ==========================================================================
       GLOBAL ANIMATIONS & REVEAL SYSTEM
       ========================================================================== */
    @keyframes fadeUpEntrance {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes shineSweep {
      0% { left: -100%; }
      100% { left: 200%; }
    }

    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       1. RICH & BOLD HERO SECTION
       ========================================================================== */
    .svc-rich-hero {
      position: relative;
      text-align: center;
      min-height: 90vh; /* Increased height to accommodate the scroll indicator */
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.6) 100%), url('/images/hero/services-bg.webp') center/cover no-repeat fixed;
      color: #ffffff;
      animation: fadeUpEntrance 1s ease-out forwards;
      border-bottom: 4px solid #10b981;
      margin-top: -48px;
    }

    .hero-badge-rich {
      display: inline-block;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #34d399;
      padding: 8px 24px;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(4px);
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .hero-title-rich {
      font-size: clamp(2.5rem, 7vw, 4.8rem);
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -0.03em;
      margin: 0 0 1.25rem 0;
      line-height: 1.1;
      text-shadow: 0 10px 20px rgba(0,0,0,0.5);
    }
    .hero-title-rich span { color: #10b981; }

    .hero-subtitle-rich {
      color: #cbd5e1;
      font-size: clamp(1.05rem, 2.5vw, 1.25rem);
      line-height: 1.7;
      max-width: 700px;
      margin: 0 auto 2rem auto;
      font-weight: 400;
    }

    /* ==========================================================================
       THE ELEGANT GLASSMORPHIC SCROLL ARROW
       ========================================================================== */
    .hero-scroll-btn {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      z-index: 10;
    }

    .hero-scroll-btn .scroll-txt {
      font-family: 'Poppins', sans-serif;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.3em;
      color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase;
      transition: color 0.4s ease;
    }

    .hero-scroll-btn:hover .scroll-txt {
      color: #ffffff;
    }

    .scroll-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-scroll-btn:hover .scroll-circle {
      background: rgba(16, 185, 129, 0.15); /* Subtle Emerald tint on hover */
      border-color: rgba(16, 185, 129, 0.4);
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2), 0 0 15px rgba(16, 185, 129, 0.3);
    }

    /* Cinematic Dropping Arrow Animation */
    .scroll-circle i {
      color: #ffffff;
      font-size: 1.1rem;
      animation: elegantArrowDrop 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes elegantArrowDrop {
      0% { transform: translateY(-25px); opacity: 0; }
      25% { transform: translateY(-5px); opacity: 1; }
      75% { transform: translateY(5px); opacity: 1; }
      100% { transform: translateY(25px); opacity: 0; }
    }

    /* ==========================================================================
       2. ENHANCED SECTION TITLES
       ========================================================================== */
    .section-header-rich {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 2rem;
    }
    .section-eyebrow-rich {
      display: inline-block;
      background: #0f172a;
      color: #34d399;
      padding: 6px 18px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .section-title-rich {
      font-size: clamp(1.8rem, 5vw, 3.5rem); 
      color: #0f172a; 
      margin: 0;
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }
    .section-divider-rich {
      width: 150px;
      height: 5px;
      background: #10b981;
      margin-top: 1.25rem;
      border-radius: 5px;
    }

    /* ==========================================================================
       3. SIGNATURE DESTINATIONS (Cinematic Grid)
       ========================================================================== */
    .rt-cinematic-tours {
      padding: 2rem 1rem;
      background-color: #f8fafc;
    }
    .ct-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(0.75rem, 2vw, 1.5rem); 
      max-width: 1250px;
      margin: 0 auto;
    }
    @media (min-width: 1024px) { .ct-grid { grid-template-columns: repeat(4, 1fr); } }

    .ct-card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      border-radius: clamp(12px, 2vw, 24px); 
      overflow: hidden;
      text-decoration: none;
      aspect-ratio: 3/4; 
      background: #0f172a; 
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15), inset 0 0 0 1px rgba(255,255,255,0.08);
      transform: translateZ(0); 
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .ct-card::after {
      content: '';
      position: absolute;
      top: 0; left: -100%; 
      width: 50%; height: 100%;
      background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.05) 50%, rgba(255,255,255,0) 100%);
      transform: skewX(-25deg);
      z-index: 3;
      pointer-events: none;
    }
    .ct-card:hover {
      transform: translateY(-8px) scale(1.01); 
      box-shadow: 0 25px 50px -15px rgba(16, 185, 129, 0.3), inset 0 0 0 1px rgba(16, 185, 129, 0.5);
    }
    .ct-card:hover::after { animation: shineSweep 1.5s cubic-bezier(0.16, 1, 0.3, 1); }

    .ct-image-layer, .ct-image-layer img {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s ease;
    }
    .ct-card:hover .ct-image-layer img { transform: scale(1.1) translate3d(0, 2%, 0); filter: brightness(1.1); }

    .ct-gradient-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(15,23,42,0.3) 0%, rgba(15,23,42,0) 25%, rgba(15,23,42,0.6) 65%, rgba(15,23,42,0.95) 100%);
      transition: opacity 0.6s ease;
    }
    .ct-card:hover .ct-gradient-overlay { opacity: 0.85; }

    .ct-content-layer {
      position: absolute;
      inset: 0;
      padding: clamp(0.85rem, 2.5vw, 1.75rem); 
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 4;
    }
    .ct-badge {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px) saturate(180%);
      -webkit-backdrop-filter: blur(12px) saturate(180%);
      color: #ffffff;
      padding: clamp(4px, 1vw, 6px) clamp(8px, 2vw, 14px);
      border-radius: 50px; 
      font-size: clamp(0.55rem, 1.5vw, 0.65rem);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .ct-text-bottom h3 {
      color: #ffffff;
      font-size: clamp(1.05rem, 3.5vw, 1.75rem); 
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 0 0 0.5rem 0;
      line-height: 1.1;
      word-wrap: break-word; 
      transition: color 0.4s ease;
    }

    .ct-desc { display: none; }

    .ct-action-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(255,255,255,0.15);
      padding-top: clamp(0.5rem, 1.5vw, 1rem);
      margin-top: 0.25rem;
    }
    .ct-explore-text {
      color: #cbd5e1;
      font-size: clamp(0.55rem, 1.8vw, 0.75rem);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .ct-arrow-circle {
      width: clamp(26px, 5vw, 36px); 
      height: clamp(26px, 5vw, 36px);
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex; align-items: center; justify-content: center;
      color: #ffffff; 
      font-size: clamp(0.6rem, 1.5vw, 0.85rem);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ct-card:hover .ct-arrow-circle {
      background: #10b981; 
      color: #ffffff;
      transform: translateX(4px); 
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.5);
    }

    @media (min-width: 1024px) {
      .ct-desc {
        display: block; color: #cbd5e1; font-size: 0.85rem; line-height: 1.6;
        max-height: 0; opacity: 0; margin: 0; overflow: hidden;
        transition: max-height 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
      }
      .ct-card:hover .ct-desc { max-height: 120px; opacity: 1; margin-bottom: 1rem; margin-top: 0.5rem; }
    }
    
    /* ==========================================================================
       4. EVERYDAY SERVICES
       ========================================================================== */
    .services-regular-section {
      padding: 2rem 1rem;
      background-color: #ffffff;
    }
    .svc-grid-premium { margin: 0 auto; }
    @media (max-width: 768px) { .svc-grid-premium { margin: 0; } }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/ticker') %>

  <main>
    
    <header class="svc-rich-hero">
      <div class="hero-badge-rich">
        <i class="fa-solid fa-star"></i> Radha Travels Exclusive
      </div>
      <h1 class="hero-title-rich">Elevate Your <span>Journey</span></h1>
      <p class="hero-subtitle-rich">Experience unparalleled comfort and reliability. Hand-picked destinations and everyday travel solutions tailored perfectly for you.</p>
      
      <a href="#signature-tours" class="hero-scroll-btn" style="transition-delay: 0.8s;">
        <span class="scroll-txt">Scroll to Explore</span>
        <div class="scroll-circle">
          <i class="fa-solid fa-arrow-down-long"></i>
        </div>
      </a>
    </header>

    <% if (typeof tours !== 'undefined') { %>
      <section id="signature-tours" class="rt-cinematic-tours">
        <div class="section-header-rich reveal-on-scroll">
          <span class="section-eyebrow-rich">Curated Experiences</span>
          <h2 class="section-title-rich">Signature Destinations</h2>
          <div class="section-divider-rich"></div>
        </div>

        <div class="ct-grid">
          <% 
            const allKeys = Object.keys(tours);
            allKeys.forEach(function(key, index) { 
              const tour = tours[key];
              let badgeText = "Pilgrimage";
              if(key === 'hyderabadLocal') badgeText = "City Tour";
              if(key === 'ramoji') badgeText = "Entertainment";
          %>
            <a href="/tours/<%= key %>" class="ct-card reveal-on-scroll" style="transition-delay: <%= (index % 4) * 0.1 %>s">
              <div class="ct-image-layer">
                <img src="<%= tour.heroImage %>" alt="<%= tour.name %>" loading="lazy">
                <div class="ct-gradient-overlay"></div>
              </div>
              <div class="ct-content-layer">
                <span class="ct-badge"><%= badgeText %></span>
                <div class="ct-text-bottom">
                  <h3><%= key === 'hyderabadLocal' ? 'Hyderabad City' : tour.name %></h3>
                  <p class="ct-desc"><%= tour.intro.substring(0, 75) %>...</p>
                  <div class="ct-action-row">
                    <span class="ct-explore-text">Explore Tour</span>
                    <div class="ct-arrow-circle">
                      <i class="fa-solid fa-arrow-right"></i>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

<!-- ==========================================================================
     EXECUTIVE VIP FLEET SPOTLIGHT BANNER (FORCE URBANIA & INNOVA CRYSTA)
     ========================================================================== -->
<section class="rt-vip-spotlight reveal-on-scroll">
  <div class="vip-container">
    
    <!-- Background Gradient Overlay & Ambient Light -->
    <div class="vip-ambient-glow"></div>
    <div class="vip-grid-pattern"></div>

    <!-- Left Content Column -->
    <div class="vip-content">
      <div class="vip-header-badge">
        <span class="crown-icon"><i class="fa-solid fa-crown"></i></span>
        <span>Premium VIP & Group Fleet</span>
      </div>

      <h2 class="vip-title">
        Upgrade to <span class="text-highlight">First-Class</span> Group Travel
      </h2>

      <p class="vip-subtitle">
        Say goodbye to noisy, cramped vans. Transport your guests in total luxury with our executive <strong>Force Urbania</strong> & <strong>Innova Crysta</strong> fleet.
      </p>

      <!-- Key Vehicle Highlights Grid -->
      <div class="vip-features-grid">
        <div class="vip-feature-item">
          <div class="feature-icon"><i class="fa-solid fa-couch"></i></div>
          <div class="feature-text">
            <strong>Captain Seats</strong>
            <span>Leather Recliners</span>
          </div>
        </div>

        <div class="vip-feature-item">
          <div class="feature-icon"><i class="fa-solid fa-volume-xmark"></i></div>
          <div class="feature-text">
            <strong>Quiet Cabin</strong>
            <span>Airplane NVH Sound</span>
          </div>
        </div>

        <div class="vip-feature-item">
          <div class="feature-icon"><i class="fa-solid fa-suitcase-rolling"></i></div>
          <div class="feature-text">
            <strong>Huge Boot</strong>
            <span>12–15 Full Suitcases</span>
          </div>
        </div>

        <div class="vip-feature-item">
          <div class="feature-icon"><i class="fa-solid fa-user-shield"></i></div>
          <div class="feature-text">
            <strong>Pro Chauffeur</strong>
            <span>7+ Yrs Hill Certified</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons (2-Column Grid on Mobile) -->
      <div class="vip-actions">
        <a href="/fleet" class="vip-btn-primary">
          <i class="fa-solid fa-car-rear"></i> Luxury Fleet
        </a>
        <a href="/blog/force-urbania-luxury-van-rental-hyderabad-guide" class="vip-btn-secondary">
          <i class="fa-solid fa-book-open"></i> Urbania Guide
        </a>
      </div>
    </div>

    <!-- Right Feature Visual Card -->
    <div class="vip-visual-card">
      <div class="card-image-wrap">
        <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80" alt="Force Urbania Luxury Van" loading="lazy">
        <div class="visual-glass-overlay">
          <div class="seating-tag">
            <i class="fa-solid fa-users"></i> 10, 13 & 17 Seaters
          </div>
          <div class="rating-tag">
            <i class="fa-solid fa-star" style="color: #fbbf24;"></i> 4.9/5 Rating
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ==========================================================================
     EXECUTIVE VIP SPOTLIGHT STYLES
     ========================================================================== */
  .rt-vip-spotlight {
    max-width: 1250px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .vip-container {
    position: relative;
    background: #0f172a;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.4);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .vip-container {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }
  }

  /* Ambient Glow & Background Layering */
  .vip-ambient-glow {
    position: absolute;
    top: -100px;
    left: -100px;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, rgba(15, 23, 42, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .vip-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 1;
  }

  /* Left Content Column */
  .vip-content {
    position: relative;
    z-index: 2;
  }

  .vip-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34d399;
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
    backdrop-filter: blur(8px);
  }

  .vip-header-badge .crown-icon {
    color: #fbbf24;
    font-size: 0.9rem;
  }

  .vip-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem 0;
  }

  .vip-title .text-highlight {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vip-subtitle {
    color: #94a3b8;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .vip-subtitle strong {
    color: #f8fafc;
  }

  /* Desktop Features Grid */
  .vip-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .vip-feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 16px;
    border-radius: 14px;
    backdrop-filter: blur(4px);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .vip-feature-item:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  .feature-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .feature-text strong {
    color: #f1f5f9;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feature-text span {
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Desktop Actions */
  .vip-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .vip-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff !important;
    padding: 14px 28px;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none !important;
    box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
    transition: all 0.3s ease;
  }

  .vip-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 25px -5px rgba(16, 185, 129, 0.6);
  }

  .vip-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    color: #cbd5e1 !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 14px 24px;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none !important;
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .vip-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-3px);
  }

  /* Right Visual Card */
  .vip-visual-card {
    position: relative;
    z-index: 2;
  }

  .card-image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.15);
    aspect-ratio: 4/3;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-image-wrap:hover img {
    transform: scale(1.06);
  }

  .visual-glass-overlay {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .seating-tag, .rating-tag {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 100px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .seating-tag i {
    color: #34d399;
  }

  /* ==========================================================================
     STRICT MOBILE OPTIMIZATIONS (2-COLUMN GRID & COMPACT FONTS)
     ========================================================================== */
  @media (max-width: 768px) {
    .rt-vip-spotlight {
      margin: 1.5rem auto;
      padding: 0 0.5rem;
    }

    .vip-container {
      padding: 1.25rem 1rem;
      border-radius: 18px;
      gap: 1.5rem;
    }

    .vip-header-badge {
      font-size: 0.65rem;
      padding: 4px 12px;
      margin-bottom: 0.75rem;
      letter-spacing: 0.08em;
    }

    .vip-title {
      font-size: 1.45rem;
      margin-bottom: 0.5rem;
    }

    .vip-subtitle {
      font-size: 0.82rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }

    /* 🔥 2-COLUMN FEATURES GRID ON MOBILE */
    .vip-features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-bottom: 1.25rem;
    }

    .vip-feature-item {
      padding: 8px 10px;
      border-radius: 10px;
      gap: 8px;
    }

    .feature-icon {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      font-size: 0.82rem;
    }

    .feature-text strong {
      font-size: 0.73rem;
    }

    .feature-text span {
      font-size: 0.62rem;
    }

    /* 🔥 2-COLUMN BUTTONS ON MOBILE */
    .vip-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .vip-btn-primary, .vip-btn-secondary {
      width: 100%;
      padding: 11px 8px;
      font-size: 0.72rem;
      border-radius: 10px;
      justify-content: center;
      gap: 6px;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .vip-btn-primary i, .vip-btn-secondary i {
      font-size: 0.75rem;
    }

    /* Compact Visual Card Overlay */
    .visual-glass-overlay {
      bottom: 10px;
      left: 10px;
      right: 10px;
      gap: 6px;
    }

    .seating-tag, .rating-tag {
      font-size: 0.65rem;
      padding: 6px 10px;
    }
  }
</style>

    <section class="services-regular-section">
      <div class="section-header-rich reveal-on-scroll">
        <span class="section-eyebrow-rich">Reliable Fleet</span>
        <h2 class="section-title-rich">Everyday Travel Solutions</h2>
        <div class="section-divider-rich"></div>
      </div>
      
      <div class="svc-grid-premium" role="list">
        <% services.forEach(function(s, idx){ 
            let img = "/images/services/default.jpg";
            if (s.image && typeof s.image === "string") img = "/images/services/" + s.image;
            else if (s.image && s.image.src) img = s.image.src;
        %>
        <article class="svc-card-premium reveal-on-scroll" data-idx="<%= idx %>" tabindex="0" style="transition-delay: <%= (idx % 3) * 0.1 %>s">
          <div class="svc-img-wrap">
            <img src="<%= img %>" alt="<%= s.title %> image" class="svc-img" loading="lazy">
            <% if (s.from) { %>
              <span class="svc-badge">From ₹<%= s.from %></span>
            <% } %>
          </div>

          <div class="svc-body">
            <div class="svc-head-inline">
              <div class="svc-icon">
                <% if (s.icon && s.icon.startsWith('ri-')) { %>
                  <i class="<%= s.icon %>"></i>
                <% } else { %>
                  <i class="fa-solid fa-car"></i>
                <% } %>
              </div>
              <h3 class="svc-title"><%= s.title %></h3>
            </div>
            <p class="svc-desc"><%= s.blurb %></p>

            <div class="svc-btn-group">
              <a href="/services/<%= s.slug %>" class="svc-btn svc-btn-main">
                View Details <i class="fa-solid fa-arrow-right-long"></i>
              </a>
              <a href="#" role="button" class="svc-btn svc-btn-alt open-booking">
                Book Now
              </a>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>
  
  <script>
    const reveal = () => {
      const reveals = document.querySelectorAll('.reveal-on-scroll');
      const windowHeight = window.innerHeight;
      const revealPoint = 100;

      reveals.forEach(el => {
        const revealTop = el.getBoundingClientRect().top;
        if (revealTop < windowHeight - revealPoint) {
          el.classList.add('active');
        }
      });
    };

    window.addEventListener('scroll', reveal);
    window.addEventListener('load', reveal);
  </script>
  
  <script src="/js/main.js"></script>
</body>
</html>