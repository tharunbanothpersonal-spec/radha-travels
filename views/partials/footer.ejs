<style>
  :root {
    --emerald-900: #064e3b;
    --emerald-800: #065f46;
    --emerald-600: #059669;
    --emerald-500: #10b981;
    --emerald-400: #34d399;
    --text-muted: #a7f3d0;
  }

  .rt-robust-footer {
    /* Rich gradient for a substantial, non-"lite" feel */
    background: linear-gradient(180deg, var(--emerald-900) 0%, #022c22 100%);
    color: #ffffff;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding: 50px 15px 20px 15px;
    margin-top: 0; /* Removes any white patches above it */
    border-top: 4px solid var(--emerald-500);
    box-shadow: inset 0 10px 30px rgba(0, 0, 0, 0.2); /* Adds inner depth */
  }

  .rt-footer-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- MAIN MOBILE GRID --- */
  .rt-footer-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 35px; /* Tight gap for compactness */
    margin-bottom: 30px;
  }

  /* --- BRAND SECTION --- */
  .rt-brand-block h3 {
    font-size: 24px;
    font-weight: 800;
    margin: 0 0 12px 0;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  .rt-brand-block p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 18px 0;
    max-width: 320px;
  }

  .rt-social-icons {
    display: flex;
    gap: 12px;
  }

  .rt-social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .rt-social-icons a:hover {
    background: var(--emerald-500);
    border-color: var(--emerald-500);
    transform: translateY(-3px);
  }

  /* --- THE MOBILE 2-COLUMN LINKS GRID --- */
  .rt-links-mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Side-by-side columns on mobile! */
    gap: 15px;
  }

  .rt-link-col h4 {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
    color: var(--emerald-400);
  }

  .rt-link-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rt-link-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .rt-link-col a:hover {
    color: #ffffff;
  }

  /* --- CONTACT SECTION --- */
  .rt-contact-block {
    background: rgba(
      0,
      0,
      0,
      0.15
    ); /* Gives contact block its own dark card feel */
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .rt-contact-block h4 {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
    color: var(--emerald-400);
  }

  .rt-contact-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 15px;
    line-height: 1.4;
  }

  .rt-contact-row:last-child {
    margin-bottom: 0;
  }

  .rt-contact-row svg {
    width: 18px;
    height: 18px;
    color: var(--emerald-500);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* --- BOTTOM BAR --- */
  .rt-footer-bottom-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .rt-footer-bottom-bar p {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
  }

  .rt-admin-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    text-decoration: none;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .rt-admin-pill:hover {
    color: #ffffff;
    background: var(--emerald-600);
  }

  .visitor-popularity {
    margin-top: 20px;
  }

  .visitor-popularity h4 {
    font-size: 14px;
    margin-bottom: 10px;
    opacity: 0.9;
  }

  #stateChart {
    max-height: 160px;
  }

  /* --- DESKTOP SCALING --- */
  @media (min-width: 768px) {
    .rt-robust-footer {
      padding: 70px 30px 25px 30px;
    }
    .rt-footer-main-grid {
      /* 1.5x width for brand, 2x for links grid, 1.5x for contact */
      grid-template-columns: 1.5fr 2fr 1.5fr;
      gap: 50px;
      margin-bottom: 50px;
    }
    .rt-contact-block {
      background: transparent;
      padding: 0;
      border: none;
    }
    .rt-footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>

